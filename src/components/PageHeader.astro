---
// Cabecera editorial de páginas generales; las páginas del curso usan CoursePageHeader.
interface Props {
  eyebrow?: string;
  title: string;
  description: string;
}

const {
  eyebrow = "Aula Física",
  title,
  description,
} = Astro.props;
---

<header class="page-header">
  <p class="eyebrow eyebrow--dark">{eyebrow}</p>
  <h1>{title}</h1>
  <p>{description}</p>
</header>
