---
// Navegación compartida por todas las páginas internas del curso.
import { COURSE } from "../../data/course.js";
import { t } from "../../i18n/index.js";
import { ROUTE_IDS, getLocalizedPath } from "../../i18n/routes.js";
import { withBase } from "../../utils/paths.js";

const { locale = "es" } = Astro.props;
const { pathname } = Astro.url;
const navigationItems = [
  [ROUTE_IDS.COURSE, "course"],
  [ROUTE_IDS.COURSE_NOTICES, "notices"],
  [ROUTE_IDS.COURSE_SCHEDULE, "schedule"],
  [ROUTE_IDS.COURSE_UNITS, "units"],
  [ROUTE_IDS.COURSE_PRACTICE, "practice"],
  [ROUTE_IDS.COURSE_BONUSES, "bonuses"],
  [ROUTE_IDS.COURSE_VIDEOS, "videos"],
  [ROUTE_IDS.COURSE_ASSESSMENT, "assessment"],
  [ROUTE_IDS.COURSE_RESOURCES, "resources"],
  [ROUTE_IDS.COURSE_PARTICIPATE, "participate"],
];

// Astro puede entregar la URL con slash final; normalizar evita falsos inactivos.
const normalizePath = (path: string) => {
  if (path.length > 1 && path.endsWith("/")) {
    return path.slice(0, -1);
  }

  return path;
};

const currentPath = normalizePath(pathname);
---

<nav
  class="course-nav"
  aria-label={t(locale, "course.navLabel", { course: locale === "es" ? COURSE.name : "Basic Physics I" })}
>
  <!-- El track conserva el ancho de sus enlaces y el contenedor permite desplazamiento horizontal. -->
  <div class="course-nav__track">
    {
      navigationItems.map(([routeId, label], index) => {
        const href = withBase(getLocalizedPath(routeId, locale));
        const isCurrent =
          currentPath === normalizePath(href);

        return (
          <a
            class="course-nav__link"
            href={href}
            aria-current={isCurrent ? "page" : undefined}
          >
            <span class="course-nav__number">
              {String(index + 1).padStart(2, "0")}
            </span>

            <span>{t(locale, `course.nav.${label}`)}</span>
          </a>
        );
      })
    }
  </div>
</nav>

<script>
  // En pantallas estrechas, revela la sección activa sin desplazar la página.
  const revealCurrentCourseLink = () => {
    document.querySelectorAll(".course-nav").forEach((nav) => {
      if (!(nav instanceof HTMLElement)) return;

      const current = nav.querySelector<HTMLElement>(
        '[aria-current="page"]'
      );
      if (!current) return;

      nav.scrollLeft = Math.max(
        0,
        current.offsetLeft -
          (nav.clientWidth - current.offsetWidth) / 2
      );
    });
  };

  requestAnimationFrame(revealCurrentCourseLink);
</script>
