---
// Navegación compartida por todas las páginas internas del curso.
import { COURSE, COURSE_NAV } from "../../data/course.js";
import { withBase } from "../../utils/paths.js";

const { pathname } = Astro.url;

// Astro puede entregar la URL con slash final; normalizar evita falsos inactivos.
const normalizePath = (path: string) => {
  if (path.length > 1 && path.endsWith("/")) {
    return path.slice(0, -1);
  }

  return path;
};

const currentPath = normalizePath(pathname);
---

<nav
  class="course-nav"
  aria-label={`Secciones de ${COURSE.name}`}
>
  <!-- El track conserva el ancho de sus enlaces y el contenedor permite desplazamiento horizontal. -->
  <div class="course-nav__track">
    {
      COURSE_NAV.map((item, index) => {
        const href = withBase(item.href);
        const isCurrent =
          currentPath === normalizePath(href);

        return (
          <a
            class="course-nav__link"
            href={href}
            aria-current={isCurrent ? "page" : undefined}
          >
            <span class="course-nav__number">
              {String(index + 1).padStart(2, "0")}
            </span>

            <span>{item.label}</span>
          </a>
        );
      })
    }
  </div>
</nav>

<script>
  // En pantallas estrechas, revela la sección activa sin desplazar la página.
  const revealCurrentCourseLink = () => {
    document.querySelectorAll(".course-nav").forEach((nav) => {
      if (!(nav instanceof HTMLElement)) return;

      const current = nav.querySelector<HTMLElement>(
        '[aria-current="page"]'
      );
      if (!current) return;

      nav.scrollLeft = Math.max(
        0,
        current.offsetLeft -
          (nav.clientWidth - current.offsetWidth) / 2
      );
    });
  };

  requestAnimationFrame(revealCurrentCourseLink);
</script>
