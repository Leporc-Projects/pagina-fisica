---
import CourseNav from "./CourseNav.astro";

interface Props {
  section?: string;
  title: string;
  description: string;
}

const {
  section = "Física Básica I · 2026-2",
  title,
  description,
} = Astro.props;
---

<header class="course-subpage-hero">
  <p class="eyebrow eyebrow--dark">
    {section}
  </p>

  <h1>{title}</h1>

  <p>{description}</p>
</header>

<CourseNav />