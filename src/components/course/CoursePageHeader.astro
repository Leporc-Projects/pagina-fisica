---
// Compone la identidad del semestre y CourseNav para mantener iguales las subpáginas.
import CourseNav from "./CourseNav.astro";
import { COURSE } from "../../data/course.js";

interface Props {
  section?: string;
  title: string;
  description: string;
  locale?: "es" | "en";
}

const {
  section,
  title,
  description,
  locale = "es",
} = Astro.props;
const courseName = locale === "es" ? COURSE.name : "Basic Physics I";
const headingSection = section ?? `${courseName} · ${COURSE.semester}`;
---

<header class="course-subpage-hero">
  <p class="eyebrow eyebrow--dark">
    {headingSection}
  </p>

  <h1>{title}</h1>

  <p>{description}</p>
</header>

<CourseNav locale={locale} />
