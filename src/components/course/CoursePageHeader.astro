---
import CourseNav from "./CourseNav.astro";
import { COURSE } from "../../data/course.js";

interface Props {
  section?: string;
  title: string;
  description: string;
}

const {
  section = `${COURSE.name} · ${COURSE.semester}`,
  title,
  description,
} = Astro.props;
---

<header class="course-subpage-hero">
  <p class="eyebrow eyebrow--dark">
    {section}
  </p>

  <h1>{title}</h1>

  <p>{description}</p>
</header>

<CourseNav />
