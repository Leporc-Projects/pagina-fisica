---
import { t } from "../../i18n/index.js";
const { modelId, locale } = Astro.props;
---

{modelId === "kinematics-1d" && (
  <div class="kinematics-equations" aria-label={t(locale, "simulation.equations")}>
    <p><span>x(t)</span> = x₀ + v₀t + ½at²</p><p><span>v(t)</span> = v₀ + at</p><p><span>a(t)</span> = a</p>
  </div>
)}
{modelId === "projectile-2d" && (
  <div class="projectile-equations" aria-label={t(locale, "simulation.equations")}>
    <math display="block"><mrow><mi>x</mi><mo>(</mo><mi>t</mi><mo>)</mo><mo>=</mo><msub><mi>v</mi><mrow><mi>x</mi><mn>0</mn></mrow></msub><mi>t</mi></mrow></math>
    <math display="block"><mrow><mi>y</mi><mo>(</mo><mi>t</mi><mo>)</mo><mo>=</mo><msub><mi>y</mi><mn>0</mn></msub><mo>+</mo><msub><mi>v</mi><mrow><mi>y</mi><mn>0</mn></mrow></msub><mi>t</mi><mo>−</mo><mfrac><mn>1</mn><mn>2</mn></mfrac><mi>g</mi><msup><mi>t</mi><mn>2</mn></msup></mrow></math>
    <math display="block"><mrow><msub><mi>v</mi><mi>x</mi></msub><mo>(</mo><mi>t</mi><mo>)</mo><mo>=</mo><msub><mi>v</mi><mrow><mi>x</mi><mn>0</mn></mrow></msub></mrow></math>
    <math display="block"><mrow><msub><mi>v</mi><mi>y</mi></msub><mo>(</mo><mi>t</mi><mo>)</mo><mo>=</mo><msub><mi>v</mi><mrow><mi>y</mi><mn>0</mn></mrow></msub><mo>−</mo><mi>g</mi><mi>t</mi></mrow></math>
    <p><span>vx₀</span> = v₀ cos θ · <span>vy₀</span> = v₀ sin θ</p>
  </div>
)}
{modelId === "forces-friction" && (
  <div class="simulation-model-equations" aria-label={t(locale, "simulation.equations")}>
    <math display="block"><mrow><mi>N</mi><mo>=</mo><mi>m</mi><mi>g</mi><mi>cos</mi><mi>β</mi><mo>−</mo><mi>F</mi><mi>sin</mi><mi>α</mi></mrow></math>
    <math display="block"><mrow><msub><mi>F</mi><mi>drive</mi></msub><mo>=</mo><mi>F</mi><mi>cos</mi><mi>α</mi><mo>−</mo><mi>m</mi><mi>g</mi><mi>sin</mi><mi>β</mi></mrow></math>
    <math display="block"><mrow><mo>|</mo><msub><mi>f</mi><mi>s</mi></msub><mo>|</mo><mo>≤</mo><msub><mi>μ</mi><mi>s</mi></msub><mi>N</mi><mspace width="1em"/><mo>·</mo><mspace width="1em"/><mo>|</mo><msub><mi>f</mi><mi>k</mi></msub><mo>|</mo><mo>=</mo><msub><mi>μ</mi><mi>k</mi></msub><mi>N</mi></mrow></math>
    <math display="block"><mrow><mo>∑</mo><msub><mi>F</mi><mo>∥</mo></msub><mo>=</mo><mi>m</mi><msub><mi>a</mi><mo>∥</mo></msub></mrow></math>
    <p>{t(locale, "forcesFriction.normalAssumption")}</p>
  </div>
)}
{modelId === "circular-radial-force" && (
  <div class="simulation-model-equations" aria-label={t(locale, "simulation.equations")}>
    <math display="block"><mrow><msub><mi>a</mi><mi>r</mi></msub><mo>=</mo><mfrac><msup><mi>v</mi><mn>2</mn></msup><mi>R</mi></mfrac><mspace width="1em"/><mo>·</mo><mspace width="1em"/><mi>ω</mi><mo>=</mo><mfrac><mi>v</mi><mi>R</mi></mfrac></mrow></math>
    <math display="block"><mrow><mo>∑</mo><msub><mi>F</mi><mi>r</mi></msub><mo>=</mo><mfrac><mrow><mi>m</mi><msup><mi>v</mi><mn>2</mn></msup></mrow><mi>R</mi></mfrac><mspace width="1em"/><mo>·</mo><mspace width="1em"/><mi>T</mi><mo>=</mo><mfrac><mrow><mi>m</mi><msup><mi>v</mi><mn>2</mn></msup></mrow><mi>R</mi></mfrac></mrow></math>
    <math display="block"><mrow><mover><mi>r</mi><mo>→</mo></mover><mo>(</mo><mi>t</mi><mo>)</mo><mo>=</mo><msub><mover><mi>r</mi><mo>→</mo></mover><mi>break</mi></msub><mo>+</mo><msub><mover><mi>v</mi><mo>→</mo></mover><mi>break</mi></msub><mo>(</mo><mi>t</mi><mo>−</mo><msub><mi>t</mi><mi>break</mi></msub><mo>)</mo></mrow></math>
    <p>{t(locale, "circularDynamics.tensionAssumption")}</p>
  </div>
)}
