---
import KinematicsChart from "./KinematicsChart.astro";
import KinematicsMotion from "./KinematicsMotion.astro";
import {
  KINEMATICS_1D_CONTROLS,
  KINEMATICS_1D_PRESETS,
} from "../../data/simulations.js";
import {
  getKinematicsState,
  getTurningPoint,
} from "../../utils/kinematics-1d.js";
import { formatKinematicsNumber } from "../../utils/kinematics-svg.js";
import "../../styles/kinematics-simulation.css";

const initialPreset = KINEMATICS_1D_PRESETS.find(
  (preset) => preset.id === "return"
) ?? KINEMATICS_1D_PRESETS[0];
const initialParameters = initialPreset.parameters;
const initialState = getKinematicsState(initialParameters, 0);
const initialTurningPoint = getTurningPoint(initialParameters);

const readings = [
  { key: "time", label: "Instante", symbol: "t", unit: "s" },
  { key: "position", label: "Posición", symbol: "x", unit: "m" },
  { key: "displacement", label: "Desplazamiento", symbol: "Δx", unit: "m" },
  { key: "distance", label: "Distancia", symbol: "d", unit: "m" },
  { key: "velocity", label: "Velocidad", symbol: "v", unit: "m/s" },
  { key: "speed", label: "Rapidez", symbol: "|v|", unit: "m/s" },
  { key: "acceleration", label: "Aceleración", symbol: "a", unit: "m/s²" },
];
---

<section
  class="kinematics-simulation"
  data-kinematics-simulation
  data-initial-preset={initialPreset.id}
>
  <div class="kinematics-simulation__workspace">
    <aside class="kinematics-controls" aria-labelledby="kinematics-controls-title">
      <div class="kinematics-controls__header">
        <p class="academic-label">Parámetros</p>
        <h2 id="kinematics-controls-title">Configura el movimiento</h2>
        <p>Cualquier cambio pausa la reproducción y recalcula la trayectoria completa.</p>
      </div>

      <fieldset class="kinematics-presets">
        <legend>Casos de estudio</legend>
        <div>
          {KINEMATICS_1D_PRESETS.map((preset) => (
            <button
              type="button"
              data-preset={preset.id}
              aria-pressed={preset.id === initialPreset.id ? "true" : "false"}
            >{preset.label}</button>
          ))}
        </div>
      </fieldset>

      <form class="kinematics-parameters" data-parameter-form novalidate>
        {KINEMATICS_1D_CONTROLS.map((control) => {
          const value = initialParameters[control.key];
          const numberId = `kinematics-${control.key}-number`;
          const errorId = `kinematics-${control.key}-error`;
          return (
            <div class="kinematics-field" data-param-field={control.key}>
              <div class="kinematics-field__heading">
                <label for={numberId}>
                  {control.label} <span>{control.symbol}</span>
                </label>
                <output data-param-output={control.key}>
                  {formatKinematicsNumber(value)} {control.unit}
                </output>
              </div>
              <input
                type="range"
                min={control.minimum}
                max={control.maximum}
                step={control.step}
                value={value}
                aria-label={`${control.label}, control deslizante`}
                aria-describedby={errorId}
                data-param-range={control.key}
              />
              <div class="kinematics-field__number">
                <input
                  id={numberId}
                  name={control.key}
                  type="number"
                  min={control.minimum}
                  max={control.maximum}
                  step={control.step}
                  value={value}
                  required
                  inputmode="decimal"
                  aria-describedby={errorId}
                  data-param-number={control.key}
                />
                <span aria-hidden="true">{control.unit}</span>
              </div>
              <small id={errorId} data-param-error={control.key}></small>
              <small class="kinematics-field__limits">
                Rango: {control.minimum} a {control.maximum} {control.unit}
              </small>
            </div>
          );
        })}
      </form>
    </aside>

    <div class="kinematics-stage">
      <KinematicsMotion parameters={initialParameters} />

      <section class="kinematics-readings" aria-labelledby="kinematics-readings-title">
        <div class="kinematics-readings__header">
          <div>
            <p class="academic-label">Lecturas sincronizadas</p>
            <h2 id="kinematics-readings-title">Estado físico</h2>
          </div>
          <p class="kinematics-direction" data-reading="direction">
            Sentido: {initialState.direction}
          </p>
        </div>

        <dl>
          {readings.map((reading) => (
            <div>
              <dt>{reading.label} <span>{reading.symbol}</span></dt>
              <dd>
                <span data-reading={reading.key}>
                  {formatKinematicsNumber(initialState[reading.key])}
                </span>
                <small>{reading.unit}</small>
              </dd>
            </div>
          ))}
        </dl>

        <p
          class="kinematics-turning"
          data-turning-reading
          hidden={!initialTurningPoint}
        >
          Cambio de sentido previsto en
          <strong>t = <span data-turn-time>{formatKinematicsNumber(initialTurningPoint?.time)}</span> s</strong>,
          <strong>x = <span data-turn-position>{formatKinematicsNumber(initialTurningPoint?.position)}</span> m</strong>.
        </p>
      </section>
    </div>
  </div>

  <section class="kinematics-playback" aria-labelledby="kinematics-playback-title">
    <div class="kinematics-playback__heading">
      <div>
        <p class="academic-label">Tiempo</p>
        <h2 id="kinematics-playback-title">Reproducción</h2>
      </div>
      <p data-playback-state>En pausa</p>
    </div>

    <div class="kinematics-playback__controls">
      <button type="button" data-action="toggle" aria-pressed="false">
        <span data-playback-icon aria-hidden="true">▶</span>
        <span data-playback-label>Reproducir</span>
      </button>
      <button type="button" data-action="reset">
        <span aria-hidden="true">↺</span>
        Reiniciar tiempo
      </button>
      <label for="kinematics-time">
        Instante
        <output data-time-output>{formatKinematicsNumber(initialState.time)} s</output>
      </label>
      <input
        id="kinematics-time"
        type="range"
        min="0"
        max={initialParameters.T}
        step="0.01"
        value="0"
        aria-label="Instante de la simulación"
        data-time-scrubber
      />
    </div>
    <p class="sr-only" aria-live="polite" aria-atomic="true" data-simulation-live></p>
  </section>

  <section class="kinematics-charts" aria-labelledby="kinematics-charts-title">
    <div class="kinematics-charts__header">
      <div>
        <p class="academic-label">Gráficas vinculadas</p>
        <h2 id="kinematics-charts-title">Tres lecturas del mismo movimiento</h2>
      </div>
      <p>Las curvas muestran todo el intervalo; el cursor común señala el instante actual.</p>
    </div>
    <div class="kinematics-charts__grid">
      <KinematicsChart
        id="kinematics-position-chart"
        quantity="position"
        parameters={initialParameters}
        relation="Su pendiente es la velocidad."
      />
      <KinematicsChart
        id="kinematics-velocity-chart"
        quantity="velocity"
        parameters={initialParameters}
        relation="Su pendiente es a; su área algebraica es Δx."
      />
      <KinematicsChart
        id="kinematics-acceleration-chart"
        quantity="acceleration"
        parameters={initialParameters}
        relation="Su área algebraica es el cambio de velocidad."
      />
    </div>
  </section>

  <noscript>
    <div class="kinematics-noscript" role="note">
      <strong>La interacción requiere JavaScript.</strong>
      <p>
        Aun sin JavaScript puedes estudiar el modelo, los parámetros del caso
        “Frena y regresa” y las tres gráficas iniciales renderizadas en esta página.
      </p>
    </div>
  </noscript>
</section>

<script>
  import "../../scripts/kinematics-1d.js";
</script>
