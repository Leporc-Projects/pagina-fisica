---
import KinematicsChart from "./KinematicsChart.astro";
import KinematicsMotion from "./KinematicsMotion.astro";
import SimulationFloatingPlayback from "./SimulationFloatingPlayback.astro";
import { getSimulationExperienceById, localizeSimulationExperience } from "../../data/simulation-experiences.js";
import { getSimulationModelById, localizeSimulationModel } from "../../data/simulation-models.js";
import { formatNumber, t } from "../../i18n/index.js";
import {
  normalizeSimulationExperience,
  validateSimulationExperience,
} from "../../utils/simulation-experience.js";
import {
  getKinematicsState,
  getTurningPoint,
} from "../../utils/kinematics-1d.js";
import "../../styles/kinematics-simulation.css";
import "../../styles/simulation-disclosures.css";
import SimulationGraphsDisclosure from "./SimulationGraphsDisclosure.astro";

interface Props {
  experience?: Record<string, unknown>;
  preview?: boolean;
  locale?: "es" | "en";
}

const {
  experience: suppliedExperience = getSimulationExperienceById("kinematics-1d"),
  preview = false,
  locale = "es",
} = Astro.props;
const canonicalExperience = normalizeSimulationExperience(suppliedExperience);
const validation = validateSimulationExperience(canonicalExperience);
if (!validation.valid) {
  throw new TypeError(`Experiencia de Cinemática inválida: ${validation.errors.join(" ")}`);
}
const experience = localizeSimulationExperience(canonicalExperience, locale);
const model = localizeSimulationModel(getSimulationModelById(experience.modelId), locale);
if (model?.rendererId !== "svg-kinematics-1d") {
  throw new TypeError("KinematicsSimulation requiere el renderer svg-kinematics-1d.");
}

const initialParameters = Object.fromEntries(
  Object.entries(experience.parameters).map(([key, config]) => [key, config.default])
);
const initialState = getKinematicsState(initialParameters, 0);
const initialTurningPoint = getTurningPoint(initialParameters);
const controls = Object.entries(model.parameters).map(([key, definition]) => ({
  key,
  ...definition,
  ...experience.parameters[key],
}));
const initialPreset = experience.presets.find((preset) =>
  controls.every((control) => preset.parameters[control.key] === initialParameters[control.key])
);
const shouldRender = (view) => preview || experience.views[view];
const hasStage = preview || experience.views.motion || experience.views.readings || experience.views.turningPoint;
const hasCharts = preview || experience.views.positionGraph || experience.views.velocityGraph || experience.views.accelerationGraph;
const serializedExperience = JSON.stringify(experience).replaceAll("<", "\\u003c");

const readings = [
  { key: "time", label: t(locale, "simulation.reading.time"), symbol: "t", unit: "s" },
  { key: "position", label: t(locale, "simulation.reading.position"), symbol: "x", unit: "m" },
  { key: "displacement", label: t(locale, "simulation.reading.displacement"), symbol: "Δx", unit: "m" },
  { key: "distance", label: t(locale, "simulation.reading.distance"), symbol: "d", unit: "m" },
  { key: "velocity", label: t(locale, "simulation.reading.velocity"), symbol: "v", unit: "m/s" },
  { key: "speed", label: t(locale, "simulation.reading.speed"), symbol: "|v|", unit: "m/s" },
  { key: "acceleration", label: t(locale, "simulation.reading.acceleration"), symbol: "a", unit: "m/s²" },
];
const directionKey = initialState.direction === "hacia +x" ? "positive" : initialState.direction === "hacia −x" ? "negative" : "stationary";
const displayNumber = (value, digits = 2) => formatNumber(locale, value ?? 0, { maximumFractionDigits: digits });
---

<section
  class="kinematics-simulation"
  data-kinematics-simulation
  data-experience={serializedExperience}
  data-locale={locale}
  data-preview={preview ? "true" : undefined}
>
  <div class="kinematics-simulation__workspace">
    <aside class="kinematics-controls" aria-labelledby="kinematics-controls-title">
      <div class="kinematics-controls__header">
        <p class="academic-label">{t(locale, "simulation.parameters")}</p>
        <h2 id="kinematics-controls-title">{t(locale, "kinematics.configure")}</h2>
        <p>{t(locale, "kinematics.changeHelp")}</p>
      </div>

      <form class="kinematics-parameters" data-parameter-form novalidate>
        {controls.map((control) => {
          const value = initialParameters[control.key];
          const numberId = `kinematics-${control.key}-number`;
          const errorId = `kinematics-${control.key}-error`;
          return (
            <div class="kinematics-field" data-param-field={control.key}>
              <div class="kinematics-field__heading">
                <label for={numberId}>
                  {control.label} <span>{control.symbol}</span>
                </label>
                <output data-param-output={control.key}>
                  {displayNumber(value)} {control.unit}
                </output>
              </div>
              <input
                type="range"
                min={control.minimum}
                max={control.maximum}
                step={control.step}
                value={value}
                disabled={!control.editable}
                aria-label={t(locale, "simulation.slider", { label: control.label })}
                aria-describedby={errorId}
                data-param-range={control.key}
              />
              <div class="kinematics-field__number">
                <input
                  id={numberId}
                  name={control.key}
                  type="number"
                  min={control.minimum}
                  max={control.maximum}
                  step={control.step}
                  value={value}
                  disabled={!control.editable}
                  required
                  inputmode="decimal"
                  aria-describedby={errorId}
                  data-param-number={control.key}
                />
                <span aria-hidden="true">{control.unit}</span>
              </div>
              <small id={errorId} data-param-error={control.key}></small>
              <small class="kinematics-field__limits" data-param-limits={control.key}>
                {control.editable
                  ? t(locale, "simulation.range", { minimum: control.minimum, maximum: control.maximum, unit: control.unit })
                  : t(locale, "simulation.fixed", { value: displayNumber(value), unit: control.unit })}
              </small>
            </div>
          );
        })}
      </form>

      <details class="simulation-study-cases-disclosure" data-study-cases-disclosure hidden={experience.presets.length === 0}>
        <summary>{t(locale, "simulation.studyCases")}</summary>
        <fieldset class="kinematics-presets" data-presets-fieldset>
          <legend class="sr-only">{t(locale, "simulation.studyCases")}</legend>
          <div data-presets-list>
            {experience.presets.map((preset) => (
              <button
                type="button"
                data-preset={preset.id}
                aria-pressed={preset.id === initialPreset?.id ? "true" : "false"}
              >{preset.label}</button>
            ))}
          </div>
        </fieldset>
      </details>
    </aside>

    {hasStage && (
      <div class="kinematics-stage" data-stage-section>
        {shouldRender("motion") && <KinematicsMotion parameters={initialParameters} locale={locale} />}

        {(preview || experience.views.readings || experience.views.turningPoint) && (
          <section class="kinematics-readings" aria-labelledby="kinematics-readings-title" data-readings-section>
            <div class="kinematics-readings__header">
              <div>
                <p class="academic-label">{t(locale, "simulation.syncedReadings")}</p>
                <h2 id="kinematics-readings-title">{t(locale, "simulation.physicalState")}</h2>
              </div>
              {shouldRender("readings") && (
                <p class="kinematics-direction" data-view-section="readings" data-reading="direction">
                  {t(locale, "kinematics.direction", { direction: t(locale, `simulation.direction.${directionKey}`) })}
                </p>
              )}
            </div>

            {shouldRender("readings") && (
              <dl data-view-section="readings">
                {readings.map((reading) => (
                  <div>
                    <dt>{reading.label} <span>{reading.symbol}</span></dt>
                    <dd>
                      <span data-reading={reading.key}>
                        {displayNumber(initialState[reading.key])}
                      </span>
                      <small>{reading.unit}</small>
                    </dd>
                  </div>
                ))}
              </dl>
            )}

            {shouldRender("turningPoint") && (
              <p
                class="kinematics-turning"
                data-view-section="turningPoint"
                data-turning-reading
                hidden={!initialTurningPoint}
              >
                {t(locale, "kinematics.turning")}
                <strong>t = <span data-turn-time>{displayNumber(initialTurningPoint?.time)}</span> s</strong>,
                <strong>x = <span data-turn-position>{displayNumber(initialTurningPoint?.position)}</span> m</strong>.
              </p>
            )}
          </section>
        )}
      </div>
    )}
  </div>

  <section class="kinematics-playback" aria-labelledby="kinematics-playback-title" data-playback-section>
    <div class="kinematics-playback__heading">
      <div>
        <p class="academic-label">{t(locale, "simulation.time")}</p>
        <h2 id="kinematics-playback-title">{t(locale, "simulation.playback")}</h2>
      </div>
      <p data-playback-state>{t(locale, "simulation.paused")}</p>
    </div>

    <div class="kinematics-playback__controls">
      <button type="button" data-action="toggle" aria-pressed="false">
        <span data-playback-icon aria-hidden="true">▶</span>
        <span data-playback-label>{t(locale, "simulation.play")}</span>
      </button>
      <button type="button" data-action="reset">
        <span aria-hidden="true">↺</span>
        {t(locale, "simulation.resetTime")}
      </button>
      <label for="kinematics-time">
        {t(locale, "simulation.instant")}
        <output data-time-output>{displayNumber(initialState.time)} s</output>
      </label>
      <input
        id="kinematics-time"
        type="range"
        min="0"
        max={initialParameters.T}
        step="0.01"
        value="0"
        aria-label={t(locale, "simulation.timeAria")}
        data-time-scrubber
      />
    </div>
    <p class="sr-only" aria-live="polite" aria-atomic="true" data-simulation-live></p>
  </section>

  {!preview && <SimulationFloatingPlayback locale={locale} />}

  {hasCharts && (
    <SimulationGraphsDisclosure locale={locale}>
      <section class="kinematics-charts" aria-labelledby="kinematics-charts-title" data-charts-section>
        <div class="kinematics-charts__header">
          <div>
            <p class="academic-label">{t(locale, "kinematics.linkedCharts")}</p>
            <h2 id="kinematics-charts-title">{t(locale, "kinematics.chartsTitle")}</h2>
          </div>
          <p>{t(locale, "kinematics.chartsHelp")}</p>
        </div>
        <div class="kinematics-charts__grid">
          {shouldRender("positionGraph") && (
            <KinematicsChart
              id="kinematics-position-chart"
              quantity="position"
              viewKey="positionGraph"
              parameters={initialParameters}
              relation={t(locale, "kinematics.positionRelation")}
              locale={locale}
            />
          )}
          {shouldRender("velocityGraph") && (
            <KinematicsChart
              id="kinematics-velocity-chart"
              quantity="velocity"
              viewKey="velocityGraph"
              parameters={initialParameters}
              relation={t(locale, "kinematics.velocityRelation")}
              locale={locale}
            />
          )}
          {shouldRender("accelerationGraph") && (
            <KinematicsChart
              id="kinematics-acceleration-chart"
              quantity="acceleration"
              viewKey="accelerationGraph"
              parameters={initialParameters}
              relation={t(locale, "kinematics.accelerationRelation")}
              locale={locale}
            />
          )}
        </div>
      </section>
    </SimulationGraphsDisclosure>
  )}

  <noscript>
    <div class="kinematics-noscript" role="note">
      <strong>{t(locale, "kinematics.noJsTitle")}</strong>
      <p>{t(locale, "kinematics.noJsText")}</p>
    </div>
  </noscript>
</section>

<script>
  import "../../scripts/kinematics-1d.js";
</script>
