---
import { formatNumber, t } from "../../i18n/index.js";

const { controls, locale, prefix } = Astro.props;
const display = (value) => formatNumber(locale, value, { maximumFractionDigits: 2 });
---

{controls.map((control) => {
  const numberId = `${prefix}-${control.key}-number`;
  const errorId = `${prefix}-${control.key}-error`;
  return (
    <div class="dynamics-field" data-param-field={control.key}>
      <div class="dynamics-field__heading">
        <label for={numberId}>{control.label} <span>{control.symbol}</span></label>
        <output data-param-output={control.key}>{display(control.default)} {control.unit}</output>
      </div>
      <input
        type="range"
        min={control.minimum}
        max={control.maximum}
        step={control.step}
        value={control.default}
        disabled={!control.editable}
        aria-label={t(locale, "simulation.slider", { label: control.label })}
        aria-describedby={errorId}
        data-param-range={control.key}
      />
      <div class="dynamics-field__number">
        <input id={numberId} name={control.key} type="number" min={control.minimum} max={control.maximum}
          step={control.step} value={control.default} disabled={!control.editable} required inputmode="decimal"
          aria-describedby={errorId} data-param-number={control.key} />
        <span aria-hidden="true">{control.unit}</span>
      </div>
      <small id={errorId} data-param-error={control.key}></small>
    </div>
  );
})}
