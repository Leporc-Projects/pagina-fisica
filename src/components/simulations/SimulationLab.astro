---
import SimulationExperienceRenderer from "./SimulationExperienceRenderer.astro";
import {
  SIMULATION_EXPERIENCES,
  getSimulationExperienceById,
} from "../../data/simulation-experiences.js";
import {
  SIMULATION_MODELS,
  getSimulationModelById,
  localizeSimulationModel,
} from "../../data/simulation-models.js";
import { localizeSimulationExperience } from "../../data/simulation-experiences.js";
import { localizeUnit1 } from "../../data/physics/unit-1/localize.js";
import { t } from "../../i18n/index.js";
import {
  SIMULATION_EXPERIENCE_LIMITS,
} from "../../utils/simulation-experience.js";

const { locale = "es" } = Astro.props;
const experience = getSimulationExperienceById("kinematics-1d");
const previewExperience = localizeSimulationExperience(experience, locale);
const model = localizeSimulationModel(getSimulationModelById(experience.modelId), locale);
const UNIT_1 = localizeUnit1(locale);
const parameters = Object.entries(model.parameters).map(([key, definition]) => ({
  key,
  ...definition,
  ...experience.parameters[key],
}));
const contextTopicIds = new Set(experience.contexts.flatMap((context) => context.topics));
const serializedExperience = JSON.stringify(experience).replaceAll("<", "\\u003c");
const serializedModels = JSON.stringify(SIMULATION_MODELS).replaceAll("<", "\\u003c");
const serializedExperiences = JSON.stringify(SIMULATION_EXPERIENCES).replaceAll("<", "\\u003c");
const viewOptions = Object.entries(model.views);
---

<section
  class="simulation-lab"
  data-simulation-lab
  data-locale={locale}
  data-initial-experience={serializedExperience}
  data-models={serializedModels}
  data-experiences={serializedExperiences}
  aria-labelledby="simulation-lab-title"
>
  <header class="simulation-lab__intro">
    <div>
      <p class="academic-label">{t(locale, "teacher.sim.builder")}</p>
      <h2 id="simulation-lab-title">{t(locale, "teacher.sim.design")}</h2>
      <p>{t(locale, "teacher.sim.designHelp")}</p>
    </div>
    <div class="simulation-lab__local" role="note">
      <strong>{t(locale, "teacher.sim.localTitle")}</strong>
      <p>{t(locale, "teacher.sim.localText")}</p>
    </div>
  </header>

  <div class="simulation-lab__layout">
    <div class="simulation-lab__editor">
      <form data-simulation-lab-form novalidate>
        <fieldset>
          <legend>{t(locale, "teacher.sim.spanishContent")}</legend>
          <label>
            <span>{t(locale, "teacher.sim.model")}</span>
            <select name="model" aria-describedby="simulation-lab-model-help">
              {SIMULATION_MODELS.map((option) => (
                <option value={option.id} selected={option.id === model.id}>{localizeSimulationModel(option, locale).name}</option>
              ))}
            </select>
            <small id="simulation-lab-model-help">{t(locale, "teacher.sim.modelHelp")}</small>
          </label>
          <label>
            <span>{t(locale, "teacher.sim.title")}</span>
            <input
              name="title"
              value={experience.title}
              maxlength={SIMULATION_EXPERIENCE_LIMITS.maximumTitleLength}
              required
              autocomplete="off"
            />
          </label>
          <label>
            <span>{t(locale, "teacher.sim.summary")}</span>
            <textarea
              name="summary"
              rows="4"
              maxlength={SIMULATION_EXPERIENCE_LIMITS.maximumSummaryLength}
              required
            >{experience.summary}</textarea>
            <small>{t(locale, "teacher.sim.summaryHelp")}</small>
          </label>
        </fieldset>

        <fieldset>
          <legend>{t(locale, "teacher.sim.englishContent")}</legend>
          <p class="simulation-lab__fieldset-help">{t(locale, "teacher.sim.bilingualHelp")}</p>
          <label>
            <span>{t(locale, "teacher.sim.title")}</span>
            <input
              name="title-en"
              value={experience.translations.en.title}
              maxlength={SIMULATION_EXPERIENCE_LIMITS.maximumTitleLength}
              required
              autocomplete="off"
            />
          </label>
          <label>
            <span>{t(locale, "teacher.sim.summary")}</span>
            <textarea
              name="summary-en"
              rows="4"
              maxlength={SIMULATION_EXPERIENCE_LIMITS.maximumSummaryLength}
              required
            >{experience.translations.en.summary}</textarea>
          </label>
        </fieldset>

        <fieldset>
          <legend>{t(locale, "teacher.sim.parameters")}</legend>
          <p class="simulation-lab__fieldset-help">{t(locale, "teacher.sim.parametersHelp")}</p>
          <div class="simulation-lab__parameters" data-lab-parameters>
            {parameters.map((parameter) => (
              <fieldset class="simulation-lab__parameter" data-lab-parameter={parameter.key}>
                <legend>{parameter.label} <span>{parameter.symbol}</span></legend>
                <div class="simulation-lab__parameter-grid">
                  <label>
                    <span>{t(locale, "teacher.sim.initial")}</span>
                    <input
                      type="number"
                      inputmode="decimal"
                      data-parameter-property="default"
                      value={parameter.default}
                      min={parameter.hardMinimum}
                      max={parameter.hardMaximum}
                      step="any"
                      required
                    />
                  </label>
                  <label>
                    <span>{t(locale, "teacher.sim.minimum")}</span>
                    <input
                      type="number"
                      inputmode="decimal"
                      data-parameter-property="minimum"
                      value={parameter.minimum}
                      min={parameter.hardMinimum}
                      max={parameter.hardMaximum}
                      step="any"
                      required
                    />
                  </label>
                  <label>
                    <span>{t(locale, "teacher.sim.maximum")}</span>
                    <input
                      type="number"
                      inputmode="decimal"
                      data-parameter-property="maximum"
                      value={parameter.maximum}
                      min={parameter.hardMinimum}
                      max={parameter.hardMaximum}
                      step="any"
                      required
                    />
                  </label>
                  <label>
                    <span>{t(locale, "teacher.sim.step")}</span>
                    <input
                      type="number"
                      inputmode="decimal"
                      data-parameter-property="step"
                      value={parameter.step}
                      min="0.0001"
                      max={parameter.hardMaximum - parameter.hardMinimum}
                      step="any"
                      required
                    />
                  </label>
                </div>
                <label class="simulation-lab__check">
                  <input
                    type="checkbox"
                    data-parameter-editable
                    checked={parameter.editable}
                  />
                  <span>{t(locale, "teacher.sim.editable", { symbol: parameter.symbol })}</span>
                </label>
                <small>
                  {t(locale, "teacher.sim.modelLimit", { minimum: parameter.hardMinimum, maximum: parameter.hardMaximum, unit: parameter.unit })}
                </small>
              </fieldset>
            ))}
          </div>
        </fieldset>

        <fieldset data-lab-views>
          <legend>{t(locale, "teacher.sim.views")}</legend>
          <p class="simulation-lab__fieldset-help">{t(locale, "teacher.sim.viewsHelp")}</p>
          <div class="simulation-lab__checks" data-lab-view-options>
            {viewOptions.map(([key, definition]) => (
              <label class="simulation-lab__check">
                <input type="checkbox" data-lab-view={key} checked={experience.views[key]} />
                <span>{definition.label}{definition.visual ? ` · ${t(locale, "teacher.sim.mainVisual")}` : ""}</span>
              </label>
            ))}
          </div>
        </fieldset>

        <fieldset data-lab-presets-fieldset>
          <legend>{t(locale, "teacher.sim.presets")}</legend>
          <div class="simulation-lab__collection-heading">
            <p>{t(locale, "teacher.sim.presetsHelp", { count: SIMULATION_EXPERIENCE_LIMITS.maximumPresets })}</p>
            <button type="button" class="review-button" data-add-lab-preset>{t(locale, "teacher.sim.addPreset")}</button>
          </div>
          <div data-lab-presets></div>
        </fieldset>

        <fieldset data-lab-observations-fieldset>
          <legend>{t(locale, "teacher.sim.observations")}</legend>
          <div class="simulation-lab__collection-heading">
            <p>{t(locale, "teacher.sim.observationsHelp")}</p>
            <button type="button" class="review-button" data-add-lab-observation>{t(locale, "teacher.sim.addObservation")}</button>
          </div>
          <div data-lab-observations></div>
        </fieldset>

        <fieldset>
          <legend>{t(locale, "teacher.sim.context")}</legend>
          <p class="simulation-lab__fieldset-help">{t(locale, "teacher.sim.contextHelp")}</p>
          <div class="simulation-lab__checks" data-lab-context-topics>
            {UNIT_1.topics.map((topic) => (
              <label class="simulation-lab__check">
                <input type="checkbox" name="context-topic" value={topic.slug} checked={contextTopicIds.has(topic.slug)} />
                <span>{topic.title}</span>
              </label>
            ))}
          </div>
        </fieldset>

        <div
          id="simulation-lab-errors"
          class="simulation-lab__errors"
          data-simulation-lab-errors
          tabindex="-1"
          hidden
        ></div>

        <div class="simulation-lab__actions">
          <button type="button" data-preview-simulation>{t(locale, "teacher.sim.previewAction")}</button>
          <button type="button" class="review-button" data-export-simulation disabled>{t(locale, "teacher.sim.export")}</button>
        </div>
        <output class="simulation-lab__status" data-simulation-lab-status aria-live="polite"></output>
      </form>
    </div>

    <aside class="simulation-lab__preview" aria-labelledby="simulation-lab-preview-title">
      <header>
        <p class="academic-label">{t(locale, "teacher.sim.previewReal")}</p>
        <fieldset class="simulation-lab__preview-locale"><legend>{t(locale, "teacher.sim.previewLanguage")}</legend><label><input type="radio" name="simulationPreviewLocale" value="es" checked={locale === "es"} /> ES</label><label><input type="radio" name="simulationPreviewLocale" value="en" checked={locale === "en"} /> EN</label></fieldset>
        <h2 id="simulation-lab-preview-title" tabindex="-1" data-preview-title>{previewExperience.title}</h2>
        <p data-preview-summary>{previewExperience.summary}</p>
      </header>
      <SimulationExperienceRenderer experience={experience} preview includeAllRenderers locale={locale} />
      <section class="simulation-lab__preview-guide" data-preview-guide aria-labelledby="simulation-lab-preview-guide-title">
        <h3 id="simulation-lab-preview-guide-title">{t(locale, "teacher.sim.observe")}</h3>
        <ol data-preview-observations>
          {previewExperience.observations.map((observation) => <li>{observation}</li>)}
        </ol>
      </section>
    </aside>
  </div>
</section>

<script>
  import { initializeSimulationLab } from "../../scripts/simulation-lab.js";
  import { t } from "../../i18n/index.js";
  initializeSimulationLab().catch(() => {
    const status = document.querySelector("[data-simulation-lab-status]");
    const root = document.querySelector("[data-simulation-lab]");
    const locale = root?.dataset.locale === "en" ? "en" : "es";
    if (status) status.textContent = t(locale, "teacher.sim.initError");
  });
</script>
