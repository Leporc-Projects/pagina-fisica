---
import KinematicsSimulation from "./KinematicsSimulation.astro";
import ProjectileSimulation from "./ProjectileSimulation.astro";
import ForcesFrictionSimulation from "./ForcesFrictionSimulation.astro";
import CircularRadialSimulation from "./CircularRadialSimulation.astro";
import PulleySystemsSimulation from "./PulleySystemsSimulation.astro";
import {
  getSimulationExperienceByModelId,
} from "../../data/simulation-experiences.js";
import { getSimulationModelById } from "../../data/simulation-models.js";
import { getSimulationRendererById } from "../../data/simulation-renderers.js";
import {
  normalizeSimulationExperience,
  validateSimulationExperience,
} from "../../utils/simulation-experience.js";

interface Props {
  experience: Record<string, unknown>;
  preview?: boolean;
  includeAllRenderers?: boolean;
  locale?: "es" | "en";
}

const { experience: suppliedExperience, preview = false, includeAllRenderers = false, locale = "es" } = Astro.props;
const experience = normalizeSimulationExperience(suppliedExperience);
const validation = validateSimulationExperience(experience);
const model = getSimulationModelById(experience.modelId);
const renderer = getSimulationRendererById(model?.rendererId);
if (!validation.valid || !model || !renderer || renderer.modelId !== model.id) {
  throw new TypeError(validation.errors.join(" ") || "La experiencia no tiene un renderer registrado compatible.");
}
const kinematicsExperience = model.id === "kinematics-1d"
  ? experience
  : getSimulationExperienceByModelId("kinematics-1d");
const projectileExperience = model.id === "projectile-2d"
  ? experience
  : getSimulationExperienceByModelId("projectile-2d");
const forcesExperience = model.id === "forces-friction"
  ? experience
  : getSimulationExperienceByModelId("forces-friction");
const circularExperience = model.id === "circular-radial-force"
  ? experience
  : getSimulationExperienceByModelId("circular-radial-force");
const pulleyExperience = model.id === "pulley-systems"
  ? experience
  : getSimulationExperienceByModelId("pulley-systems");
const renderKinematics = includeAllRenderers || renderer.id === "svg-kinematics-1d";
const renderProjectile = includeAllRenderers || renderer.id === "p5-projectile-2d";
const renderForces = includeAllRenderers || renderer.id === "p5-forces-friction";
const renderCircular = includeAllRenderers || renderer.id === "p5-circular-radial-force";
const renderPulley = includeAllRenderers || renderer.id === "p5-pulley-systems";
---

<div
  class="simulation-experience-renderer"
  data-simulation-experience-renderer
  data-active-renderer={renderer.id}
>
  {renderKinematics && (
    <div data-renderer-slot="svg-kinematics-1d" hidden={renderer.id !== "svg-kinematics-1d"}>
      <KinematicsSimulation experience={kinematicsExperience} preview={preview} locale={locale} />
    </div>
  )}
  {renderProjectile && (
    <div data-renderer-slot="p5-projectile-2d" hidden={renderer.id !== "p5-projectile-2d"}>
      <ProjectileSimulation experience={projectileExperience} preview={preview} locale={locale} />
    </div>
  )}
  {renderForces && (
    <div data-renderer-slot="p5-forces-friction" hidden={renderer.id !== "p5-forces-friction"}>
      <ForcesFrictionSimulation experience={forcesExperience} preview={preview} locale={locale} />
    </div>
  )}
  {renderCircular && (
    <div data-renderer-slot="p5-circular-radial-force" hidden={renderer.id !== "p5-circular-radial-force"}>
      <CircularRadialSimulation experience={circularExperience} preview={preview} locale={locale} />
    </div>
  )}
  {renderPulley && (
    <div data-renderer-slot="p5-pulley-systems" hidden={renderer.id !== "p5-pulley-systems"}>
      <PulleySystemsSimulation experience={pulleyExperience} preview={preview} locale={locale} />
    </div>
  )}
</div>
