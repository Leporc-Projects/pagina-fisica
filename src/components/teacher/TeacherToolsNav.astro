---
import { t } from "../../i18n/index.js";
import { getLocalizedPath, ROUTE_IDS } from "../../i18n/routes.js";
import { withBase } from "../../utils/paths.js";

const { current = "hub", locale = "es" } = Astro.props;
const tools = [
  { id: "hub", labelKey: "teacher.nav.hub", routeId: ROUTE_IDS.COURSE_TOOLS },
  { id: "banco", labelKey: "teacher.nav.bank", routeId: ROUTE_IDS.COURSE_TOOL_QUESTION_BANK },
  { id: "avisos", labelKey: "teacher.nav.notices", routeId: ROUTE_IDS.COURSE_TOOL_NOTICES },
  { id: "simulaciones", labelKey: "teacher.nav.simulations", routeId: ROUTE_IDS.COURSE_TOOL_SIMULATION_LAB },
  { id: "revision", labelKey: "teacher.nav.review", routeId: ROUTE_IDS.COURSE_TOOL_REVIEW },
  { id: "notas", labelKey: "teacher.nav.results", routeId: ROUTE_IDS.COURSE_TOOL_RESULTS },
];
---

<nav class="teacher-tools-nav" aria-label={t(locale, "teacher.nav.label")}>
  <ul>
    {
      tools.map((tool) => (
        <li>
          <a
            href={withBase(getLocalizedPath(tool.routeId, locale))}
            aria-current={tool.id === current ? "page" : undefined}
          >
            {t(locale, tool.labelKey)}
          </a>
        </li>
      ))
    }
  </ul>
  <a class="teacher-tools-nav__course" href={withBase(getLocalizedPath(ROUTE_IDS.COURSE, locale))}>
    {t(locale, "teacher.nav.back")}
  </a>
</nav>
