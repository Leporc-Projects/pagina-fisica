---
import { t } from "../../i18n/index.js";
const { locale = "es" } = Astro.props;
---
<section class="results-step results-exports" aria-labelledby="results-exports-title">
  <header class="results-step__heading">
    <div>
      <span class="results-step__number" aria-hidden="true">6</span>
      <div>
        <p class="academic-label">{t(locale, "teacher.results.export.label")}</p>
        <h2 id="results-exports-title">{t(locale, "teacher.results.export.title")}</h2>
      </div>
    </div>
    <p>{t(locale, "teacher.results.export.help")}</p>
  </header>
  <div class="results-export-actions">
    <button type="button" data-export-xlsx>XLSX</button>
    <button type="button" data-export-csv="Consolidado.csv">{t(locale, "teacher.results.export.consolidatedCsv")}</button>
    <button type="button" data-export-csv="Incidencias.csv">{t(locale, "teacher.results.export.incidentsCsv")}</button>
    <button type="button" data-export-csv="Resumen.csv">{t(locale, "teacher.results.export.summaryCsv")}</button>
    <button type="button" data-export-txt>{t(locale, "teacher.results.export.txt")}</button>
    <button type="button" data-export-print>{t(locale, "teacher.results.export.print")}</button>
  </div>
  <p class="results-export-warning">
    {t(locale, "teacher.results.export.warning")}
  </p>
</section>
