---
import { localizeUnit1 } from "../../data/physics/unit-1/localize.js";
import { ROUTE_IDS, getLocalizedPath } from "../../i18n/routes.js";
import { t } from "../../i18n/index.js";
import { withBase } from "../../utils/paths.js";

interface Props {
  bonus: any;
  locale?: "es" | "en";
}

const { bonus, locale = "es" } = Astro.props;
const unit = localizeUnit1(locale);
const topicMap = new Map(unit.topics.map((topic) => [topic.slug, topic.shortTitle]));
---

<article class="bonus-card" aria-labelledby={`${bonus.id}-title`}>
  <div class="bonus-card__heading">
    <p class="academic-label">{unit.shortTitle}</p>
    <h3 id={`${bonus.id}-title`}>{bonus.title}</h3>
    <p>{bonus.description}</p>
  </div>

  <ul class="bonus-card__topics" aria-label={t(locale, "bonus.topicsIncluded")}>
    {bonus.topics.map((topic) => <li>{topicMap.get(topic) ?? topic}</li>)}
  </ul>

  <dl class="bonus-card__facts">
    <div>
      <dt>{t(locale, "bonus.questions")}</dt>
      <dd>{bonus.questionCount}</dd>
    </div>
    <div>
      <dt>{t(locale, "bonus.estimatedTime")}</dt>
      <dd>{bonus.estimatedMinutes} min</dd>
    </div>
  </dl>

  <a class="text-link" href={withBase(`${getLocalizedPath(ROUTE_IDS.COURSE_BONUSES, locale)}/${bonus.slug}`)}>
    {t(locale, "bonus.open")}
  </a>
</article>
