---
import { UNIT_1 } from "../../data/physics/unit-1/unit.js";
import { withBase } from "../../utils/paths.js";

interface Props {
  bonus: any;
}

const { bonus } = Astro.props;
const topicMap = new Map(UNIT_1.topics.map((topic) => [topic.slug, topic.shortTitle]));
---

<article class="bonus-card" aria-labelledby={`${bonus.id}-title`}>
  <div class="bonus-card__heading">
    <p class="academic-label">{UNIT_1.shortTitle}</p>
    <h3 id={`${bonus.id}-title`}>{bonus.title}</h3>
    <p>{bonus.description}</p>
  </div>

  <ul class="bonus-card__topics" aria-label="Temas incluidos">
    {bonus.topics.map((topic) => <li>{topicMap.get(topic) ?? topic}</li>)}
  </ul>

  <dl class="bonus-card__facts">
    <div>
      <dt>Preguntas</dt>
      <dd>{bonus.questionCount}</dd>
    </div>
    <div>
      <dt>Tiempo orientativo</dt>
      <dd>{bonus.estimatedMinutes} min</dd>
    </div>
  </dl>

  <a class="text-link" href={withBase(`/fisica-basica-1/bonos/${bonus.slug}`)}>
    Abrir Bono
  </a>
</article>
