---
import { NOTICE_CATEGORIES } from "../../utils/notices.js";
---

<section class="notice-editor" data-notice-editor aria-labelledby="notice-editor-title">
  <header class="notice-editor__intro">
    <div>
      <p class="academic-label">Borrador local</p>
      <h2 id="notice-editor-title">Preparar un aviso</h2>
      <p>Completa el contenido, comprueba su presentación y añádelo al paquete editorial.</p>
    </div>
    <p class="notice-editor__local">Nada se publica ni se envía desde esta página.</p>
  </header>

  <form data-notice-form novalidate>
    <fieldset>
      <legend>Contenido del aviso</legend>
      <label>
        <span>Título</span>
        <input name="title" maxlength="120" required autocomplete="off" />
      </label>
      <label>
        <span>Resumen</span>
        <textarea name="summary" rows="3" maxlength="280" required></textarea>
      </label>
      <label>
        <span>Contenido</span>
        <textarea name="content" rows="6" maxlength="3000" required></textarea>
        <small>Texto sin HTML. Los saltos de línea se conservan en la presentación.</small>
      </label>
    </fieldset>

    <fieldset>
      <legend>Publicación editorial</legend>
      <div class="notice-editor__grid">
        <label>
          <span>Categoría</span>
          <select name="category" required>
            {NOTICE_CATEGORIES.map((category) => <option value={category}>{category}</option>)}
          </select>
        </label>
        <label>
          <span>Fecha</span>
          <input name="publishedAt" type="date" required />
          <small>Metadato editorial; no programa una publicación.</small>
        </label>
      </div>
      <label>
        <span>Enlace opcional</span>
        <input
          name="href"
          type="text"
          inputmode="url"
          placeholder="/fisica-basica-1 o https://…"
          autocomplete="off"
        />
        <small>Admite rutas internas desde / y direcciones externas HTTPS.</small>
      </label>
      <label class="notice-editor__check">
        <input name="featured" type="checkbox" />
        <span>Destacar este aviso en la portada</span>
      </label>
      <div class="notice-editor__generated" aria-label="Metadatos automáticos">
        <span>Estado inicial: <strong>draft</strong></span>
        <span>ID y versiones: <strong>automáticos</strong></span>
      </div>
    </fieldset>

    <div class="notice-editor__actions">
      <button type="button" data-preview-notice>Comprobar y previsualizar</button>
      <button type="button" class="review-button" data-add-notice>Añadir al paquete</button>
    </div>
    <div class="notice-editor__errors" data-notice-errors aria-live="polite"></div>
  </form>

  <section class="notice-preview" data-notice-preview hidden aria-labelledby="notice-preview-title">
    <header>
      <p class="academic-label">Previsualización</p>
      <h2 id="notice-preview-title" tabindex="-1">Así se verá el aviso</h2>
    </header>
    <article class="notice-entry" data-notice-preview-card></article>
  </section>

  <section class="notice-pack" aria-labelledby="notice-pack-title">
    <header>
      <div>
        <p class="academic-label">Paquete docente</p>
        <h2 id="notice-pack-title">Avisos preparados</h2>
      </div>
      <button type="button" data-export-notice-pack disabled>Exportar paquete JSON</button>
    </header>
    <p data-notice-pack-empty>No hay avisos en el paquete.</p>
    <ol data-notice-pack-list></ol>
    <p class="notice-editor__status" data-notice-status aria-live="polite"></p>
  </section>
</section>

<script>
  import { initializeNoticeEditor } from "../../scripts/notice-editor.js";
  initializeNoticeEditor();
</script>
