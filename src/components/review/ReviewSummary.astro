---
import { t } from "../../i18n/index.js";
const { locale = "es" } = Astro.props;
---
<section class="review-summary" aria-labelledby="review-summary-title">
  <header class="review-section-heading">
    <div>
      <p class="academic-label">{t(locale, "teacher.review.summary.label")}</p>
      <h2 id="review-summary-title">{t(locale, "teacher.review.summary.title")}</h2>
    </div>
    <p>{t(locale, "teacher.review.summary.help")}</p>
  </header>

  <dl class="review-counts" data-review-counts></dl>

  <div class="review-summary__grid">
    <section aria-labelledby="review-activity-title">
      <h3 id="review-activity-title">{t(locale, "teacher.review.summary.activity")}</h3>
      <div class="review-table-wrap">
        <table>
          <thead><tr><th scope="col">{t(locale, "teacher.review.activity")}</th><th scope="col">{t(locale, "teacher.review.responsesColumn")}</th></tr></thead>
          <tbody data-review-activity-counts></tbody>
        </table>
      </div>
    </section>

    <section aria-labelledby="review-topic-chart-title">
      <h3 id="review-topic-chart-title">{t(locale, "teacher.review.summary.topics")}</h3>
      <p id="review-topic-chart-description">
        {t(locale, "teacher.review.summary.topicsHelp")}
      </p>
      <svg
        class="review-bar-chart"
        role="img"
        aria-labelledby="review-topic-chart-title review-topic-chart-description"
        data-review-topic-chart
      ></svg>
      <div class="review-table-wrap">
        <table>
          <thead><tr><th scope="col">{t(locale, "teacher.review.topic")}</th><th scope="col">{t(locale, "teacher.review.mentions")}</th></tr></thead>
          <tbody data-review-topic-counts></tbody>
        </table>
      </div>
    </section>

    <section aria-labelledby="review-support-title">
      <h3 id="review-support-title">{t(locale, "teacher.review.summary.support")}</h3>
      <div class="review-table-wrap">
        <table>
          <thead><tr><th scope="col">{t(locale, "teacher.review.supportType")}</th><th scope="col">{t(locale, "teacher.review.mentions")}</th></tr></thead>
          <tbody data-review-support-counts></tbody>
        </table>
      </div>
    </section>

    <section aria-labelledby="review-improvement-title">
      <h3 id="review-improvement-title">{t(locale, "teacher.review.summary.improvements")}</h3>
      <div class="review-table-wrap">
        <table>
          <thead><tr><th scope="col">{t(locale, "teacher.review.category")}</th><th scope="col">{t(locale, "teacher.review.responsesColumn")}</th></tr></thead>
          <tbody data-review-improvement-counts></tbody>
        </table>
      </div>
      <h4>{t(locale, "teacher.review.optionalRating")}</h4>
      <div class="review-table-wrap">
        <table>
          <thead><tr><th scope="col">{t(locale, "teacher.review.rating")}</th><th scope="col">{t(locale, "teacher.review.responsesColumn")}</th></tr></thead>
          <tbody data-review-helpfulness-counts></tbody>
        </table>
      </div>
    </section>
  </div>
</section>
