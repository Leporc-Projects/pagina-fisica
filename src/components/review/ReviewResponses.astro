---
import {
  localizeParticipationData,
} from "../../data/participation-localize.js";
import { t } from "../../i18n/index.js";

const { locale = "es" } = Astro.props;
const { activityOptions, topics } = localizeParticipationData(locale);
---

<section class="review-responses" aria-labelledby="review-responses-title">
  <header class="review-section-heading">
    <div>
      <p class="academic-label">{t(locale, "teacher.review.responses.label")}</p>
      <h2 id="review-responses-title">{t(locale, "teacher.review.responses.title")}</h2>
    </div>
    <p>{t(locale, "teacher.review.responses.help")}</p>
  </header>

  <form class="review-filters" data-review-filters>
    <label>
      {t(locale, "teacher.review.searchText")}
      <input type="search" name="query" autocomplete="off" />
    </label>
    <label>
      {t(locale, "teacher.review.topic")}
      <select name="topic">
        <option value="">{t(locale, "teacher.review.allTopics")}</option>
        {topics.map((topic) => (
          <option value={topic.slug}>{topic.title}</option>
        ))}
      </select>
    </label>
    <label>
      {t(locale, "teacher.review.activity")}
      <select name="activityType">
        <option value="">{t(locale, "teacher.review.allActivities")}</option>
        {activityOptions.map((option) => (
          <option value={option.value}>{option.label}</option>
        ))}
      </select>
    </label>
    <button type="button" class="review-button review-button--quiet" data-review-filter-reset>
      {t(locale, "teacher.review.resetFilters")}
    </button>
  </form>

  <p class="review-list-summary" data-review-response-summary></p>
  <div class="review-response-list" data-review-response-list></div>
  <nav class="review-pagination" aria-label={t(locale, "teacher.review.responses.pages")}>
    <button type="button" data-review-response-previous>{t(locale, "teacher.review.previous")}</button>
    <span data-review-response-page></span>
    <button type="button" data-review-response-next>{t(locale, "teacher.review.next")}</button>
  </nav>
</section>
