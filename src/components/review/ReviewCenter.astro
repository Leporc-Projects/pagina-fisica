---
import ReviewExportActions from "./ReviewExportActions.astro";
import ReviewImportPanel from "./ReviewImportPanel.astro";
import ReviewProposals from "./ReviewProposals.astro";
import ReviewRecords from "./ReviewRecords.astro";
import ReviewResponses from "./ReviewResponses.astro";
import ReviewSummary from "./ReviewSummary.astro";
import { t } from "../../i18n/index.js";

const { locale = "es" } = Astro.props;
---

<div class="review-center" data-review-center data-locale={locale}>
  <ReviewImportPanel {locale} />

  <div class="review-empty" data-review-empty>
    <p>{t(locale, "teacher.review.empty")}</p>
  </div>

  <div class="review-workspace" data-review-workspace hidden>
    <nav class="review-section-nav" aria-label={t(locale, "teacher.review.navLabel")}>
      <a href="#review-summary-title">{t(locale, "teacher.review.nav.summary")}</a>
      <a href="#review-responses-title">{t(locale, "teacher.review.nav.responses")}</a>
      <a href="#review-proposals-title">{t(locale, "teacher.review.nav.proposals")}</a>
      <a href="#review-bonuses-title">{t(locale, "teacher.review.nav.bonuses")}</a>
      <a href="#review-incidents-title">{t(locale, "teacher.review.nav.files")}</a>
      <a href="#review-exports-title">{t(locale, "teacher.review.nav.export")}</a>
    </nav>

    <ReviewSummary {locale} />
    <ReviewResponses {locale} />
    <ReviewProposals {locale} />
    <ReviewRecords {locale} />
    <ReviewExportActions {locale} />
  </div>
</div>

<script>
  import { initializeReviewCenter } from "../../scripts/review-center.js";
  initializeReviewCenter();
</script>
