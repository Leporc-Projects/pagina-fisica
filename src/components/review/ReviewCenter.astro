---
import ReviewExportActions from "./ReviewExportActions.astro";
import ReviewImportPanel from "./ReviewImportPanel.astro";
import ReviewProposals from "./ReviewProposals.astro";
import ReviewRecords from "./ReviewRecords.astro";
import ReviewResponses from "./ReviewResponses.astro";
import ReviewSummary from "./ReviewSummary.astro";
---

<div class="review-center" data-review-center>
  <ReviewImportPanel />

  <div class="review-empty" data-review-empty>
    <p>Selecciona los archivos que quieras revisar.</p>
  </div>

  <div class="review-workspace" data-review-workspace hidden>
    <nav class="review-section-nav" aria-label="Secciones del Centro de revisión">
      <a href="#review-summary-title">Resumen</a>
      <a href="#review-responses-title">Respuestas</a>
      <a href="#review-proposals-title">Propuestas</a>
      <a href="#review-bonuses-title">Bonos</a>
      <a href="#review-incidents-title">Archivos</a>
      <a href="#review-exports-title">Exportar</a>
    </nav>

    <ReviewSummary />
    <ReviewResponses />
    <ReviewProposals />
    <ReviewRecords />
    <ReviewExportActions />
  </div>
</div>

<script>
  import { initializeReviewCenter } from "../../scripts/review-center.js";
  initializeReviewCenter();
</script>

