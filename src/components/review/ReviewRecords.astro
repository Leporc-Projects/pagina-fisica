---
import { t } from "../../i18n/index.js";
const { locale = "es" } = Astro.props;
---
<section class="review-bonuses" aria-labelledby="review-bonuses-title">
  <header class="review-section-heading">
    <div>
      <p class="academic-label">{t(locale, "teacher.review.bonuses.label")}</p>
      <h2 id="review-bonuses-title">{t(locale, "teacher.review.bonuses.title")}</h2>
    </div>
    <p>{t(locale, "teacher.review.bonuses.help")}</p>
  </header>
  <form class="review-filters review-bonus-filters" data-review-bonus-filters>
    <label>
      {t(locale, "teacher.review.identity")}
      <select name="identityMode">
        <option value="">{t(locale, "teacher.review.allAttempts")}</option>
        <option value="anonymous">{t(locale, "teacher.review.anonymous")}</option>
        <option value="institutionalEmail">{t(locale, "teacher.review.identified")}</option>
      </select>
    </label>
    <label>
      {t(locale, "teacher.review.searchEmail")}
      <input type="search" name="email" autocomplete="off" />
    </label>
    <button type="button" class="review-button review-button--quiet" data-review-bonus-reset>{t(locale, "teacher.review.resetFilters")}</button>
  </form>
  <p class="review-list-summary" data-review-bonus-summary></p>
  <div class="review-table-wrap">
    <table>
      <thead>
        <tr>
          <th scope="col">{t(locale, "teacher.review.file")}</th>
          <th scope="col">{t(locale, "teacher.review.bonus")}</th>
          <th scope="col">{t(locale, "teacher.review.identity")}</th>
          <th scope="col">{t(locale, "teacher.review.institutionalEmail")}</th>
          <th scope="col">{t(locale, "teacher.review.result")}</th>
          <th scope="col">{t(locale, "teacher.review.date")}</th>
        </tr>
      </thead>
      <tbody data-review-bonus-records></tbody>
    </table>
  </div>
</section>

<section class="review-incidents" aria-labelledby="review-incidents-title">
  <header class="review-section-heading">
    <div>
      <p class="academic-label">{t(locale, "teacher.review.incidents.label")}</p>
      <h2 id="review-incidents-title">{t(locale, "teacher.review.incidents.title")}</h2>
    </div>
    <p>{t(locale, "teacher.review.incidents.help")}</p>
  </header>
  <div class="review-table-wrap">
    <table>
      <thead>
        <tr>
          <th scope="col">{t(locale, "teacher.review.file")}</th>
          <th scope="col">{t(locale, "teacher.review.status")}</th>
          <th scope="col">{t(locale, "teacher.review.reason")}</th>
        </tr>
      </thead>
      <tbody data-review-incidents></tbody>
    </table>
  </div>
  <nav class="review-pagination" aria-label={t(locale, "teacher.review.incidents.pages")}>
    <button type="button" data-review-incident-previous>{t(locale, "teacher.review.previous")}</button>
    <span data-review-incident-page></span>
    <button type="button" data-review-incident-next>{t(locale, "teacher.review.next")}</button>
  </nav>
</section>
