<section class="review-bonuses" aria-labelledby="review-bonuses-title">
  <header class="review-section-heading">
    <div>
      <p class="academic-label">Consulta</p>
      <h2 id="review-bonuses-title">Intentos de Bonos reconocidos</h2>
    </div>
    <p>El ID identifica el intento; una copia preparada para entrega puede incluir correo.</p>
  </header>
  <form class="review-filters review-bonus-filters" data-review-bonus-filters>
    <label>
      Identidad
      <select name="identityMode">
        <option value="">Todos los intentos</option>
        <option value="anonymous">Anónimos</option>
        <option value="institutionalEmail">Identificados</option>
      </select>
    </label>
    <label>
      Buscar correo
      <input type="search" name="email" autocomplete="off" />
    </label>
    <button type="button" class="review-button review-button--quiet" data-review-bonus-reset>Restablecer filtros</button>
  </form>
  <p class="review-list-summary" data-review-bonus-summary></p>
  <div class="review-table-wrap">
    <table>
      <thead>
        <tr>
          <th scope="col">Archivo</th>
          <th scope="col">Bono</th>
          <th scope="col">Identidad</th>
          <th scope="col">Correo institucional</th>
          <th scope="col">Resultado</th>
          <th scope="col">Fecha</th>
        </tr>
      </thead>
      <tbody data-review-bonus-records></tbody>
    </table>
  </div>
</section>

<section class="review-incidents" aria-labelledby="review-incidents-title">
  <header class="review-section-heading">
    <div>
      <p class="academic-label">Validación</p>
      <h2 id="review-incidents-title">Archivos e incidencias</h2>
    </div>
    <p>Un archivo inválido no interrumpe la importación de los demás.</p>
  </header>
  <div class="review-table-wrap">
    <table>
      <thead>
        <tr>
          <th scope="col">Archivo</th>
          <th scope="col">Estado</th>
          <th scope="col">Motivo</th>
        </tr>
      </thead>
      <tbody data-review-incidents></tbody>
    </table>
  </div>
  <nav class="review-pagination" aria-label="Páginas de incidencias">
    <button type="button" data-review-incident-previous>Anterior</button>
    <span data-review-incident-page></span>
    <button type="button" data-review-incident-next>Siguiente</button>
  </nav>
</section>
