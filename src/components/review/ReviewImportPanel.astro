---
import { t } from "../../i18n/index.js";
const { locale = "es" } = Astro.props;
---
<section class="review-import" aria-labelledby="review-import-title">
  <header>
    <p class="academic-label">{t(locale, "teacher.review.import.label")}</p>
    <h2 id="review-import-title">{t(locale, "teacher.review.import.title")}</h2>
    <p>{t(locale, "teacher.review.import.help")}</p>
  </header>

  <div class="review-dropzone" data-review-dropzone>
    <div>
      <strong>{t(locale, "teacher.review.import.drop")}</strong>
      <span>{t(locale, "teacher.review.import.orSelect")}</span>
    </div>
    <label class="review-file-button">
      <span data-review-file-label>{t(locale, "teacher.review.selectFiles")}</span>
      <input
        type="file"
        accept=".json,application/json"
        multiple
        data-review-files
      />
    </label>
  </div>

  <p class="review-import__limits">
    {t(locale, "teacher.review.import.limit")}
  </p>
  <p class="review-live" data-review-live aria-live="polite"></p>

  <div class="review-clear" data-review-clear-area hidden>
    <button type="button" class="review-button review-button--quiet" data-review-clear>
      {t(locale, "teacher.review.clear")}
    </button>
    <div class="review-clear__confirmation" data-review-clear-confirmation hidden>
      <p>{t(locale, "teacher.review.clearHelp")}</p>
      <div>
        <button type="button" data-review-clear-cancel>{t(locale, "teacher.review.cancel")}</button>
        <button type="button" class="review-button review-button--danger" data-review-clear-confirm>
          {t(locale, "teacher.review.confirmClear")}
        </button>
      </div>
    </div>
  </div>
</section>
