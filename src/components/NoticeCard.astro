---
import { SITE } from "../data/site.js";
import { noticeHrefForRender, validateNoticeHref } from "../utils/notices.js";
import { withBase } from "../utils/paths.js";

const { notice, headingLevel = "h3", compact = false, idPrefix = "notice" } = Astro.props;
const Heading = headingLevel;
const titleId = `${idPrefix}-${notice.id}`;
const hrefValidation = validateNoticeHref(notice.href);
const href = noticeHrefForRender(notice.href, withBase);
const external = hrefValidation.kind === "external";
const formattedDate = new Date(`${notice.publishedAt}T00:00:00`).toLocaleDateString(
  SITE.locale,
  { day: "2-digit", month: "long", year: "numeric" }
);
---

<article class="notice-entry" id={compact ? undefined : notice.id} aria-labelledby={titleId}>
  <div class="notice-meta">
    <span>{notice.category}</span>
    <time datetime={notice.publishedAt}>{formattedDate}</time>
  </div>

  <div class="notice-entry__heading">
    <Heading id={titleId}>{notice.title}</Heading>
    {
      notice.featured && !compact && (
        <span class="status-label status-label--featured">Destacado</span>
      )
    }
  </div>

  <p>{notice.summary}</p>
  {!compact && notice.content && <p class="notice-entry__content">{notice.content}</p>}

  {
    !compact && href && (
      <a
        class="text-link"
        href={href}
        target={external ? "_blank" : undefined}
        rel={external ? "noopener noreferrer" : undefined}
      >
        Consultar información
        <span aria-hidden="true">→</span>
      </a>
    )
  }
</article>
