---
// Presenta retroalimentación editorial por ID estable sin convertirla en Bono.
import RichText from "./RichText.astro";
import { t } from "../../i18n/index.js";

type RichContent = string | Array<{ type: string; value?: string; mathml?: string }>;

interface CommonError {
  id: string;
  topic: string;
  subtopic: string;
  description: string;
  feedback: string;
}

interface Props {
  errors: CommonError[];
  present?: (value: string) => RichContent;
  locale?: "es" | "en";
}

const { errors, present = (value) => value, locale = "es" } = Astro.props;
---

{errors.length > 0 && (
  <section class="common-errors" aria-labelledby="common-errors-title">
    <header>
      <p class="academic-label">{t(locale, "academic.conceptReview")}</p>
      <h2 id="common-errors-title">{t(locale, "academic.commonErrors")}</h2>
      <p>{t(locale, "academic.commonErrorsDescription")}</p>
    </header>

    <div class="common-errors__list">
      {errors.map((error) => (
        <details id={error.id} class="common-error">
          <summary><RichText content={present(error.description)} /></summary>
          <p><RichText content={present(error.feedback)} /></p>
        </details>
      ))}
    </div>
  </section>
)}
