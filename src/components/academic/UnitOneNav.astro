---
// Navegación única de Unidad 1; deriva rutas y estado activo de UNIT_1.
import { UNIT_1 } from "../../data/physics/unit-1/unit.js";
import { withBase } from "../../utils/paths.js";

interface Props {
  activeSlug?: string | null;
}

// Las páginas auxiliares, como la práctica, omiten el estado activo porque no
// representan ninguno de los destinos incluidos en esta navegación.
const { activeSlug = null } = Astro.props;
---

<nav class="unit-topic-nav" aria-label={`Navegación de ${UNIT_1.shortTitle}`}>
  <a
    class="unit-topic-nav__link"
    href={withBase(UNIT_1.route)}
    aria-current={activeSlug === "index" ? "page" : undefined}
  >
    <span>00</span>
    <strong>Índice</strong>
  </a>

  {UNIT_1.topics.map((topic) => (
    <a
      class:list={[
        "unit-topic-nav__link",
        topic.priority === "extension" && "unit-topic-nav__link--extension",
      ]}
      href={withBase(topic.route)}
      aria-current={activeSlug === topic.slug ? "page" : undefined}
    >
      <span>{String(topic.order).padStart(2, "0")}</span>
      <strong>{topic.shortTitle}</strong>
    </a>
  ))}
</nav>
