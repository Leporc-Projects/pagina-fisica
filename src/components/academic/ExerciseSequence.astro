---
// Experiencia reutilizable para práctica, repaso o tutoría. El HTML contiene
// todo el banco; el script mejora la vista mostrando un ejercicio por vez.
import ExerciseCard from "./ExerciseCard.astro";

type RichContent = string | Array<{ type: string; value?: string; mathml?: string }>;

interface Exercise {
  id: string;
  title: string;
  topic: string;
  type: string;
  difficulty: number;
  estimatedMinutes: number;
  prompt: string;
  hints: string[];
  solution: Array<{ step: number; title: string; text: string }>;
  objectives: string[];
}

interface Topic {
  slug: string;
  shortTitle: string;
}

interface Props {
  exercises: Exercise[];
  topics: Topic[];
  present?: (value: string) => RichContent;
}

const { exercises, topics, present = (value) => value } = Astro.props;
const topicLabels = Object.fromEntries(
  topics.map((topic) => [topic.slug, topic.shortTitle])
);
---

<section class="exercise-sequence" data-exercise-sequence aria-labelledby="exercise-sequence-title">
  <header class="exercise-sequence__header">
    <div>
      <p class="academic-label">Recorrido de práctica</p>
      <h2 id="exercise-sequence-title">Un ejercicio a la vez</h2>
    </div>

    <div class="exercise-sequence__position">
      <p data-exercise-status aria-live="polite">
        {exercises.length} ejercicios disponibles
      </p>
      <progress
        data-exercise-progress
        value="1"
        max={exercises.length}
        aria-label="Progreso en el banco de ejercicios"
      >1 de {exercises.length}</progress>
    </div>
  </header>

  <div class="exercise-sequence__picker" data-exercise-picker-wrapper>
    <label for="exercise-picker">Ir a un ejercicio</label>
    <select id="exercise-picker" data-exercise-picker>
      {exercises.map((exercise, index) => (
        <option value={exercise.id}>
          {String(index + 1).padStart(2, "0")} · {topicLabels[exercise.topic]} · {exercise.title}
        </option>
      ))}
    </select>
  </div>

  <div class="exercise-sequence__slides">
    {exercises.map((exercise, index) => (
      <div
        class="exercise-slide"
        data-exercise-slide
        data-exercise-id={exercise.id}
        data-exercise-topic={exercise.topic}
        data-exercise-type={exercise.type}
        data-exercise-difficulty={exercise.difficulty}
      >
        <p class="exercise-slide__topic">{topicLabels[exercise.topic]}</p>
        <ExerciseCard
          exercise={exercise}
          number={index + 1}
          total={exercises.length}
          present={present}
        />
      </div>
    ))}
  </div>

  <nav class="exercise-sequence__controls" aria-label="Cambiar ejercicio">
    <button type="button" data-exercise-previous>
      <span aria-hidden="true">←</span>
      Anterior
    </button>
    <p><kbd>Alt</kbd> + <kbd>←</kbd>/<kbd>→</kbd></p>
    <button type="button" data-exercise-next>
      Siguiente
      <span aria-hidden="true">→</span>
    </button>
  </nav>

  <noscript>
    <p class="exercise-sequence__fallback">
      JavaScript está desactivado: el banco completo permanece disponible en
      esta página como una lista continua.
    </p>
  </noscript>
</section>

<script>
  import { initializeExerciseSequences } from "../../scripts/exercise-sequence.js";

  initializeExerciseSequences();
</script>

