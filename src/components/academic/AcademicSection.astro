---
// Organiza una idea por profundidad sin ocultar la explicación esencial.
import RichText from "./RichText.astro";
import { t } from "../../i18n/index.js";

type RichContent = string | Array<{ type: string; value?: string; mathml?: string }>;

interface SectionContent {
  id: string;
  title: string;
  essential: string[];
  understand: string[];
  deepen: string[];
  explore?: string[];
}

interface Props {
  section: SectionContent;
  index?: number;
  present?: (value: string) => RichContent;
  locale?: "es" | "en";
}

const { section, index, present = (value) => value, locale = "es" } = Astro.props;
---

<section
  class="academic-section"
  id={section.id}
  aria-labelledby={`${section.id}-title`}
>
  <header class="academic-section__header">
    <p class="academic-label">
      {index ? t(locale, "academic.conceptNumber", { number: String(index).padStart(2, "0") }) : t(locale, "academic.concept")}
    </p>
    <h2 id={`${section.id}-title`}>{section.title}</h2>
  </header>

  <div class="academic-layer academic-layer--essential">
    <h3><span>{t(locale, "academic.essential")}</span> {t(locale, "academic.essentialDescription")}</h3>
    {section.essential.map((paragraph) => <p><RichText content={present(paragraph)} /></p>)}
  </div>

  <div class="academic-layer academic-layer--understand">
    <h3><span>{t(locale, "academic.understand")}</span> {t(locale, "academic.understandDescription")}</h3>
    {section.understand.map((paragraph) => <p><RichText content={present(paragraph)} /></p>)}
  </div>

  <details class="academic-details academic-details--deepen">
    <summary>
        <span>{t(locale, "academic.deepen")}</span>
        <strong>{t(locale, "academic.deepenDescription")}</strong>
    </summary>
    <div class="academic-details__body">
      {section.deepen.map((paragraph) => <p><RichText content={present(paragraph)} /></p>)}
    </div>
  </details>

  {section.explore && (
    <details class="academic-details academic-details--explore">
      <summary>
        <span>{t(locale, "academic.explore")}</span>
        <strong>{t(locale, "academic.exploreDescription")}</strong>
      </summary>
      <div class="academic-details__body">
        {section.explore.map((paragraph) => <p><RichText content={present(paragraph)} /></p>)}
      </div>
    </details>
  )}

  <div class="academic-section__resources">
    <slot />
  </div>
</section>
