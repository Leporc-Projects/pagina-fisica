---
// Todo el banco permanece en HTML; JavaScript elige una tanda local, aplica
// filtros y sincroniza el hash sin evaluar ni conservar actividad personal.
import ExerciseCard from "./ExerciseCard.astro";

type RichContent = string | Array<{ type: string; value?: string; mathml?: string }>;

interface Props {
  exercises: any[];
  topics: Array<{ slug: string; shortTitle: string }>;
  visualizations: Record<string, any>;
  present?: (value: string) => RichContent;
}

const {
  exercises,
  topics,
  visualizations,
  present = (value) => value,
} = Astro.props;
const fixedExercises = exercises.filter((exercise) =>
  exercise.itemKind !== "parameterizedFamily"
);
const exerciseFamilies = exercises.filter((exercise) =>
  exercise.itemKind === "parameterizedFamily"
);
const topicLabels = Object.fromEntries(
  topics.map((topic) => [topic.slug, topic.shortTitle])
);
const typeLabels = {
  conceptual: "Conceptual",
  numerical: "Numérico",
  graphical: "Gráfico",
  symbolic: "Simbólico",
  estimation: "Estimación",
  application: "Aplicación",
  integrative: "Integrador",
};
const availableTypes = [...new Set(exercises.map((exercise) => exercise.type))];
const availableDifficulties = [...new Set(exercises.map((exercise) => exercise.difficulty))]
  .sort((a, b) => a - b);
---

<section class="open-practice" data-open-practice aria-labelledby="open-practice-title">
  <header class="open-practice__header">
    <div>
      <p class="academic-label">Práctica abierta</p>
      <h2 id="open-practice-title">Haz algunos ejercicios y sigue si quieres</h2>
      <p>La página propone una tanda breve y variada. No existe una meta global que completar.</p>
    </div>
    <p class="open-practice__status" data-practice-status aria-live="polite">
      Selección local sin seguimiento
    </p>
  </header>

  <form class="open-practice__filters" data-practice-filters>
    <label>
      <span>Tema</span>
      <select name="topic" data-practice-filter="topic">
        <option value="all">Todos</option>
        {topics.map((topic) => <option value={topic.slug}>{topic.shortTitle}</option>)}
      </select>
    </label>
    <label>
      <span>Dificultad</span>
      <select name="difficulty" data-practice-filter="difficulty">
        <option value="all">Todas</option>
        {availableDifficulties.map((difficulty) => (
          <option value={difficulty}>{difficulty} de 5</option>
        ))}
      </select>
    </label>
    <label>
      <span>Tipo</span>
      <select name="type" data-practice-filter="type">
        <option value="all">Todos</option>
        {availableTypes.map((type) => (
          <option value={type}>{typeLabels[type] ?? type}</option>
        ))}
      </select>
    </label>
  </form>

  <nav class="open-practice__batch-nav" aria-label="Ejercicios de la tanda" data-batch-nav></nav>

  <div class="open-practice__slides">
    {fixedExercises.map((exercise) => (
      <div
        class="exercise-slide"
        data-exercise-slide
        data-exercise-id={exercise.id}
        data-exercise-topic={exercise.topic}
        data-exercise-type={exercise.type}
        data-exercise-difficulty={exercise.difficulty}
        data-exercise-representation={exercise.representation}
      >
        <p class="exercise-slide__topic">{topicLabels[exercise.topic]}</p>
        <ExerciseCard
          exercise={exercise}
          visualization={exercise.visualizationId
            ? visualizations[exercise.visualizationId]
            : undefined}
          present={present}
        />
      </div>
    ))}
    {exerciseFamilies.map((exercise) => (
      <div
        class="exercise-slide"
        data-exercise-slide
        data-exercise-kind="parameterizedFamily"
        data-exercise-id={exercise.id}
        data-exercise-topic={exercise.topic}
        data-exercise-type={exercise.type}
        data-exercise-difficulty={exercise.difficulty}
        data-exercise-representation={exercise.representation}
        hidden
      >
        <p class="exercise-slide__topic">{topicLabels[exercise.topic]}</p>
        <div data-generated-practice-card></div>
      </div>
    ))}
  </div>

  <nav class="open-practice__controls" aria-label="Cambiar ejercicio o tanda">
    <button type="button" data-practice-previous>
      <span aria-hidden="true">←</span> Anterior
    </button>
    <div class="open-practice__continue">
      <button type="button" data-practice-new-batch>Otros 5</button>
      <button type="button" class="button-link" data-focus-filter="topic">Cambiar tema</button>
      <button type="button" class="button-link" data-focus-filter="difficulty">Cambiar dificultad</button>
    </div>
    <button type="button" data-practice-next>
      Siguiente <span aria-hidden="true">→</span>
    </button>
  </nav>

  <noscript>
    <p class="open-practice__fallback">
      JavaScript está desactivado: todos los ejercicios públicos permanecen
      disponibles como una lista continua, sin selección de tandas.
    </p>
  </noscript>
</section>

<script>
  import { initializeOpenPractice } from "../../scripts/open-practice.js";
  initializeOpenPractice();
</script>
