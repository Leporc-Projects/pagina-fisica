---
// Autocomprobación sin estado persistente: la respuesta se revela con HTML nativo.
import RichText from "./RichText.astro";

type RichContent = string | Array<{ type: string; value?: string; mathml?: string }>;

interface Check {
  question: string;
  options?: string[];
  answer: string;
}

interface Props {
  check: Check;
  index: number;
  present?: (value: string) => RichContent;
}

const { check, index, present = (value) => value } = Astro.props;
---

<aside class="concept-check" aria-labelledby={`concept-check-${index}-title`}>
  <p class="academic-label">Comprueba tu interpretación</p>
  <h3 id={`concept-check-${index}-title`}><RichText content={present(check.question)} /></h3>

  {check.options && (
    <ol class="concept-check__options" type="A">
      {check.options.map((option) => <li><RichText content={present(option)} /></li>)}
    </ol>
  )}

  <details class="concept-check__answer">
    <summary>Revelar respuesta razonada</summary>
    <p><RichText content={present(check.answer)} /></p>
  </details>
</aside>
