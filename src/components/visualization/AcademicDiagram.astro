---
// Diagrama SVG para relaciones físicas o geométricas. La escala isotrópica
// predeterminada evita deformar ángulos, circunferencias y longitudes relativas.
import {
  clipSegmentToDomain,
  createCartesianTransform,
  createClippedSegments,
  createIsotropicTransform,
  segmentsToSvgPath,
} from "../../utils/chart.js";

type Domain = [number, number];
type DiagramStyle = "primary" | "secondary" | "tertiary" | "reference";

interface Point {
  x: number;
  y: number;
}

interface DiagramMathLabel {
  base: string;
  sub?: string;
  suffix?: string;
  baseRole?: "identifier" | "operator";
}

interface VectorSpec {
  start: Point;
  end: Point;
  label: string;
  style?: DiagramStyle;
  lineStyle?: "solid" | "dashed" | "dotted";
  mathLabel?: DiagramMathLabel;
  ariaLabel?: string;
  labelOffset?: Point;
  labelAnchor?: "start" | "middle" | "end";
  labelPosition?: "start" | "middle" | "end";
}

interface SegmentSpec {
  start: Point;
  end: Point;
  label?: string;
  style?: DiagramStyle;
  lineStyle?: "solid" | "dashed" | "dotted";
  labelOffset?: Point;
  labelAnchor?: "start" | "middle" | "end";
  labelPosition?: "start" | "middle" | "end";
}

interface CurveSpec {
  points: Array<Point | null>;
  label?: string;
  style?: DiagramStyle;
  lineStyle?: "solid" | "dashed" | "dotted";
}

interface CircleSpec {
  center: Point;
  radius: number;
  label?: string;
  style?: DiagramStyle;
}

interface PointSpec extends Point {
  label?: string;
  style?: DiagramStyle;
  labelOffset?: Point;
  labelAnchor?: "start" | "middle" | "end";
}

interface AnnotationSpec extends Point {
  label: string;
  offset?: Point;
  labelAnchor?: "start" | "middle" | "end";
}

interface GridSpec {
  x?: number[];
  y?: number[];
  labels?: boolean;
}

interface Props {
  id: string;
  title: string;
  description: string;
  xDomain: Domain;
  yDomain: Domain;
  vectors?: VectorSpec[];
  segments?: SegmentSpec[];
  curves?: CurveSpec[];
  circles?: CircleSpec[];
  points?: PointSpec[];
  annotations?: AnnotationSpec[];
  grid?: GridSpec;
  scaleMode?: "isotropic" | "stretch";
  aspectRatio?: number;
}

const {
  id,
  title,
  description,
  xDomain,
  yDomain,
  vectors = [],
  segments = [],
  curves = [],
  circles = [],
  points = [],
  annotations = [],
  grid,
  scaleMode = "isotropic",
  aspectRatio = 0.64,
} = Astro.props;

if (!/^[a-z][a-z0-9-]*$/.test(id)) {
  throw new Error("AcademicDiagram requiere un id estable en minúsculas y con guiones.");
}

const viewBoxWidth = 100;
const viewBoxHeight = viewBoxWidth * aspectRatio;
const requestedPlot = {
  left: 6,
  top: 6,
  width: 88,
  height: viewBoxHeight - 12,
};
const transform = scaleMode === "isotropic"
  ? createIsotropicTransform({ xDomain, yDomain, plot: requestedPlot })
  : createCartesianTransform({ xDomain, yDomain, plot: requestedPlot });
const plot = transform.plot;
const domains = { xDomain, yDomain };
const clipId = `${id}-diagram-clip`;
const descriptionId = `${id}-description`;
const styles: DiagramStyle[] = ["primary", "secondary", "tertiary", "reference"];
const markerId = (style: DiagramStyle) => `${id}-arrow-${style}`;
const clamp = (value: number, minimum: number, maximum: number) =>
  Math.min(maximum, Math.max(minimum, value));
const estimateLabelWidth = (
  label = "",
  mathLabel?: DiagramMathLabel
) => {
  const content = mathLabel
    ? `${mathLabel.base}${mathLabel.sub ?? ""}${mathLabel.suffix ?? ""}`
    : label;

  return clamp(
    Math.max(2.4, [...content].length * 1.45),
    2.4,
    plot.width - 3
  );
};

const keepLabelVisible = (
  point: Point,
  label = "",
  anchor: "start" | "middle" | "end" = "start",
  mathLabel?: DiagramMathLabel
) => {
  const padding = 1.2;
  const width = estimateLabelWidth(label, mathLabel);
  const minimumX = anchor === "end"
    ? plot.left + padding + width
    : anchor === "middle"
      ? plot.left + padding + width / 2
      : plot.left + padding;
  const maximumX = anchor === "start"
    ? plot.left + plot.width - padding - width
    : anchor === "middle"
      ? plot.left + plot.width - padding - width / 2
      : plot.left + plot.width - padding;

  return {
    x: clamp(point.x, minimumX, maximumX),
    y: clamp(point.y, plot.top + 2.4, plot.top + plot.height - 1.4),
  };
};
const resolveLabelPoint = (
  start: Point,
  end: Point,
  position: "start" | "middle" | "end" = "middle"
) => position === "start"
  ? start
  : position === "end"
    ? end
    : { x: (start.x + end.x) / 2, y: (start.y + end.y) / 2 };

const preparedVectors = vectors
  .map((vector) => ({
    ...vector,
    style: vector.style ?? "primary",
    lineStyle: vector.lineStyle ?? "solid",
    clipped: clipSegmentToDomain(vector.start, vector.end, domains),
  }))
  .filter((vector) => vector.clipped)
  .map((vector) => ({
    ...vector,
    svgStart: transform.point(vector.clipped![0]),
    svgEnd: transform.point(vector.clipped![1]),
  }))
  .map((vector) => {
    const labelBase = resolveLabelPoint(
      vector.svgStart,
      vector.svgEnd,
      vector.labelPosition
    );
    const offset = vector.labelOffset ?? { x: 1.2, y: -1.2 };
    return {
      ...vector,
      labelAnchor: vector.labelAnchor ?? "start",
      labelSvg: keepLabelVisible({
        x: labelBase.x + offset.x,
        y: labelBase.y + offset.y,
      }, vector.label, vector.labelAnchor ?? "start", vector.mathLabel),
    };
  });

const preparedSegments = segments
  .map((segment) => ({
    ...segment,
    style: segment.style ?? "reference",
    lineStyle: segment.lineStyle ?? "dashed",
    clipped: clipSegmentToDomain(segment.start, segment.end, domains),
  }))
  .filter((segment) => segment.clipped)
  .map((segment) => ({
    ...segment,
    svgStart: transform.point(segment.clipped![0]),
    svgEnd: transform.point(segment.clipped![1]),
  }))
  .map((segment) => {
    const labelBase = resolveLabelPoint(
      segment.svgStart,
      segment.svgEnd,
      segment.labelPosition
    );
    const offset = segment.labelOffset ?? { x: 1.2, y: -1.2 };
    return {
      ...segment,
      labelAnchor: segment.labelAnchor ?? "start",
      labelSvg: keepLabelVisible({
        x: labelBase.x + offset.x,
        y: labelBase.y + offset.y,
      }, segment.label, segment.labelAnchor ?? "start"),
    };
  });

const preparedCurves = curves.map((curve) => ({
  ...curve,
  style: curve.style ?? "primary",
  lineStyle: curve.lineStyle ?? "solid",
  path: segmentsToSvgPath(
    createClippedSegments(curve.points, domains),
    transform
  ),
}));

const preparedCircles = circles.map((circle) => {
  const center = transform.point(circle.center);
  return {
    ...circle,
    style: circle.style ?? "reference",
    center,
    radiusX: Math.abs(transform.x(circle.center.x + circle.radius) - center.x),
    radiusY: Math.abs(transform.y(circle.center.y + circle.radius) - center.y),
  };
});

const preparedPoints = points
  .filter(transform.isVisible)
  .map((point) => ({
    ...point,
    style: point.style ?? "primary",
    svg: transform.point(point),
  }))
  .map((point) => {
    const offset = point.labelOffset ?? { x: 1.2, y: -1.2 };
    return {
      ...point,
      labelAnchor: point.labelAnchor ?? "start",
      labelSvg: keepLabelVisible({
        x: point.svg.x + offset.x,
        y: point.svg.y + offset.y,
      }, point.label, point.labelAnchor ?? "start"),
    };
  });

const preparedAnnotations = annotations
  .filter(transform.isVisible)
  .map((annotation) => ({
    ...annotation,
    svg: transform.point(annotation),
    offset: annotation.offset ?? { x: 1.2, y: -1.2 },
    labelAnchor: annotation.labelAnchor ?? "start",
  }))
  .map((annotation) => ({
    ...annotation,
    labelSvg: keepLabelVisible({
      x: annotation.svg.x + annotation.offset.x,
      y: annotation.svg.y + annotation.offset.y,
    }, annotation.label, annotation.labelAnchor),
  }));

const gridX = (grid?.x ?? [])
  .filter((value) => Number.isFinite(value) && value >= xDomain[0] && value <= xDomain[1])
  .map((value) => ({ value, position: transform.x(value) }));
const gridY = (grid?.y ?? [])
  .filter((value) => Number.isFinite(value) && value >= yDomain[0] && value <= yDomain[1])
  .map((value) => ({ value, position: transform.y(value) }));
---

<figure class="academic-diagram theme-canvas" data-diagram-id={id}>
  <svg
    class="academic-diagram__svg"
    viewBox={`0 0 ${viewBoxWidth} ${viewBoxHeight}`}
    preserveAspectRatio="xMidYMid meet"
    role="img"
    aria-label={title}
    aria-describedby={descriptionId}
    data-x-min={xDomain[0]}
    data-x-max={xDomain[1]}
    data-y-min={yDomain[0]}
    data-y-max={yDomain[1]}
    data-scale-mode={scaleMode}
  >
    <desc id={descriptionId}>{description}</desc>

    <defs>
      <clipPath id={clipId}>
        <rect x={plot.left} y={plot.top} width={plot.width} height={plot.height} />
      </clipPath>
      {styles.map((style) => (
        <marker
          id={markerId(style)}
          viewBox="0 0 10 10"
          refX="8"
          refY="5"
          markerWidth="4"
          markerHeight="4"
          orient="auto-start-reverse"
        >
          <path
            class="academic-diagram__arrowhead"
            data-diagram-style={style}
            d="M 0 0 L 10 5 L 0 10 Z"
          />
        </marker>
      ))}
    </defs>

    <rect
      class="academic-diagram__plot"
      x={plot.left}
      y={plot.top}
      width={plot.width}
      height={plot.height}
    />

    {grid && (
      <g class="academic-diagram__grid" aria-hidden="true" clip-path={`url(#${clipId})`}>
        {gridX.map((line) => (
          <line
            class:list={{ "academic-diagram__axis": line.value === 0 }}
            x1={line.position}
            y1={plot.top}
            x2={line.position}
            y2={plot.top + plot.height}
          />
        ))}
        {gridY.map((line) => (
          <line
            class:list={{ "academic-diagram__axis": line.value === 0 }}
            x1={plot.left}
            y1={line.position}
            x2={plot.left + plot.width}
            y2={line.position}
          />
        ))}
      </g>
    )}

    <!-- Curvas y círculos describen trayectorias; no son imágenes decorativas. -->
    <g clip-path={`url(#${clipId})`}>
      {preparedCircles.map((circle) => (
        scaleMode === "isotropic"
          ? <circle
              class="academic-diagram__circle"
              data-diagram-style={circle.style}
              cx={circle.center.x}
              cy={circle.center.y}
              r={circle.radiusX}
              role={circle.label ? "img" : undefined}
              aria-label={circle.label}
            />
          : <ellipse
              class="academic-diagram__circle"
              data-diagram-style={circle.style}
              cx={circle.center.x}
              cy={circle.center.y}
              rx={circle.radiusX}
              ry={circle.radiusY}
              role={circle.label ? "img" : undefined}
              aria-label={circle.label}
            />
      ))}
      {preparedCurves.map((curve) => (
        <path
          class="academic-diagram__curve"
          data-diagram-style={curve.style}
          data-line-style={curve.lineStyle}
          d={curve.path}
          role={curve.label ? "img" : undefined}
          aria-label={curve.label}
        />
      ))}
      {preparedSegments.map((segment) => (
        <line
          class="academic-diagram__segment"
          data-diagram-style={segment.style}
          data-line-style={segment.lineStyle}
          x1={segment.svgStart.x}
          y1={segment.svgStart.y}
          x2={segment.svgEnd.x}
          y2={segment.svgEnd.y}
        />
      ))}
      {preparedVectors.map((vector) => (
        <line
          class="academic-diagram__vector"
          data-diagram-style={vector.style}
          data-line-style={vector.lineStyle}
          x1={vector.svgStart.x}
          y1={vector.svgStart.y}
          x2={vector.svgEnd.x}
          y2={vector.svgEnd.y}
          marker-end={`url(#${markerId(vector.style)})`}
          role="img"
          aria-label={vector.ariaLabel ?? vector.label}
        />
      ))}
      {preparedPoints.map((point) => (
        <circle
          class="academic-diagram__point"
          data-diagram-style={point.style}
          cx={point.svg.x}
          cy={point.svg.y}
          r="0.7"
        />
      ))}
    </g>

    <!-- Las etiquetas repiten la identidad de cada vector para no depender del color. -->
    <g class="academic-diagram__labels">
      {preparedVectors.map((vector) => (
        <text
          x={vector.labelSvg.x}
          y={vector.labelSvg.y}
          text-anchor={vector.labelAnchor}
          data-diagram-style={vector.style}
        >
          {vector.mathLabel
            ? <Fragment>
                <tspan
                  class:list={{
                    "academic-diagram__math-base": true,
                    "academic-diagram__math-operator":
                      vector.mathLabel.baseRole === "operator",
                  }}
                >{vector.mathLabel.base}</tspan>
                {vector.mathLabel.sub && (
                  <tspan class="academic-diagram__math-sub">{vector.mathLabel.sub}</tspan>
                )}
                {vector.mathLabel.suffix && (
                  <tspan class="academic-diagram__math-suffix" dx="0.35">
                    {vector.mathLabel.suffix}
                  </tspan>
                )}
              </Fragment>
            : vector.label}
        </text>
      ))}
      {preparedSegments.map((segment) => (
        segment.label
          ? <text
              x={segment.labelSvg.x}
              y={segment.labelSvg.y}
              text-anchor={segment.labelAnchor}
              data-diagram-style={segment.style}
            >{segment.label}</text>
          : null
      ))}
      {preparedPoints.map((point) => (
        point.label
          ? <text
              x={point.labelSvg.x}
              y={point.labelSvg.y}
              text-anchor={point.labelAnchor}
            >{point.label}</text>
          : null
      ))}
      {preparedAnnotations.map((annotation) => (
        <text
          x={annotation.labelSvg.x}
          y={annotation.labelSvg.y}
          text-anchor={annotation.labelAnchor}
        >{annotation.label}</text>
      ))}

      {grid?.labels && gridX.map((line) => (
        <text
          class="academic-diagram__tick-label"
          x={line.position}
          y={plot.top + plot.height - 1}
          text-anchor="middle"
        >{line.value}</text>
      ))}
      {grid?.labels && gridY.slice(1).map((line) => (
        <text
          class="academic-diagram__tick-label"
          x={plot.left + 1}
          y={line.position - 0.8}
          text-anchor="start"
        >{line.value}</text>
      ))}
    </g>
  </svg>
</figure>
