---
// Diagrama SVG para relaciones físicas o geométricas. La escala isotrópica
// predeterminada evita deformar ángulos, circunferencias y longitudes relativas.
// Este componente solo pinta: la composición —encuadre, colocación de etiquetas
// y validación del contrato— vive en diagram-geometry.js, el mismo módulo que
// `validate.mjs` ejecuta para comprobar que ninguna figura publique etiquetas
// superpuestas, sobre una punta de flecha o recortadas contra el borde.
import {
  DIAGRAM_STYLES,
  prepareDiagram,
} from "../../utils/diagram-geometry.js";
import {
  ARROWHEAD_LENGTH,
  ARROWHEAD_WIDTH,
  DIAGRAM_LABEL_METRICS,
} from "../../utils/diagram-layout.js";

type Domain = [number, number];
type DiagramStyle =
  | "primary"
  | "secondary"
  | "tertiary"
  | "reference"
  | "region"
  | "highlight";
type DiagramPlacement =
  | "above"
  | "below"
  | "left"
  | "right"
  | "normal"
  | "beyond-tip"
  | "inside";
type DiagramFamily =
  | "vector-geometry"
  | "system-boundary"
  | "free-body"
  | "motion-sketch"
  | "concept-map"
  | "force-sum";

interface Point {
  x: number;
  y: number;
}

interface DiagramMathLabel {
  base: string;
  sub?: string;
  suffix?: string;
  baseRole?: "identifier" | "operator";
}

interface VectorSpec {
  start: Point;
  end: Point;
  label: string;
  style?: DiagramStyle;
  lineStyle?: "solid" | "dashed" | "dotted";
  mathLabel?: DiagramMathLabel;
  ariaLabel?: string;
  labelOffset?: Point;
  labelAnchor?: "start" | "middle" | "end";
  labelPosition?: DiagramPlacement;
}

interface SegmentSpec {
  start: Point;
  end: Point;
  label?: string;
  style?: DiagramStyle;
  lineStyle?: "solid" | "dashed" | "dotted";
  labelOffset?: Point;
  labelAnchor?: "start" | "middle" | "end";
  labelPosition?: DiagramPlacement;
}

interface CurveSpec {
  points: Array<Point | null>;
  label?: string;
  style?: DiagramStyle;
  lineStyle?: "solid" | "dashed" | "dotted";
}

interface CircleSpec {
  center: Point;
  radius: number;
  label?: string;
  style?: DiagramStyle;
}

/** x,y son la esquina inferior izquierda en coordenadas físicas. */
interface RectangleSpec {
  x: number;
  y: number;
  width: number;
  height: number;
  label?: string;
  style?: DiagramStyle;
  labelAnchor?: "start" | "middle" | "end";
  labelPosition?: "inside" | "above" | "below";
}

interface PointSpec extends Point {
  label?: string;
  style?: DiagramStyle;
  labelOffset?: Point;
  labelAnchor?: "start" | "middle" | "end";
  labelPosition?: DiagramPlacement;
}

interface AnnotationSpec extends Point {
  label: string;
  offset?: Point;
  labelAnchor?: "start" | "middle" | "end";
  labelPosition?: DiagramPlacement;
}

interface GridSpec {
  x?: number[];
  y?: number[];
  labels?: boolean;
}

interface Props {
  id: string;
  title: string;
  description: string;
  family: DiagramFamily;
  xDomain: Domain;
  yDomain: Domain;
  vectors?: VectorSpec[];
  segments?: SegmentSpec[];
  curves?: CurveSpec[];
  circles?: CircleSpec[];
  rectangles?: RectangleSpec[];
  points?: PointSpec[];
  annotations?: AnnotationSpec[];
  grid?: GridSpec;
  scaleMode?: "isotropic" | "stretch";
  aspectRatio?: number;
}

const { id, title, description, grid } = Astro.props;
const diagram = prepareDiagram({
  props: Astro.props,
  fontSize: DIAGRAM_LABEL_METRICS.mobile.fontSize,
});
const { plot } = diagram;
const clipId = `${id}-diagram-clip`;
const descriptionId = `${id}-description`;
const markerId = (style: DiagramStyle) => `${id}-arrow-${style}`;

// El desplazamiento del subíndice es explícito: `baseline-shift` combinado con
// halo grueso e itálica producía glifos atravesados en las etiquetas mathLabel.
const subscriptShift = DIAGRAM_LABEL_METRICS.desktop.fontSize * 0.25;
// El cuerpo de letra llega a CSS desde el mismo módulo que calcula el ancho
// estimado de cada etiqueta, de modo que geometría y hoja de estilos no pueden
// divergir sin que el verificador de colisiones lo note.
const labelSizeStyle = [
  `--diagram-label-size: ${DIAGRAM_LABEL_METRICS.desktop.fontSize}px`,
  `--diagram-label-size-mobile: ${DIAGRAM_LABEL_METRICS.mobile.fontSize}px`,
  `--diagram-label-halo: ${DIAGRAM_LABEL_METRICS.desktop.haloWidth}`,
  `--diagram-label-halo-mobile: ${DIAGRAM_LABEL_METRICS.mobile.haloWidth}`,
].join("; ");
---

<figure
  class="academic-diagram theme-canvas"
  data-diagram-id={id}
  data-diagram-family={diagram.family}
  style={labelSizeStyle}
>
  <svg
    class="academic-diagram__svg"
    viewBox={`0 0 ${diagram.viewBoxWidth} ${diagram.viewBoxHeight}`}
    preserveAspectRatio="xMidYMid meet"
    role="img"
    aria-label={title}
    aria-describedby={descriptionId}
    data-x-min={Astro.props.xDomain[0]}
    data-x-max={Astro.props.xDomain[1]}
    data-y-min={Astro.props.yDomain[0]}
    data-y-max={Astro.props.yDomain[1]}
    data-scale-mode={diagram.scaleMode}
  >
    <desc id={descriptionId}>{description}</desc>

    <defs>
      <clipPath id={clipId}>
        <rect x={plot.left} y={plot.top} width={plot.width} height={plot.height} />
      </clipPath>
      {DIAGRAM_STYLES.map((style) => (
        <marker
          id={markerId(style)}
          viewBox="0 0 10 7"
          refX="10"
          refY="3.5"
          markerUnits="userSpaceOnUse"
          markerWidth={ARROWHEAD_LENGTH}
          markerHeight={ARROWHEAD_WIDTH}
          orient="auto-start-reverse"
        >
          <path
            class="academic-diagram__arrowhead"
            data-diagram-style={style}
            d="M 0 0 L 10 3.5 L 0 7 Z"
          />
        </marker>
      ))}
    </defs>

    <rect
      class="academic-diagram__plot"
      x={plot.left}
      y={plot.top}
      width={plot.width}
      height={plot.height}
    />

    {grid && (
      <g class="academic-diagram__grid" aria-hidden="true" clip-path={`url(#${clipId})`}>
        {diagram.gridX.map((line) => (
          <line
            class:list={{ "academic-diagram__axis": line.value === 0 }}
            x1={line.position}
            y1={plot.top}
            x2={line.position}
            y2={plot.top + plot.height}
          />
        ))}
        {diagram.gridY.map((line) => (
          <line
            class:list={{ "academic-diagram__axis": line.value === 0 }}
            x1={plot.left}
            y1={line.position}
            x2={plot.left + plot.width}
            y2={line.position}
          />
        ))}
      </g>
    )}

    <!-- Regiones, curvas y círculos describen el contexto físico; vectores y
         puntos se dibujan encima para que ninguna frontera los tape. -->
    <g clip-path={`url(#${clipId})`}>
      {diagram.rectangles.map((rectangle) => (
        <rect
          class="academic-diagram__rectangle"
          data-diagram-style={rectangle.style}
          x={rectangle.svg.x}
          y={rectangle.svg.y}
          width={rectangle.svg.width}
          height={rectangle.svg.height}
          role={rectangle.label ? "img" : undefined}
          aria-label={rectangle.label}
        />
      ))}
      {diagram.circles.map((circle) => (
        diagram.scaleMode === "isotropic"
          ? <circle
              class="academic-diagram__circle"
              data-diagram-style={circle.style}
              cx={circle.center.x}
              cy={circle.center.y}
              r={circle.radiusX}
              role={circle.label ? "img" : undefined}
              aria-label={circle.label}
            />
          : <ellipse
              class="academic-diagram__circle"
              data-diagram-style={circle.style}
              cx={circle.center.x}
              cy={circle.center.y}
              rx={circle.radiusX}
              ry={circle.radiusY}
              role={circle.label ? "img" : undefined}
              aria-label={circle.label}
            />
      ))}
      {diagram.curves.map((curve) => (
        <path
          class="academic-diagram__curve"
          data-diagram-style={curve.style}
          data-line-style={curve.lineStyle}
          d={curve.path}
          role={curve.label ? "img" : undefined}
          aria-label={curve.label}
        />
      ))}
      {diagram.segments.map((segment) => (
        <line
          class="academic-diagram__segment"
          data-diagram-style={segment.style}
          data-line-style={segment.lineStyle}
          x1={segment.svgStart.x}
          y1={segment.svgStart.y}
          x2={segment.svgEnd.x}
          y2={segment.svgEnd.y}
        />
      ))}
      {diagram.vectors.map((vector) => (
        <line
          class="academic-diagram__vector"
          data-diagram-style={vector.style}
          data-line-style={vector.lineStyle}
          x1={vector.svgStart.x}
          y1={vector.svgStart.y}
          x2={vector.svgEnd.x}
          y2={vector.svgEnd.y}
          marker-end={`url(#${markerId(vector.style)})`}
          role="img"
          aria-label={vector.ariaLabel ?? vector.label}
        />
      ))}
      {diagram.points.map((point) => (
        <circle
          class="academic-diagram__point"
          data-diagram-style={point.style}
          cx={point.svg.x}
          cy={point.svg.y}
          r="0.7"
        />
      ))}
    </g>

    <!-- Las etiquetas repiten la identidad de cada vector para no depender del color. -->
    <g class="academic-diagram__labels">
      {diagram.rectangles.map((rectangle) => (
        rectangle.labelSvg
          ? <text
              x={rectangle.labelSvg.x}
              y={rectangle.labelSvg.y}
              text-anchor={rectangle.labelSvg.anchor}
              data-diagram-style={rectangle.style}
            >{rectangle.label}</text>
          : null
      ))}
      {diagram.vectors.map((vector) => (
        <text
          x={vector.labelSvg.x}
          y={vector.labelSvg.y}
          text-anchor={vector.labelSvg.anchor}
          data-diagram-style={vector.style}
        >
          {vector.mathLabel
            ? <Fragment>
                <tspan
                  class:list={{
                    "academic-diagram__math-base": true,
                    "academic-diagram__math-operator":
                      vector.mathLabel.baseRole === "operator",
                  }}
                >{vector.mathLabel.base}</tspan>
                {vector.mathLabel.sub && (
                  <tspan class="academic-diagram__math-sub" dy={subscriptShift}>
                    {vector.mathLabel.sub}
                  </tspan>
                )}
                {vector.mathLabel.suffix && (
                  <tspan
                    class="academic-diagram__math-suffix"
                    dx="0.35"
                    dy={vector.mathLabel.sub ? -subscriptShift : 0}
                  >{vector.mathLabel.suffix}</tspan>
                )}
              </Fragment>
            : vector.label}
        </text>
      ))}
      {diagram.segments.map((segment) => (
        segment.labelSvg
          ? <text
              x={segment.labelSvg.x}
              y={segment.labelSvg.y}
              text-anchor={segment.labelSvg.anchor}
              data-diagram-style={segment.style}
            >{segment.label}</text>
          : null
      ))}
      {diagram.points.map((point) => (
        point.labelSvg
          ? <text
              x={point.labelSvg.x}
              y={point.labelSvg.y}
              text-anchor={point.labelSvg.anchor}
            >{point.label}</text>
          : null
      ))}
      {diagram.annotations.map((annotation) => (
        <text
          x={annotation.labelSvg.x}
          y={annotation.labelSvg.y}
          text-anchor={annotation.labelSvg.anchor}
        >{annotation.label}</text>
      ))}

      {grid?.labels && diagram.gridX.map((line) => (
        <text
          class="academic-diagram__tick-label"
          x={line.position}
          y={plot.top + plot.height - 1}
          text-anchor="middle"
        >{line.value}</text>
      ))}
      {grid?.labels && diagram.gridY.slice(1).map((line) => (
        <text
          class="academic-diagram__tick-label"
          x={plot.left + 1}
          y={line.position - 0.8}
          text-anchor="start"
        >{line.value}</text>
      ))}
    </g>
  </svg>
</figure>
