---
// Encabezado reutilizable para páginas generales.
// Si la sección padre usa aria-labelledby, debe pasar el mismo id a este h2.
interface Props {
  id?: string;
  title: string;
  desc?: string;
}
const { id, title, desc } = Astro.props;
---

<div class="section-heading">
  <h2 id={id}>{title}</h2>
  {desc && <p>{desc}</p>}
  <div class="section-divider" aria-hidden="true"></div>
</div>
