---
import { localizeParticipationData } from "../../data/participation-localize.js";
import { t } from "../../i18n/index.js";

const { locale = "es" } = Astro.props;
const { helpfulnessOptions, improvementAreas } = localizeParticipationData(locale);
---

<section
  class="participation-panel"
  id="activity-panel-improvement-feedback"
  data-activity-panel="improvement-feedback"
  hidden
>
  <div class="participation-panel__heading">
    <p class="participation-kicker">{t(locale, "participation.pageFeedback")}</p>
    <h2>{t(locale, "participation.improve")}</h2>
    <p>{t(locale, "participation.improveHelp")}</p>
  </div>

  <form data-activity-form="improvement-feedback">
    <div class="participation-field">
      <label for="improvement-area">{t(locale, "participation.area")}</label>
      <select id="improvement-area" name="area" required>
        <option value="">{t(locale, "participation.selectArea")}</option>
        {improvementAreas.map(([value, label]) => <option value={value}>{label}</option>)}
      </select>
    </div>

    <div class="participation-field">
      <label for="improvement-text">{t(locale, "participation.improvement")}</label>
      <textarea id="improvement-text" name="improvement" rows="7" required></textarea>
    </div>

    <fieldset class="participation-field participation-field--options">
      <legend>{t(locale, "participation.helpfulness")} <span>{t(locale, "participation.optional")}</span></legend>
      <div class="participation-radio-list participation-radio-list--short">
        {helpfulnessOptions.map(([value, label]) => (
          <label><input type="radio" name="helpfulness" value={value} /> <span>{label}</span></label>
        ))}
      </div>
    </fieldset>

    <button class="participation-primary" type="submit">{t(locale, "participation.prepare")}</button>
  </form>
</section>
