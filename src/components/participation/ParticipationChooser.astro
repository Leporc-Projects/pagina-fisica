---
import { localizeParticipationData } from "../../data/participation-localize.js";
import { t } from "../../i18n/index.js";

const { locale = "es" } = Astro.props;
const { activityOptions } = localizeParticipationData(locale);
---

<fieldset class="participation-chooser" data-activity-chooser>
  <legend>{t(locale, "participation.choose")}</legend>
  <p>{t(locale, "participation.chooseHelp")}</p>

  <div class="participation-chooser__options">
    {
      activityOptions.map((option, index) => (
        <label class="participation-choice">
          <input
            type="radio"
            name="participation-activity"
            value={option.value}
            aria-controls={`activity-panel-${option.value}`}
            data-activity-choice
          />
          <span class="participation-choice__index">
            {String(index + 1).padStart(2, "0")}
          </span>
          <strong>{option.label}</strong>
          <span>{option.description}</span>
          <small>{t(locale, "participation.select")}</small>
        </label>
      ))
    }
  </div>
</fieldset>
