---
import TopicSelect from "./TopicSelect.astro";
import { localizeParticipationData } from "../../data/participation-localize.js";
import { t } from "../../i18n/index.js";

const { locale = "es" } = Astro.props;
const { supportOptions } = localizeParticipationData(locale);
---

<section
  class="participation-panel"
  id="activity-panel-concept-difficulty"
  data-activity-panel="concept-difficulty"
  hidden
>
  <div class="participation-panel__heading">
    <p class="participation-kicker">{t(locale, "participation.learningReflection")}</p>
    <h2>{t(locale, "participation.unclear")}</h2>
    <p>{t(locale, "participation.unclearHelp")}</p>
  </div>

  <form data-activity-form="concept-difficulty">
    <TopicSelect id="concept-topic" locale={locale} />

    <div class="participation-field">
      <label for="unclear-point">{t(locale, "participation.unclear")}</label>
      <textarea
        id="unclear-point"
        name="unclearPoint"
        rows="6"
        required
        placeholder={t(locale, "participation.unclearPlaceholder")}
      ></textarea>
    </div>

    <fieldset class="participation-field participation-field--options">
      <legend>{t(locale, "participation.support")} <span>{t(locale, "participation.optional")}</span></legend>
      <div class="participation-radio-list">
        {supportOptions.map(([value, label]) => (
          <label><input type="radio" name="helpfulSupport" value={value} /> <span>{label}</span></label>
        ))}
      </div>
    </fieldset>

    <button class="participation-primary" type="submit">{t(locale, "participation.prepare")}</button>
  </form>
</section>
