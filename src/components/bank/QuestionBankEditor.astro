---
import { UNIT_1_COMMON_ERRORS } from "../../data/physics/unit-1/common-errors.js";
import { localizeUnit1, localizeUnit1CommonError } from "../../data/physics/unit-1/localize.js";
import { t } from "../../i18n/index.js";

const { locale = "es" } = Astro.props;
const unit = localizeUnit1(locale);
const commonErrors = UNIT_1_COMMON_ERRORS.map((error) => localizeUnit1CommonError(error, locale));
const languages = [["es", t(locale, "teacher.bank.spanish")], ["en", t(locale, "teacher.bank.english")]];
const types = ["conceptual", "numerical", "graphical", "symbolic", "estimation", "application", "integrative"];
const representations = ["verbal", "numerical", "symbolic", "graphical", "vectorial", "visual"];
const cognitiveLevels = ["recognize", "understand", "apply", "analyze", "integrate"];
---

<section class="bank-editor" data-bank-editor data-locale={locale} aria-labelledby="bank-editor-title">
  <header class="bank-editor__intro">
    <div><p class="academic-label">{t(locale, "teacher.bank.localDraft")}</p><h2 id="bank-editor-title">{t(locale, "teacher.bank.prepare")}</h2><p>{t(locale, "teacher.bank.prepareHelp")}</p></div>
    <p class="bank-editor__local">{t(locale, "teacher.bank.notPublished")}</p>
  </header>

  <form data-question-form novalidate>
    <fieldset>
      <legend>{t(locale, "teacher.bank.location")}</legend>
      <div class="bank-editor__grid bank-editor__grid--three">
        <label><span>{t(locale, "teacher.bank.unit")}</span><input value={unit.shortTitle} disabled /></label>
        <label><span>{t(locale, "teacher.bank.topic")}</span><select name="topic" required>{unit.topics.map((topic) => <option value={topic.slug}>{topic.shortTitle}</option>)}</select></label>
        <label><span>{t(locale, "teacher.bank.subtopic")}</span><input name="subtopic" required /></label>
      </div>
      <fieldset class="bank-editor__inline-options">
        <legend>{t(locale, "teacher.bank.modalities")}</legend>
        {[["practice", true], ["selfAssessment", true], ["bonus", false]].map(([mode, checked]) => <label><input type="checkbox" name="modalities" value={mode} checked={checked} /> {t(locale, `teacher.bank.modality.${mode}`)}</label>)}
      </fieldset>
    </fieldset>

    <fieldset>
      <legend>{t(locale, "teacher.bank.invariants")}</legend>
      <div class="bank-editor__grid bank-editor__grid--four">
        <label><span>{t(locale, "teacher.bank.type")}</span><select name="type">{types.map((entry) => <option value={entry}>{t(locale, `teacher.bank.type.${entry}`)}</option>)}</select></label>
        <label><span>{t(locale, "teacher.bank.representation")}</span><select name="representation">{representations.map((entry) => <option value={entry}>{t(locale, `teacher.bank.representation.${entry}`)}</option>)}</select></label>
        <label><span>{t(locale, "teacher.bank.cognitiveLevel")}</span><select name="cognitiveLevel">{cognitiveLevels.map((entry) => <option value={entry}>{t(locale, `teacher.bank.cognitive.${entry}`)}</option>)}</select></label>
        <label><span>{t(locale, "teacher.bank.difficulty")}</span><select name="difficulty">{[1,2,3,4,5].map((entry) => <option value={entry}>{t(locale, "teacher.bank.difficultyValue", { value: entry })}</option>)}</select></label>
      </div>
      <label class="bank-editor__check"><input type="checkbox" name="requiresEditorialMath" /><span>{t(locale, "teacher.bank.requiresMath")}</span></label>
      <p class="bank-editor__help">{t(locale, "teacher.bank.mathHelp")}</p>
      <label><span>{t(locale, "teacher.bank.commonErrors")}</span><select name="commonErrors" multiple size="5">{commonErrors.map((error) => <option value={error.id}>{error.description}</option>)}</select></label>
    </fieldset>

    {languages.map(([language, label]) => (
      <fieldset data-presentation-fields={language}>
        <legend>{t(locale, "teacher.bank.presentation", { language: label })}</legend>
        <label><span>{t(locale, "teacher.bank.title")}</span><input name={`title-${language}`} required /></label>
        <label><span>{t(locale, "teacher.bank.prompt")}</span><textarea name={`prompt-${language}`} rows="4" required></textarea></label>
        <label><span>{t(locale, "teacher.bank.objectives")} <small>({t(locale, "teacher.bank.objectivesHelp")})</small></span><textarea name={`objectives-${language}`} rows="3" required></textarea></label>
        <label><span>{t(locale, "teacher.bank.hints")} <small>({t(locale, "teacher.bank.hintsHelp")})</small></span><textarea name={`hints-${language}`} rows="3"></textarea></label>
        <label><span>{t(locale, "teacher.bank.feedbackCorrect")}</span><input name={`feedbackCorrect-${language}`} /></label>
        <label><span>{t(locale, "teacher.bank.feedbackIncorrect")}</span><input name={`feedbackIncorrect-${language}`} /></label>
      </fieldset>
    ))}

    <fieldset>
      <legend>{t(locale, "teacher.bank.answer")}</legend>
      <label class="bank-editor__kind"><span>{t(locale, "teacher.bank.interactionKind")}</span><select name="interactionKind" data-interaction-kind>{["singleChoice", "number", "multiNumber"].map((kind) => <option value={kind}>{t(locale, `teacher.bank.interaction.${kind}`)}</option>)}</select></label>
      <div data-interaction-panel="singleChoice">
        <fieldset class="bank-editor__choices">
          <legend>{t(locale, "teacher.bank.choiceLegend")}</legend>
          {["a","b","c","d"].map((id, index) => (
            <div class="bank-editor__choice-row">
              <label><input type="radio" name="correctOption" value={id} checked={index === 0} /><span class="sr-only">{t(locale, "teacher.bank.correctOption", { id: id.toUpperCase() })}</span><strong aria-hidden="true">{id.toUpperCase()}</strong></label>
              {languages.map(([language, label]) => <label><span>{label}</span><input name={`option-${language}-${id}`} aria-label={t(locale, "teacher.bank.optionContent", { language: label, id: id.toUpperCase() })} /></label>)}
            </div>
          ))}
        </fieldset>
      </div>
      <div data-interaction-panel="number" hidden>
        <div class="bank-editor__grid bank-editor__grid--three">
          <label><span>{t(locale, "teacher.bank.numberValue")}</span><input name="numberValue" type="number" step="any" /></label>
          <label><span>{t(locale, "teacher.bank.unitLabel")}</span><input name="numberUnit" /></label>
          <label><span>{t(locale, "teacher.bank.tolerance")}</span><input name="numberTolerance" type="number" step="any" min="0" value="0" /></label>
        </div>
        {languages.map(([language, label]) => <label><span>{t(locale, "teacher.bank.numberFieldLabel", { language: label })}</span><input name={`numberLabel-${language}`} /></label>)}
      </div>
      <div data-interaction-panel="multiNumber" hidden>
        <p class="bank-editor__help">{t(locale, "teacher.bank.multiHelp")}</p>
        {[1,2,3].map((index) => (
          <fieldset class="bank-editor__number-row" data-multi-row>
            <legend>{t(locale, "teacher.bank.field", { number: index })}</legend>
            <p><code>{t(locale, "teacher.bank.fieldId", { id: `value-${index}` })}</code></p>
            {languages.map(([language, label]) => <label><span>{t(locale, "teacher.bank.fieldLabel", { language: label })}</span><input name={`multiLabel-${language}-${index}`} /></label>)}
            <label><span>{t(locale, "teacher.bank.numberValue")}</span><input name={`multiValue-${index}`} type="number" step="any" /></label>
            <label><span>{t(locale, "teacher.bank.unitLabel")}</span><input name={`multiUnit-${index}`} /></label>
            <label><span>{t(locale, "teacher.bank.tolerance")}</span><input name={`multiTolerance-${index}`} type="number" step="any" min="0" value="0" /></label>
          </fieldset>
        ))}
      </div>
    </fieldset>

    {languages.map(([language, label]) => (
      <fieldset><legend>{t(locale, "teacher.bank.solution", { language: label })}</legend>
        {[1,2,3].map((index) => <div class="bank-editor__solution-row"><label><span>{t(locale, "teacher.bank.stepTitle", { number: index })}</span><input name={`solutionTitle-${language}-${index}`} /></label><label><span>{t(locale, "teacher.bank.stepText")}</span><textarea name={`solutionText-${language}-${index}`} rows="2"></textarea></label></div>)}
      </fieldset>
    ))}

    <div class="bank-editor__form-actions"><button type="button" data-preview-question>{t(locale, "teacher.bank.preview")}</button><button type="button" class="review-button" data-add-question>{t(locale, "teacher.bank.add")}</button></div>
    <div class="bank-editor__errors" data-editor-errors aria-live="polite"></div>
  </form>

  <section class="bank-preview" data-bank-preview hidden aria-labelledby="bank-preview-title">
    <header><div><p class="academic-label">{t(locale, "teacher.bank.previewLabel")}</p><h2 id="bank-preview-title" tabindex="-1">{t(locale, "teacher.bank.previewTitle")}</h2></div>
      <fieldset class="bank-preview__locale"><legend>{t(locale, "teacher.bank.previewLanguage")}</legend><label><input type="radio" name="previewLocale" value="es" checked /> ES</label><label><input type="radio" name="previewLocale" value="en" /> EN</label></fieldset>
    </header>
    <article class="exercise-card" data-preview-card></article>
  </section>

  <section class="bank-pack" aria-labelledby="bank-pack-title"><header><div><p class="academic-label">{t(locale, "teacher.bank.packLabel")}</p><h2 id="bank-pack-title">{t(locale, "teacher.bank.packTitle")}</h2></div><button type="button" data-export-pack disabled>{t(locale, "teacher.bank.export")}</button></header><p data-pack-empty>{t(locale, "teacher.bank.empty")}</p><ol data-pack-list></ol><p class="bank-editor__status" data-editor-status aria-live="polite"></p></section>
</section>

<script>
  import { initializeQuestionBankEditor } from "../../scripts/question-bank-editor.js";
  initializeQuestionBankEditor();
</script>
