---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageHeader from "../PageHeader.astro";
import SimulationExperienceRenderer from "../simulations/SimulationExperienceRenderer.astro";
import { getSimulationExperienceById, localizeSimulationExperience } from "../../data/simulation-experiences.js";
import { t } from "../../i18n/index.js";
import { ROUTE_IDS } from "../../i18n/routes.js";

const { locale = "es", experienceId } = Astro.props;
const canonicalExperience = getSimulationExperienceById(experienceId);
if (!canonicalExperience) throw new RangeError(`Unknown simulation experience: ${experienceId}`);
const experience = localizeSimulationExperience(canonicalExperience, locale);
const kinematics = experienceId === "kinematics-1d";
const prefix = kinematics ? "kinematics" : "projectile";
const routeId = kinematics ? ROUTE_IDS.KINEMATICS_1D : ROUTE_IDS.PROJECTILE_2D;
---

<BaseLayout title={experience.title} description={experience.summary} locale={locale} routeId={routeId}>
  <PageHeader eyebrow={t(locale, `${prefix}.eyebrow`)} title={experience.title} description={experience.summary} />

  <section class={`${prefix}-page-intro page-section`} aria-labelledby={`${prefix}-model-title`}>
    <div>
      <p class="academic-label">{t(locale, "simulation.model")}</p>
      <h2 id={`${prefix}-model-title`}>{t(locale, `${prefix}.modelTitle`)}</h2>
      <p>{t(locale, `${prefix}.modelDescription`)}</p>
    </div>
    {kinematics ? (
      <div class="kinematics-equations" aria-label={t(locale, "simulation.equations")}>
        <p><span>x(t)</span> = x₀ + v₀t + ½at²</p><p><span>v(t)</span> = v₀ + at</p><p><span>a(t)</span> = a</p>
      </div>
    ) : (
      <div class="projectile-equations" aria-label={t(locale, "simulation.equations")}>
        <math display="block"><mrow><mi>x</mi><mo>(</mo><mi>t</mi><mo>)</mo><mo>=</mo><msub><mi>v</mi><mrow><mi>x</mi><mn>0</mn></mrow></msub><mi>t</mi></mrow></math>
        <math display="block"><mrow><mi>y</mi><mo>(</mo><mi>t</mi><mo>)</mo><mo>=</mo><msub><mi>y</mi><mn>0</mn></msub><mo>+</mo><msub><mi>v</mi><mrow><mi>y</mi><mn>0</mn></mrow></msub><mi>t</mi><mo>−</mo><mfrac><mn>1</mn><mn>2</mn></mfrac><mi>g</mi><msup><mi>t</mi><mn>2</mn></msup></mrow></math>
        <math display="block"><mrow><msub><mi>v</mi><mi>x</mi></msub><mo>(</mo><mi>t</mi><mo>)</mo><mo>=</mo><msub><mi>v</mi><mrow><mi>x</mi><mn>0</mn></mrow></msub></mrow></math>
        <math display="block"><mrow><msub><mi>v</mi><mi>y</mi></msub><mo>(</mo><mi>t</mi><mo>)</mo><mo>=</mo><msub><mi>v</mi><mrow><mi>y</mi><mn>0</mn></mrow></msub><mo>−</mo><mi>g</mi><mi>t</mi></mrow></math>
        <p><span>vx₀</span> = v₀ cos θ · <span>vy₀</span> = v₀ sin θ</p>
      </div>
    )}
  </section>

  <SimulationExperienceRenderer experience={canonicalExperience} locale={locale} />

  {experience.observations.length > 0 && (
    <section class={`${prefix}-observe page-section`} aria-labelledby={`${prefix}-observe-title`}>
      <div><p class="academic-label">{t(locale, "simulation.guide")}</p><h2 id={`${prefix}-observe-title`}>{t(locale, "simulation.observe")}</h2></div>
      <ol>{experience.observations.map((observation, index) => <li><span>{String(index + 1).padStart(2, "0")}</span><p>{observation}</p></li>)}</ol>
    </section>
  )}

  <section class={`${prefix}-limits page-section`} aria-labelledby={`${prefix}-limits-title`}>
    <p class="academic-label">{t(locale, "simulation.scope")}</p><h2 id={`${prefix}-limits-title`}>{t(locale, "simulation.limits")}</h2><p>{t(locale, `${prefix}.limitsText`)}</p>
  </section>
</BaseLayout>
