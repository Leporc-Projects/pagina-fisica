---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageHeader from "../PageHeader.astro";
import SimulationExperienceRenderer from "../simulations/SimulationExperienceRenderer.astro";
import SimulationModelExplanation from "../simulations/SimulationModelExplanation.astro";
import { getSimulationExperienceById, localizeSimulationExperience } from "../../data/simulation-experiences.js";
import { getSimulationPageDefinition } from "../../data/simulation-pages.js";
import { t } from "../../i18n/index.js";

const { locale = "es", experienceId } = Astro.props;
const canonicalExperience = getSimulationExperienceById(experienceId);
if (!canonicalExperience) throw new RangeError(`Unknown simulation experience: ${experienceId}`);
const experience = localizeSimulationExperience(canonicalExperience, locale);
const { prefix, routeId, className } = getSimulationPageDefinition(experienceId);
---

<BaseLayout title={experience.title} description={experience.summary} locale={locale} routeId={routeId}>
  <PageHeader eyebrow={t(locale, `${prefix}.eyebrow`)} title={experience.title} description={experience.summary} />

  <section class={`${className}-page-intro page-section`} aria-labelledby={`${className}-model-title`}>
    <div>
      <p class="academic-label">{t(locale, "simulation.model")}</p>
      <h2 id={`${className}-model-title`}>{t(locale, `${prefix}.modelTitle`)}</h2>
      <p>{t(locale, `${prefix}.modelDescription`)}</p>
    </div>
    <SimulationModelExplanation modelId={experience.modelId} locale={locale} />
  </section>

  <SimulationExperienceRenderer experience={canonicalExperience} locale={locale} />

  {experience.observations.length > 0 && (
    <section class={`${className}-observe page-section`} aria-labelledby={`${className}-observe-title`}>
      <div><p class="academic-label">{t(locale, "simulation.guide")}</p><h2 id={`${className}-observe-title`}>{t(locale, "simulation.observe")}</h2></div>
      <ol>{experience.observations.map((observation, index) => <li><span>{String(index + 1).padStart(2, "0")}</span><p>{observation}</p></li>)}</ol>
    </section>
  )}

  <section class={`${className}-limits page-section`} aria-labelledby={`${className}-limits-title`}>
    <p class="academic-label">{t(locale, "simulation.scope")}</p><h2 id={`${className}-limits-title`}>{t(locale, "simulation.limits")}</h2><p>{t(locale, `${prefix}.limitsText`)}</p>
  </section>
</BaseLayout>
