---
// Pie compartido y declaración explícita del carácter personal e independiente.
import { SITE } from "../data/site.js";
import { t } from "../i18n/index.js";
import { getLocalizedPath, ROUTE_IDS } from "../i18n/routes.js";
import { withBase } from "../utils/paths.js";

const { locale = "es" } = Astro.props;

const year = new Date().getFullYear();
---

<footer class="site-footer" role="contentinfo">
  <div class="container footer-inner">
    <div>
      <p class="footer-brand">
        {SITE.name}
      </p>

      <p class="footer-teacher">
        {SITE.teacherName}
      </p>
    </div>

    <div class="footer-meta">
      <p>
        {t(locale, "footer.independent")}
      </p>
      <a href={withBase(getLocalizedPath(ROUTE_IDS.ANALYTICS_PRIVACY, locale))}>
        {t(locale, "analytics.footerLink")}
      </a>
      <p>{year}</p>
    </div>
  </div>
</footer>
