---
// Página de inicio.
import BaseLayout from "../layouts/BaseLayout.astro";

import {
  SITE,
  HOME_LINKS,
} from "../data/site.js";
import { COURSE } from "../data/course.js";
import { getNoticesByDate } from "../data/notices.js";

// La portada limita la fuente compartida; /avisos conserva el archivo completo.
const recentNotices = getNoticesByDate().slice(0, 3);
---

<BaseLayout
  title="Inicio"
  description={SITE.description}
  fullWidth
>
  <section
    class="landing"
    aria-labelledby="landing-title"
  >
    <div
      class="landing-grid"
      aria-hidden="true"
    ></div>

    <div class="container landing-inner">
      <div class="landing-mark">
        <img
          src={SITE.logoPath}
          alt="Logotipo de Papilla's Physics"
          width="220"
          height="220"
        />
      </div>

      <p class="eyebrow">
        Espacio docente de física
      </p>

      <h1 id="landing-title">
        {SITE.name}
      </h1>

      <p class="landing-teacher">
        {SITE.teacherName}
      </p>

      <p class="landing-tagline">
        {SITE.tagline}
      </p>

      <button
        class="landing-menu-button"
        type="button"
        aria-controls="site-menu"
        aria-expanded="false"
        data-menu-open
      >
        <span>Menú</span>

        <svg
          aria-hidden="true"
          viewBox="0 0 24 24"
          width="22"
          height="22"
        >
          <path d="M4 7h16M4 12h16M4 17h16"></path>
        </svg>
      </button>

      <a class="scroll-cue" href="#contenido">
        <span>Explorar</span>

        <svg
          aria-hidden="true"
          viewBox="0 0 24 24"
          width="18"
          height="18"
        >
          <path d="M12 4v16M6 14l6 6 6-6"></path>
        </svg>
      </a>
    </div>
  </section>

  <section
    class="home-content"
    id="contenido"
  >
    <div class="container">
      <header class="editorial-heading">
        <p class="eyebrow eyebrow--dark">
          Curso activo
        </p>

        <div>
          <h2>{COURSE.name}</h2>

          <p>
            Un espacio para reunir materiales, práctica
            guiada, simulaciones y recursos del curso de
            mecánica newtoniana.
          </p>
        </div>

        <a
          class="text-link"
          href="/fisica-basica-1"
        >
          Entrar al curso
          <span aria-hidden="true">→</span>
        </a>
      </header>

      <div
        class="home-directory"
        aria-label="Secciones destacadas"
      >
        {
          HOME_LINKS.map((item) => (
            <a
              class="directory-row"
              href={item.href}
            >
              <span class="directory-number">
                {item.number}
              </span>

              <span class="directory-copy">
                <strong>{item.label}</strong>
                <span>{item.description}</span>
              </span>

              <svg
                aria-hidden="true"
                viewBox="0 0 24 24"
                width="22"
                height="22"
              >
                <path d="M5 12h14M13 6l6 6-6 6"></path>
              </svg>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <section
    class="notices-section"
    id="avisos"
    aria-labelledby="notices-title"
  >
    <div class="container notices-layout">
      <div>
        <p class="eyebrow eyebrow--dark">
          Actualizaciones
        </p>

        <h2 id="notices-title">
          Avisos
        </h2>
      </div>

      <div class="notice-list">
        {
          recentNotices.map((notice) => (
            <article
              class="notice-entry"
              aria-labelledby={`home-notice-${notice.id}`}
            >
              <div class="notice-meta">
                <span>{notice.category}</span>

                <time datetime={notice.date}>
                  {
                    new Date(
                      `${notice.date}T00:00:00`
                    ).toLocaleDateString(
                      SITE.locale,
                      {
                        day: "2-digit",
                        month: "long",
                        year: "numeric",
                      }
                    )
                  }
                </time>
              </div>

              <h3 id={`home-notice-${notice.id}`}>
                {notice.title}
              </h3>
              <p>{notice.summary}</p>
            </article>
          ))
        }

        <a class="notice-list__more" href="/avisos">
          Consultar todos los avisos
          <span aria-hidden="true">→</span>
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
