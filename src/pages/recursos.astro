---
// Biblioteca de recursos de aprendizaje.
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHeader from "../components/PageHeader.astro";
import SectionHeading from "../components/SectionHeading.astro";
import { BIBLIOGRAPHY, COURSE } from "../data/course.js";
---

<BaseLayout
  title="Recursos"
  description={`Guías, bibliografía y recursos de consulta para ${COURSE.name}.`}
>
  <PageHeader
    eyebrow="Biblioteca"
    title="Recursos"
    description="Materiales propios y referencias públicas seleccionadas para acompañar el estudio."
  />

  <section class="page-section" aria-labelledby="guides-title">
    <SectionHeading
      id="guides-title"
      title="Guías y apuntes"
      desc="Documentos elaborados y revisados para el curso."
    />

    <div class="empty-state">
      <p class="empty-state__label">Estado actual</p>
      <h3>Contenido en preparación</h3>
      <p>Las guías se publicarán únicamente después de su revisión académica.</p>
    </div>
  </section>

  <section class="page-section" aria-labelledby="bibliography-title">
    <SectionHeading
      id="bibliography-title"
      title="Bibliografía de referencia"
      desc="Textos establecidos en los datos académicos del curso."
    />

    <div class="bibliography-list">
      {
        BIBLIOGRAPHY.map((book) => (
          <article class="bibliography-row">
            <span class="bibliography-row__mark">{book.shortName}</span>

            <div>
              <h3>{book.title}</h3>
              <p>{book.authors}</p>
              {book.edition && <small>{book.edition}</small>}
            </div>

            <span class="bibliography-row__role">{book.role}</span>
          </article>
        ))
      }
    </div>
  </section>

  <section class="page-section" aria-labelledby="audiovisual-title">
    <SectionHeading
      id="audiovisual-title"
      title="Biblioteca audiovisual"
      desc="Los videos propios se organizarán por unidad en la página del curso."
    />

    <div class="transition-panel transition-panel--compact">
      <h3>Aún no hay videos publicados</h3>
      <p>No se mostrarán títulos ni plataformas hasta contar con enlaces reales y aprobados.</p>
      <a class="text-link" href="/fisica-basica-1/videos">
        Consultar la biblioteca
        <span aria-hidden="true">→</span>
      </a>
    </div>
  </section>

  <section class="page-section" aria-labelledby="external-resources-title">
    <SectionHeading
      id="external-resources-title"
      title="Recursos externos"
      desc="Sitios públicos de consulta para explorar y revisar conceptos."
    />

    <div class="resource-link-list">
      <article class="resource-link-row">
        <div>
          <h3>PhET Interactive Simulations</h3>
          <p>Simulaciones educativas públicas de la Universidad de Colorado Boulder.</p>
        </div>
        <a
          class="text-link"
          href="https://phet.colorado.edu/es/"
          target="_blank"
          rel="noopener noreferrer"
        >
          Visitar sitio
        </a>
      </article>

      <article class="resource-link-row">
        <div>
          <h3>HyperPhysics</h3>
          <p>Mapa temático público para consultar conceptos y relaciones de física.</p>
        </div>
        <a
          class="text-link"
          href="http://hyperphysics.phy-astr.gsu.edu/hbase/hframe.html"
          target="_blank"
          rel="noopener noreferrer"
        >
          Visitar sitio
        </a>
      </article>
    </div>
  </section>
</BaseLayout>
