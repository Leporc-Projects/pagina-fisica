---
// Ruta de compatibilidad para la antigua página de actividades.
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHeader from "../components/PageHeader.astro";
import { COURSE } from "../data/course.js";
import { withBase } from "../utils/paths.js";
---

<BaseLayout
  title="Actividades"
  description={`Acceso al catálogo de ejercicios y tutorías de ${COURSE.name}.`}
>
  <PageHeader
    eyebrow="Ruta de compatibilidad"
    title="Actividades"
    description="Los materiales de práctica ahora forman parte de la sección académica del curso."
  />

  <section class="transition-panel" aria-labelledby="activities-transition-title">
    <p class="course-section__index">Nueva ubicación</p>
    <h2 id="activities-transition-title">Ejercicios y tutorías</h2>
    <p>
      El catálogo por unidades reúne el estado previsto de diagnósticos,
      práctica guiada, ejercicios, retos y tutorías interactivas.
    </p>
    <a class="text-link" href={withBase("/fisica-basica-1/ejercicios")}>
      Ir al catálogo del curso
      <span aria-hidden="true">→</span>
    </a>
  </section>
</BaseLayout>
