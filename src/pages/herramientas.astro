---
// Espacio futuro para herramientas docentes locales.
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHeader from "../components/PageHeader.astro";
import SectionHeading from "../components/SectionHeading.astro";
import { COURSE } from "../data/course.js";
---

<BaseLayout
  title="Herramientas docentes"
  description={`Herramientas locales de apoyo docente para ${COURSE.name}.`}
>
  <PageHeader
    eyebrow="Trabajo local"
    title="Herramientas docentes"
    description="Espacio reservado para utilidades que funcionen en el navegador y protejan la información académica."
  />

  <section class="page-section" aria-labelledby="local-tools-title">
    <SectionHeading
      id="local-tools-title"
      title="Herramienta prevista"
      desc="No hay utilidades operativas publicadas en este momento."
    />

    <article class="local-tool-panel" aria-labelledby="grade-tool-title">
      <div>
        <p class="course-section__index">Evaluación</p>
        <h3 id="grade-tool-title">Consolidador local de notas</h3>
        <p>
          La futura herramienta permitirá revisar y consolidar archivos de evaluación
          sin transferirlos fuera del dispositivo.
        </p>
      </div>

      <span class="status-label status-label--preparing">En preparación</span>
    </article>
  </section>

  <section class="page-section" aria-labelledby="tool-principles-title">
    <SectionHeading
      id="tool-principles-title"
      title="Principios de privacidad"
      desc="Condiciones que deberá cumplir cualquier herramienta publicada aquí."
    />

    <ol class="content-type-list">
      <li><span>01</span><p>Procesamiento completo dentro del navegador.</p></li>
      <li><span>02</span><p>Ausencia de envíos a servidores o servicios externos.</p></li>
      <li><span>03</span><p>Sin conservación de datos al cerrar o recargar la página.</p></li>
      <li><span>04</span><p>Sin datos personales incorporados al repositorio.</p></li>
    </ol>
  </section>
</BaseLayout>
