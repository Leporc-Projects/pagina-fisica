---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHeader from "../components/PageHeader.astro";
import { withBase } from "../utils/paths.js";
---

<BaseLayout
  title="Herramientas docentes"
  description="Acceso a las herramientas docentes locales de Física Básica I."
>
  <PageHeader
    eyebrow="Física Básica I"
    title="Herramientas docentes"
    description="Las utilidades docentes del curso están reunidas en un único espacio."
  />
  <section class="page-section" aria-labelledby="tools-access-title">
    <div class="transition-panel">
      <p class="course-section__index">Acceso</p>
      <h2 id="tools-access-title">Abrir el espacio docente del curso</h2>
      <p>Las herramientas funcionan localmente en el navegador y no constituyen un área privada.</p>
      <a class="text-link" href={withBase("/fisica-basica-1/herramientas")}>Ir a Herramientas docentes</a>
    </div>
  </section>
</BaseLayout>
