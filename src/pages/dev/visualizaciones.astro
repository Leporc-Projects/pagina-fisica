---
// Laboratorio interno para verificar el contrato técnico sin añadir contenido
// académico ni exponer la ruta en la navegación del sitio.
import CartesianChart from "../../components/visualization/CartesianChart.astro";
import PageHeader from "../../components/PageHeader.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";

const samplePoints = [
  { x: -5, y: 3 },
  { x: -3, y: 2 },
  { x: -1, y: -1 },
  { x: 1, y: 1.5 },
  { x: 3, y: 3.5 },
  { x: 5, y: 2.5 },
];

const areaPoints = [
  { x: -4, y: -1.2 },
  { x: -2, y: 0.4 },
  { x: 0, y: 1.1 },
  { x: 2, y: 0.2 },
  { x: 4, y: -0.8 },
];
---

<BaseLayout
  title="Laboratorio de visualizaciones"
  description="Página interna para comprobar la infraestructura SVG reutilizable."
>
  <article class="visualization-demo">
    <PageHeader
      eyebrow="Desarrollo interno"
      title="Laboratorio de visualizaciones"
      description="Datos sintéticos para revisar escalado, recorte, series, áreas, referencias, vectores, anotaciones y tema."
    />

    <!-- La demo usa datos genéricos; no representa una unidad ni una actividad. -->
    <CartesianChart
      id="demo-cartesiana"
      title="Comprobación técnica de una gráfica cartesiana"
      description="Dos curvas, una serie de puntos, un área, una referencia vertical, un vector y una anotación sobre ejes cartesianos genéricos."
      xAxis={{
        domain: [-4, 4],
        label: "Entrada u",
        ticks: 5,
      }}
      yAxis={{
        domain: [-2, 4],
        label: "Salida f(u)",
        ticks: 7,
      }}
      series={[
        {
          id: "muestras",
          label: "Muestras discretas",
          description: "Marcadores cuadrados unidos por una línea discontinua.",
          points: samplePoints,
          mode: "line-points",
          marker: "square",
          lineStyle: "dashed",
        },
        {
          id: "zona",
          label: "Zona de comprobación",
          description: "Área recortada contra una línea base física.",
          points: areaPoints,
          mode: "area",
          baseline: -1.5,
          lineStyle: "dotted",
        },
      ]}
      functions={[
        {
          id: "funcion",
          label: "Función suministrada",
          description: "Muestreo de una función recibida mediante props.",
          evaluate: (value) => 0.45 * value + 0.8,
          samples: 81,
        },
      ]}
      references={[
        { axis: "x", value: 1.5, label: "Referencia" },
      ]}
      vectors={[
        {
          start: { x: -3.25, y: -1.3 },
          end: { x: -1.6, y: 1.4 },
          label: "Vector",
        },
      ]}
      annotations={[
        { x: 2, y: 2.6, label: "Anotación" },
      ]}
    />

    <ul class="visualization-demo__notes" aria-label="Aspectos comprobados">
      <li>
        <strong>Datos</strong>
        Las entradas permanecen en coordenadas del problema.
      </li>
      <li>
        <strong>Geometría</strong>
        Escalas, recorte y paths se resuelven antes de presentar el SVG.
      </li>
      <li>
        <strong>Presentación</strong>
        El color procede de tokens y el trazo aporta una segunda señal visual.
      </li>
    </ul>
  </article>
</BaseLayout>
