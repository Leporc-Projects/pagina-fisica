---
// Archivo público que comparte la misma fuente de avisos con la portada.
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHeader from "../components/PageHeader.astro";
import NoticeCard from "../components/NoticeCard.astro";
import { getGlobalNotices } from "../data/notices.js";

const notices = getGlobalNotices();
---

<BaseLayout
  title="Avisos generales"
  description="Actualizaciones generales de Aula Física."
>
  <PageHeader
    eyebrow="Actualizaciones generales"
    title="Avisos de Aula Física"
    description="Información general del sitio, novedades y recursos compartidos más allá de un curso particular."
  />

  <!-- Mantiene un estado vacío válido si la fuente editorial no tiene registros. -->
  <section class="page-section" aria-labelledby="notice-archive-title">
    <div class="section-heading">
      <h2 id="notice-archive-title">Archivo general</h2>
      <p>Los avisos se presentan del más reciente al más antiguo.</p>
      <div class="section-divider" aria-hidden="true"></div>
    </div>

    {
      notices.length === 0
        ? (
          <div class="empty-state">
            <p class="empty-state__label">Estado actual</p>
            <h3>No hay avisos generales publicados en este momento.</h3>
          </div>
        )
        : (
          <div class="notice-list notice-list--archive">
            <!-- Los IDs ARIA derivan del identificador editorial, que validate.mjs exige único. -->
            {
              notices.map((notice) => <NoticeCard notice={notice} idPrefix="notice-title" />)
            }
          </div>
        )
    }
  </section>
</BaseLayout>
