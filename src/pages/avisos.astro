---
// Archivo público que comparte la misma fuente de avisos con la portada.
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHeader from "../components/PageHeader.astro";
import NoticeCard from "../components/NoticeCard.astro";
import { getGlobalNotices } from "../data/notices.js";
import { ROUTE_IDS } from "../i18n/routes.js";
import { t } from "../i18n/index.js";

const { locale = "es" } = Astro.props;
const notices = getGlobalNotices(undefined, locale);
---

<BaseLayout
  title={t(locale, "public.notices.generalTitle")}
  description={t(locale, "public.notices.generalMeta")}
  locale={locale}
  routeId={ROUTE_IDS.NOTICES}
>
  <PageHeader
    eyebrow={t(locale, "public.notices.generalEyebrow")}
    title={t(locale, "public.notices.siteTitle")}
    description={t(locale, "public.notices.siteDescription")}
  />

  <!-- Mantiene un estado vacío válido si la fuente editorial no tiene registros. -->
  <section class="page-section" aria-labelledby="notice-archive-title">
    <div class="section-heading">
      <h2 id="notice-archive-title">{t(locale, "public.notices.archive")}</h2>
      <p>{t(locale, "public.notices.order")}</p>
      <div class="section-divider" aria-hidden="true"></div>
    </div>

    {
      notices.length === 0
        ? (
          <div class="empty-state">
            <p class="empty-state__label">{t(locale, "public.common.currentStatus")}</p>
            <h3>{t(locale, "public.notices.noneGeneral")}</h3>
          </div>
        )
        : (
          <div class="notice-list notice-list--archive">
            <!-- Los IDs ARIA derivan del identificador editorial, que validate.mjs exige único. -->
            {
              notices.map((notice) => <NoticeCard notice={notice} idPrefix="notice-title" locale={locale} />)
            }
          </div>
        )
    }
  </section>
</BaseLayout>
