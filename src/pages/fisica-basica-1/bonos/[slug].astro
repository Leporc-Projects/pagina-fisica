---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import BonusAttempt from "../../../components/bonus/BonusAttempt.astro";
import { getBonusesByUnit } from "../../../data/bonuses/index.js";
import { UNIT_1_BANK_ITEMS } from "../../../data/physics/unit-1/bank.js";
import { localizeCourseData } from "../../../data/course-localize.js";
import { getLocalizedUnit1BankItems } from "../../../data/physics/unit-1/exercise-localize.js";
import { presentUnit1RichText } from "../../../data/physics/unit-1/math-content.js";
import { getLocalizedUnit1Visualization, getUnit1BonusRouteId, localizeUnit1, localizeUnit1Bonus } from "../../../data/physics/unit-1/localize.js";
import { UNIT_1_VISUALIZATIONS } from "../../../data/physics/unit-1/visualizations.js";
import { getLocalizedPath, ROUTE_IDS } from "../../../i18n/routes.js";
import { t } from "../../../i18n/index.js";
import { eligiblePoolForBonus } from "../../../utils/bonus.js";
import { withBase } from "../../../utils/paths.js";
import "../../../styles/bonus.css";

export function getStaticPaths() {
  return getBonusesByUnit(1).map((bonus) => ({
    params: { slug: bonus.slug },
    props: {
      bonus,
      exercises: eligiblePoolForBonus(bonus, UNIT_1_BANK_ITEMS),
    },
  }));
}

const { bonus: sourceBonus, locale = "es" } = Astro.props;
const bonus = localizeUnit1Bonus(sourceBonus, locale);
const COURSE = localizeCourseData(locale).COURSE;
const UNIT_1 = localizeUnit1(locale);
const exercises = eligiblePoolForBonus(bonus, getLocalizedUnit1BankItems(locale));
const visualizations = Object.fromEntries(Object.keys(UNIT_1_VISUALIZATIONS).map((id) => [id, getLocalizedUnit1Visualization(id, locale)]));
const routeId = getUnit1BonusRouteId(bonus.id);
const topicMap = new Map(UNIT_1.topics.map((topic) => [topic.slug, topic]));
---

<BaseLayout title={`${bonus.title} · ${COURSE.name}`} description={bonus.description} locale={locale} routeId={routeId}>
  <article class="bonus-page">
    <header class="bonus-page__hero">
      <nav class="academic-breadcrumb" aria-label={t(locale, "bonus.breadcrumb")}>
        <a href={withBase(getLocalizedPath(ROUTE_IDS.COURSE_BONUSES, locale))}>{t(locale, "course.nav.bonuses")}</a>
        <span aria-hidden="true">/</span>
        <span aria-current="page">{bonus.shortTitle}</span>
      </nav>

      <div class="bonus-page__heading">
        <p class="eyebrow eyebrow--dark">{t(locale, "bonus.label")} · {UNIT_1.shortTitle}</p>
        <h1>{bonus.title}</h1>
        <p>{bonus.description}</p>
      </div>

      <ul class="bonus-page__topics" aria-label={t(locale, "bonus.pageTopics")}>
        {bonus.topics.map((topic) => (
          <li>{topicMap.get(topic)?.shortTitle ?? topic}</li>
        ))}
      </ul>

      <aside class="bonus-page__policy">
        <strong>{t(locale, "bonus.policyTitle")}</strong>
        <p>{t(locale, "bonus.policy")}</p>
      </aside>
    </header>

    <BonusAttempt
      bonus={bonus}
      exercises={exercises}
      visualizations={visualizations}
      present={presentUnit1RichText}
      locale={locale}
    />
  </article>
</BaseLayout>
