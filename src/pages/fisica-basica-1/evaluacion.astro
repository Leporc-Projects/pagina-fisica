---
// Presentación pública de EVALUATION y del contrato de privacidad de las notas.
import BaseLayout from "../../layouts/BaseLayout.astro";
import CoursePageHeader from "../../components/course/CoursePageHeader.astro";
import { localizeCourseData } from "../../data/course-localize.js";
import { t } from "../../i18n/index.js";
import { getLocalizedPath, ROUTE_IDS } from "../../i18n/routes.js";
import { withBase } from "../../utils/paths.js";

const { locale = "es" } = Astro.props;
const { COURSE, EVALUATION } = localizeCourseData(locale);
const totalPercentage = EVALUATION.reduce(
  (total, item) => total + item.percentage,
  0
);
---

<BaseLayout
  title={t(locale, "public.assessment.pageTitle", { course: COURSE.name })}
  description={t(locale, "public.assessment.meta", { course: COURSE.name })}
  locale={locale}
  routeId={ROUTE_IDS.COURSE_ASSESSMENT}
>
  <article class="course-subpage">
    <CoursePageHeader
      title={t(locale, "public.assessment.title")}
      description={t(locale, "public.assessment.description")}
      locale={locale}
    />

    <!-- El total se calcula desde la fuente oficial y también lo comprueba validate.mjs. -->
    <section class="course-section" aria-labelledby="evaluation-plan-title">
      <header class="course-section__header">
        <div>
          <p class="course-section__index">{t(locale, "public.assessment.officialPlan")}</p>
          <h2 id="evaluation-plan-title">{t(locale, "public.assessment.components")}</h2>
        </div>

        <p>{t(locale, "public.assessment.total", { percentage: totalPercentage })}</p>
      </header>

      <div class="evaluation-list">
        {
          EVALUATION.map((item) => (
            <article class="evaluation-row">
              <div>
                <h3>{item.name}</h3>
                <p>{item.content}</p>
              </div>
              <strong>{item.percentage} %</strong>
            </article>
          ))
        }
      </div>
    </section>

    <section class="course-section course-section--split" aria-labelledby="evaluation-bonuses-title">
      <div>
        <p class="course-section__index">{t(locale, "public.assessment.complementary")}</p>
        <h2 id="evaluation-bonuses-title">{t(locale, "public.assessment.bonuses")}</h2>
      </div>
      <div class="course-section__body">
        <p class="course-lead">
          {t(locale, "public.assessment.bonusLead")}
        </p>
        <p>
          {t(locale, "public.assessment.bonusPolicy")}
        </p>
        <a class="text-link" href={withBase(getLocalizedPath(ROUTE_IDS.COURSE_BONUSES, locale))}>{t(locale, "public.assessment.openBonuses")}</a>
      </div>
    </section>

    <!-- Estas utilidades son locales y no sustituyen el sistema institucional. -->
    <section
      class="course-section course-section--split"
      aria-labelledby="grades-privacy-title"
    >
      <div>
        <p class="course-section__index">{t(locale, "public.assessment.privacy")}</p>
        <h2 id="grades-privacy-title">{t(locale, "public.assessment.notPublic")}</h2>
      </div>

      <div class="course-section__body">
        <p class="course-lead">
          {t(locale, "public.assessment.privacyLead")}
        </p>

        <div class="policy-panel">
          <h3>{t(locale, "public.assessment.teacherTools")}</h3>
          <p>{t(locale, "public.assessment.teacherToolsDescription")}</p>
          {locale === "en" && <p>{t(locale, "public.assessment.teacherToolsPending")}</p>}
          {locale === "es" && <div class="text-link-list">
            <a class="text-link" href={withBase("/fisica-basica-1/herramientas")}>
              {t(locale, "public.assessment.allTeacherTools")}
            </a>
            <a class="text-link" href={withBase("/fisica-basica-1/herramientas/notas")}>
              {t(locale, "public.assessment.resultsOrganizer")}
            </a>
          </div>}
        </div>
      </div>
    </section>
  </article>
</BaseLayout>
