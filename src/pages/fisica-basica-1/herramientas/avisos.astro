---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import NoticeEditor from "../../../components/notices/NoticeEditor.astro";
import TeacherToolsNav from "../../../components/teacher/TeacherToolsNav.astro";
import { COURSE } from "../../../data/course.js";
import { withBase } from "../../../utils/paths.js";
import "../../../styles/notice-editor.css";
---

<BaseLayout
  title={`Editor de avisos · ${COURSE.name}`}
  description="Herramienta docente local para preparar avisos y exportarlos como paquete editorial."
>
  <article class="notice-editor-page">
    <header class="notice-editor-page__hero">
      <nav class="academic-breadcrumb" aria-label="Migas de pan">
        <a href={withBase("/fisica-basica-1")}>Física Básica I</a>
        <span aria-hidden="true">/</span>
        <a href={withBase("/fisica-basica-1/herramientas")}>Herramientas docentes</a>
        <span aria-hidden="true">/</span>
        <span aria-current="page">Editor de avisos</span>
      </nav>
      <div>
        <p class="eyebrow eyebrow--dark">Herramienta docente local</p>
        <h1>Editor de avisos</h1>
        <p>Prepara avisos sin editar código y revísalos antes de incorporarlos al sitio.</p>
      </div>
      <aside>
        <strong>Flujo editorial explícito</strong>
        <p>La descarga produce borradores JSON. Importarlos los deja en revisión; nunca los publica automáticamente.</p>
      </aside>
    </header>

    <TeacherToolsNav current="avisos" />
    <NoticeEditor />
  </article>
</BaseLayout>
