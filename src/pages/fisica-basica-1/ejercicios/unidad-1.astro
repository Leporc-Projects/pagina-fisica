---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import ExerciseSequence from "../../../components/academic/ExerciseSequence.astro";
import UnitOneNav from "../../../components/academic/UnitOneNav.astro";
import { UNIT_1_EXERCISES } from "../../../data/physics/unit-1/exercises.js";
import { presentUnit1RichText } from "../../../data/physics/unit-1/math-content.js";
import { UNIT_1 } from "../../../data/physics/unit-1/unit.js";
import { withBase } from "../../../utils/paths.js";

const publishedExercises = UNIT_1_EXERCISES.filter(
  (exercise) => exercise.status === "published"
);
---

<BaseLayout
  title={`Práctica · ${UNIT_1.shortTitle}`}
  description={`Banco inicial de ejercicios originales de ${UNIT_1.title}.`}
>
  <article class="unit-practice-page">
    <header class="unit-topic-hero">
      <nav class="academic-breadcrumb" aria-label="Migas de pan">
        <a href={withBase("/fisica-basica-1/ejercicios")}>Ejercicios y tutorías</a>
        <span aria-hidden="true">/</span>
        <a href={withBase(UNIT_1.route)}>{UNIT_1.shortTitle}</a>
      </nav>

      <div class="unit-topic-hero__heading">
        <p class="eyebrow eyebrow--dark">Práctica · {UNIT_1.shortTitle}</p>
        <h1>Ejercicios de vectores y cinemática</h1>
        <p>
          Banco inicial pequeño y original para probar la arquitectura editorial.
          No es todavía un motor evaluativo ni conserva respuestas.
        </p>
      </div>

      <aside class="practice-policy">
        <strong>{publishedExercises.length} ejercicios publicados</strong>
        <p>
          Las pistas y soluciones se revelan con controles nativos. No se usa
          inteligencia artificial, backend, seguimiento ni almacenamiento local.
        </p>
      </aside>
    </header>

    <UnitOneNav />

    <ExerciseSequence
      exercises={publishedExercises}
      topics={UNIT_1.topics}
      present={presentUnit1RichText}
    />

    <aside class="editorial-metadata-note">
      <p class="academic-label">Metadatos editoriales</p>
      <h2>Preparado para tutorías deterministas posteriores</h2>
      <p>
        Cada registro conserva modalidad, representación, nivel cognitivo,
        dificultad, prerrequisitos, objetivos, tolerancia, unidad esperada,
        pistas, solución, errores asociados, estado y versión. Esos campos no
        implican que el motor interactivo ya esté implementado.
      </p>
    </aside>
  </article>
</BaseLayout>
