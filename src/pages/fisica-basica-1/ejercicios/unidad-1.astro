---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import OpenPractice from "../../../components/academic/OpenPractice.astro";
import UnitOneNav from "../../../components/academic/UnitOneNav.astro";
import { getLocalizedUnit1BankItems } from "../../../data/physics/unit-1/exercise-localize.js";
import { presentUnit1RichText } from "../../../data/physics/unit-1/math-content.js";
import { getLocalizedUnit1Visualization, localizeUnit1 } from "../../../data/physics/unit-1/localize.js";
import { UNIT_1_VISUALIZATIONS } from "../../../data/physics/unit-1/visualizations.js";
import { getLocalizedPath, ROUTE_IDS } from "../../../i18n/routes.js";
import { t } from "../../../i18n/index.js";
import { withBase } from "../../../utils/paths.js";

const { locale = "es" } = Astro.props;
const UNIT_1 = localizeUnit1(locale);
const localizedBankItems = getLocalizedUnit1BankItems(locale);
const localizedVisualizations = Object.fromEntries(
  Object.keys(UNIT_1_VISUALIZATIONS).map((id) => [id, getLocalizedUnit1Visualization(id, locale)])
);

const publicLearningExercises = localizedBankItems.filter(
  (exercise) =>
    exercise.status !== "draft" &&
    exercise.purpose === "learning" &&
    exercise.exposure === "public"
);
---

<BaseLayout
  title={t(locale, "practice.pageTitle", { unit: UNIT_1.shortTitle })}
  description={t(locale, "practice.pageDescription", { unitTitle: UNIT_1.title })}
  locale={locale}
  routeId={ROUTE_IDS.COURSE_UNIT_1_PRACTICE}
>
  <article class="unit-practice-page">
    <header class="unit-topic-hero">
      <nav class="academic-breadcrumb" aria-label={t(locale, "unitPage.breadcrumb")}>
        <a href={withBase(getLocalizedPath(ROUTE_IDS.COURSE_PRACTICE, locale))}>{t(locale, "practice.catalogBreadcrumb")}</a>
        <span aria-hidden="true">/</span>
        <a href={withBase(UNIT_1.route)}>{UNIT_1.shortTitle}</a>
      </nav>

      <div class="unit-topic-hero__heading">
        <p class="eyebrow eyebrow--dark">{t(locale, "practice.eyebrow", { unit: UNIT_1.shortTitle })}</p>
        <h1>{t(locale, "practice.unitTitle")}</h1>
        <p>{t(locale, "practice.unitDescription")}</p>
      </div>

      <aside class="practice-policy">
        <strong>{t(locale, "practice.policyTitle")}</strong>
        <p>{t(locale, "practice.policyText")}</p>
      </aside>
    </header>

    <UnitOneNav locale={locale} />

    <OpenPractice
      exercises={publicLearningExercises}
      topics={UNIT_1.topics}
      visualizations={localizedVisualizations}
      present={presentUnit1RichText}
      locale={locale}
    />

  </article>
</BaseLayout>
