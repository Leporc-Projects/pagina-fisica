---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import BonusAttempt from "../../../components/bonus/BonusAttempt.astro";
import { getMiniQuizzesByUnit } from "../../../data/mini-quizzes/index.js";
import { createMiniQuizPageData } from "../../../data/mini-quizzes/page-adapter.js";
import { getLocalizedPath, ROUTE_IDS } from "../../../i18n/routes.js";
import { t } from "../../../i18n/index.js";
import { withBase } from "../../../utils/paths.js";
import "../../../styles/bonus.css";

export function getStaticPaths() { return getMiniQuizzesByUnit(1).map((miniQuiz) => ({ params: { slug: miniQuiz.slug }, props: { miniQuiz } })); }
const { miniQuiz: sourceMiniQuiz, locale = "es" } = Astro.props;
const { miniQuiz, unit, runtime, exercises, visualizations, presentRichText, routeId } = createMiniQuizPageData({ unitNumber: 1, sourceMiniQuiz, locale });
const topicMap = new Map(unit.topics.map((topic) => [topic.slug, topic]));
---

<BaseLayout title={`${miniQuiz.title} · ${runtime.course.title}`} description={miniQuiz.description} locale={locale} routeId={routeId}>
  <article class="bonus-page"><header class="bonus-page__hero">
    <nav class="academic-breadcrumb" aria-label={t(locale, "bonus.breadcrumb")}><a href={withBase(getLocalizedPath(ROUTE_IDS.COURSE_MINI_QUIZZES, locale))}>{t(locale, "course.nav.bonuses")}</a><span aria-hidden="true">/</span><span aria-current="page">{miniQuiz.shortTitle}</span></nav>
    <div class="bonus-page__heading"><p class="eyebrow eyebrow--dark">{t(locale, "bonus.label")} · {unit.shortTitle}</p><h1>{miniQuiz.title}</h1><p>{miniQuiz.description}</p></div>
    <ul class="bonus-page__topics" aria-label={t(locale, "bonus.pageTopics")}>{miniQuiz.topics.map((topic) => <li>{topicMap.get(topic)?.shortTitle ?? topic}</li>)}</ul>
    <aside class="bonus-page__policy"><strong>{t(locale, "bonus.policyTitle")}</strong><p>{t(locale, "bonus.policy")}</p></aside>
  </header><BonusAttempt bonus={miniQuiz} exercises={exercises} visualizations={visualizations} present={presentRichText} runtime={runtime} locale={locale} /></article>
</BaseLayout>
