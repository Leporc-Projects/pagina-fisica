---
// Hoja de ruta editorial: combina UNITS con tipos previstos, sin crear ejercicios.
import BaseLayout from "../../layouts/BaseLayout.astro";
import CoursePageHeader from "../../components/course/CoursePageHeader.astro";
import { COURSE, UNITS } from "../../data/course.js";
import { UNIT_1_EXERCISES } from "../../data/physics/unit-1/exercises.js";
import { UNIT_1 } from "../../data/physics/unit-1/unit.js";
import { withBase } from "../../utils/paths.js";

const materialTypes = [
  "Diagnósticos",
  "Práctica guiada",
  "Ejercicios",
  "Retos",
  "Tutorías interactivas",
];
---

<BaseLayout
  title={`Ejercicios y tutorías · ${COURSE.name}`}
  description={`Catálogo de práctica y tutorías de ${COURSE.name}.`}
>
  <article class="course-subpage">
    <CoursePageHeader
      title="Ejercicios y tutorías"
      description="Catálogo y hoja de ruta de los materiales de práctica que se publicarán por unidad."
    />

    <!-- Separa el modelo pedagógico del catálogo para no confundir estados con contenido disponible. -->
    <section
      class="course-section course-section--split"
      aria-labelledby="exercise-model-title"
    >
      <div>
        <p class="course-section__index">Modelo de trabajo</p>
        <h2 id="exercise-model-title">
          Práctica diseñada por el docente
        </h2>
      </div>

      <div class="course-section__body">
        <p class="course-lead">
          Los materiales se incorporarán de forma progresiva después de su revisión académica.
          No se publicarán preguntas, pistas o soluciones provisionales.
        </p>

        <div class="policy-panel">
          <h3>Tutorías interactivas</h3>
          <p>
            Las tutorías serán progresivas y deterministas. Sus preguntas,
            rutas de ayuda y retroalimentaciones serán definidas por el docente,
            sin procesamiento mediante inteligencia artificial.
          </p>
        </div>
      </div>
    </section>

    <!-- Los anclajes reutilizan el número estable de cada unidad. -->
    <nav class="unit-index" aria-label="Unidades del catálogo de práctica">
      {
        UNITS.map((unit) => (
          <a href={`#ejercicios-unidad-${unit.number}`}>
            <span>{String(unit.number).padStart(2, "0")}</span>
            <strong>{unit.title}</strong>
          </a>
        ))
      }
    </nav>

    <section class="course-section" aria-labelledby="exercise-catalog-title">
      <header class="course-section__header">
        <div>
          <p class="course-section__index">Catálogo</p>
          <h2 id="exercise-catalog-title">Materiales por unidad</h2>
        </div>

        <p>
          La Unidad 1 ofrece un banco aprobado. Las demás categorías permanecen en preparación.
        </p>
      </header>

      <div class="publication-list">
        <!-- Cada referencia ARIA deriva del número único de la unidad. -->
        {
          UNITS.map((unit) => (
            <article
              class="publication-row"
              id={`ejercicios-unidad-${unit.number}`}
              aria-labelledby={`ejercicios-title-${unit.number}`}
            >
              <span class="publication-row__number">
                {String(unit.number).padStart(2, "0")}
              </span>

              <div>
                <h3 id={`ejercicios-title-${unit.number}`}>
                  {unit.title}
                </h3>
                <p class="publication-row__meta">{unit.chapters}</p>

                <ul class="publication-tags" aria-label="Tipos previstos">
                  {materialTypes.map((type) => <li>{type}</li>)}
                </ul>
              </div>

              {unit.number === UNIT_1.number
                ? <div class="publication-row__action">
                    <span class="status-label status-label--featured">
                      {UNIT_1_EXERCISES.length} ejercicios
                    </span>
                    <a class="text-link" href={withBase(UNIT_1.practiceRoute)}>
                      Abrir práctica
                    </a>
                  </div>
                : <span class="status-label status-label--preparing">
                    En preparación
                  </span>}
            </article>
          ))
        }
      </div>
    </section>
  </article>
</BaseLayout>
