---
// Hoja de ruta editorial: combina UNITS con tipos previstos, sin crear ejercicios.
import BaseLayout from "../../layouts/BaseLayout.astro";
import CoursePageHeader from "../../components/course/CoursePageHeader.astro";
import { localizeCourseData } from "../../data/course-localize.js";
import { getDevelopedAcademicUnits } from "../../data/physics/index.js";
import { ROUTE_IDS } from "../../i18n/routes.js";
import { t } from "../../i18n/index.js";
import { withBase } from "../../utils/paths.js";

const { locale = "es" } = Astro.props;
const { COURSE, UNITS } = localizeCourseData(locale);
const developedUnits = new Map(getDevelopedAcademicUnits(locale).map((unit) => [unit.number, unit]));
const materialTypes = [
  "practice.material.diagnostics",
  "practice.material.guided",
  "practice.material.exercises",
  "practice.material.challenges",
  "practice.material.tutorials",
];
---

<BaseLayout
  title={`${t(locale, "practice.catalogTitle")} · ${COURSE.name}`}
  description={t(locale, "practice.catalogDescription", { course: COURSE.name })}
  locale={locale}
  routeId={ROUTE_IDS.COURSE_PRACTICE}
>
  <article class="course-subpage">
    <CoursePageHeader
      title={t(locale, "practice.catalogTitle")}
      description={t(locale, "practice.catalogHeaderDescription")}
      locale={locale}
    />

    <!-- Separa el modelo pedagógico del catálogo para no confundir estados con contenido disponible. -->
    <section
      class="course-section course-section--split"
      aria-labelledby="exercise-model-title"
    >
      <div>
        <p class="course-section__index">{t(locale, "practice.workModel")}</p>
        <h2 id="exercise-model-title">
          {t(locale, "practice.teacherDesigned")}
        </h2>
      </div>

      <div class="course-section__body">
        <p class="course-lead">{t(locale, "practice.reviewPolicy")}</p>

        <div class="policy-panel">
          <h3>{t(locale, "practice.tutorials")}</h3>
          <p>{t(locale, "practice.tutorialPolicy")}</p>
        </div>
      </div>
    </section>

    <!-- Los anclajes reutilizan el número estable de cada unidad. -->
    <nav class="unit-index" aria-label={t(locale, "practice.catalogUnits")}>
      {
        UNITS.map((unit) => (
          <a href={`#ejercicios-unidad-${unit.number}`}>
            <span>{String(unit.number).padStart(2, "0")}</span>
            <strong>{unit.title}</strong>
          </a>
        ))
      }
    </nav>

    <section class="course-section" aria-labelledby="exercise-catalog-title">
      <header class="course-section__header">
        <div>
          <p class="course-section__index">{t(locale, "practice.catalog")}</p>
          <h2 id="exercise-catalog-title">{t(locale, "practice.materialsByUnit")}</h2>
        </div>

        <p>
          {t(locale, "practice.availableUnits")}
        </p>
      </header>

      <div class="publication-list">
        <!-- Cada referencia ARIA deriva del número único de la unidad. -->
        {
          UNITS.map((unit) => (
            <article
              class="publication-row"
              id={`ejercicios-unidad-${unit.number}`}
              aria-labelledby={`ejercicios-title-${unit.number}`}
            >
              <span class="publication-row__number">
                {String(unit.number).padStart(2, "0")}
              </span>

              <div>
                <h3 id={`ejercicios-title-${unit.number}`}>
                  {unit.title}
                </h3>
                <p class="publication-row__meta">{unit.chapters}</p>

                <ul class="publication-tags" aria-label={t(locale, "practice.plannedTypes")}>
                  {materialTypes.map((type) => <li>{t(locale, type)}</li>)}
                </ul>
              </div>

              {developedUnits.has(unit.number)
                ? <div class="publication-row__action practice-product-actions">
                    <div><strong>{t(locale, "practice.product.practice")}</strong><a class="text-link" href={withBase(developedUnits.get(unit.number).practiceRoute)}>{t(locale, "practice.openMaterial")}</a></div>
                    <div><strong>{t(locale, "practice.product.miniQuizzes")}</strong>{developedUnits.get(unit.number).miniQuizRoute ? <a class="text-link" href={withBase(developedUnits.get(unit.number).miniQuizRoute)}>{t(locale, "practice.openMaterial")}</a> : <span>{t(locale, "practice.comingSoon")}</span>}</div>
                    <div><strong>{t(locale, "practice.product.bonuses")}</strong><span>{t(locale, "practice.comingSoon")}</span></div>
                  </div>
                : <span class="status-label status-label--preparing">
                    {t(locale, "practice.preparing")}
                  </span>}
            </article>
          ))
        }
      </div>
    </section>
  </article>
</BaseLayout>
