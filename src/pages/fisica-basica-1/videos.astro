---
// Biblioteca basada en metadatos; los archivos audiovisuales viven fuera del repositorio.
import BaseLayout from "../../layouts/BaseLayout.astro";
import CoursePageHeader from "../../components/course/CoursePageHeader.astro";
import { localizeCourseData } from "../../data/course-localize.js";
import {
  getVideos,
  getVideosByUnit,
  getVideoContentTypes,
} from "../../data/videos.js";
import { t } from "../../i18n/index.js";
import { ROUTE_IDS } from "../../i18n/routes.js";

const { locale = "es" } = Astro.props;
const { COURSE, UNITS } = localizeCourseData(locale);

// Cada unidad se conserva visible aunque aún no tenga publicaciones asociadas.
const videosByUnit = UNITS.map((unit) => ({
  unit,
  videos: getVideosByUnit(unit.number),
}));
const videos = getVideos();
const videoContentTypes = getVideoContentTypes(locale);
---

<BaseLayout
  title={t(locale, "public.videos.pageTitle", { course: COURSE.name })}
  description={t(locale, "public.videos.meta", { course: COURSE.name })}
  locale={locale}
  routeId={ROUTE_IDS.COURSE_VIDEOS}
>
  <article class="course-subpage">
    <CoursePageHeader
      title={t(locale, "public.videos.title")}
      description={t(locale, "public.videos.description")}
      locale={locale}
    />

    <!-- Documenta el contrato del catálogo sin presentar publicaciones inexistentes. -->
    <section
      class="course-section course-section--split"
      aria-labelledby="video-structure-title"
    >
      <div>
        <p class="course-section__index">{t(locale, "public.videos.structure")}</p>
        <h2 id="video-structure-title">{t(locale, "public.videos.grow")}</h2>
      </div>

      <div class="course-section__body">
        <p class="course-lead">
          {t(locale, "public.videos.fields")}
        </p>

        <ul class="content-type-list">
          {
            videoContentTypes.map((type, index) => (
              <li>
                <span>{String(index + 1).padStart(2, "0")}</span>
                <p>{type}</p>
              </li>
            ))
          }
        </ul>
      </div>
    </section>

    <section class="course-section" aria-labelledby="video-library-title">
      <header class="course-section__header">
        <div>
          <p class="course-section__index">{t(locale, "public.videos.publications")}</p>
          <h2 id="video-library-title">{t(locale, "public.videos.byUnit")}</h2>
        </div>

        <p>
          {t(locale, "public.videos.reviewPolicy")}
        </p>
      </header>

      {
        // El estado vacío es parte deliberada del flujo editorial.
        videos.length === 0 && (
          <div class="empty-state">
            <p class="empty-state__label">{t(locale, "public.common.currentStatus")}</p>
            <h3>{t(locale, "public.resources.noVideos")}</h3>
            <p>{t(locale, "public.videos.emptyDescription")}</p>
          </div>
        )
      }

      <div class="publication-list publication-list--spaced">
        {
          videosByUnit.map(({ unit, videos }) => (
            <article class="publication-row">
              <span class="publication-row__number">
                {String(unit.number).padStart(2, "0")}
              </span>

              <div>
                <h3>{unit.title}</h3>
                <p class="publication-row__meta">
                  {videos.length === 0
                    ? t(locale, "public.videos.none")
                    : t(locale, videos.length === 1 ? "public.videos.count" : "public.videos.countPlural", { count: videos.length })}
                </p>
              </div>

              <span class="status-label status-label--preparing">
                {t(locale, "public.videos.preparing")}
              </span>
            </article>
          ))
        }
      </div>
    </section>
  </article>
</BaseLayout>
