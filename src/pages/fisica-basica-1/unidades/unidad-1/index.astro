---
import BaseLayout from "../../../../layouts/BaseLayout.astro";
import UnitLearningMap from "../../../../components/academic/UnitLearningMap.astro";
import { localizeUnit1 } from "../../../../data/physics/unit-1/localize.js";
import { UNIT_1_EXERCISES } from "../../../../data/physics/unit-1/exercises.js";
import { getLocalizedPath, ROUTE_IDS } from "../../../../i18n/routes.js";
import { t } from "../../../../i18n/index.js";
import { withBase } from "../../../../utils/paths.js";

const { locale = "es" } = Astro.props;
const UNIT_1 = localizeUnit1(locale);
---

<BaseLayout title={`${UNIT_1.shortTitle} · ${UNIT_1.title}`} description={UNIT_1.description} locale={locale} routeId={ROUTE_IDS.COURSE_UNIT_1}>
  <article class="unit-landing">
    <header class="unit-landing__hero">
      <nav class="academic-breadcrumb" aria-label={t(locale, "unitPage.breadcrumb")}>
        <a href={withBase(getLocalizedPath(ROUTE_IDS.COURSE_UNITS, locale))}>{t(locale, "unitPage.units")}</a>
        <span aria-hidden="true">/</span>
        <span aria-current="page">{UNIT_1.shortTitle}</span>
      </nav>

      <div>
        <p class="eyebrow eyebrow--dark">{UNIT_1.shortTitle} · {UNIT_1.chapters}</p>
        <h1>{UNIT_1.title}</h1>
        <p>{UNIT_1.description}</p>
      </div>

      <dl class="unit-landing__facts">
        <div>
          <dt>{t(locale, "unitPage.topics")}</dt>
          <dd>{UNIT_1.topics.length}</dd>
        </div>
        <div>
          <dt>{t(locale, "unitPage.exercises")}</dt>
          <dd>{UNIT_1_EXERCISES.length}</dd>
        </div>
        <div>
          <dt>{t(locale, "unitPage.status")}</dt>
          <dd>{t(locale, "unitPage.available")}</dd>
        </div>
      </dl>
    </header>

    <UnitLearningMap
      unitLabel={UNIT_1.shortTitle}
      unitTitle={UNIT_1.title}
      topics={UNIT_1.topics}
      locale={locale}
    />

    <section class="unit-study-guide" aria-labelledby="study-guide-title">
      <div>
        <p class="academic-label">{t(locale, "unitPage.progressiveDepth")}</p>
        <h2 id="study-guide-title">{t(locale, "unitPage.readEssential")}</h2>
        <p>{t(locale, "unitPage.studyGuide")}</p>
      </div>

      <ol>
        <li><strong>{t(locale, "academic.essential")}</strong><span>{t(locale, "unitPage.essentialSummary")}</span></li>
        <li><strong>{t(locale, "academic.understand")}</strong><span>{t(locale, "unitPage.understandSummary")}</span></li>
        <li><strong>{t(locale, "academic.deepen")}</strong><span>{t(locale, "unitPage.deepenSummary")}</span></li>
        <li><strong>{t(locale, "academic.explore")}</strong><span>{t(locale, "unitPage.exploreSummary")}</span></li>
      </ol>
    </section>

    <section class="unit-source-note" aria-labelledby="unit-source-title">
      <div>
        <p class="academic-label">{t(locale, "unitPage.academicScope")}</p>
        <h2 id="unit-source-title">{t(locale, "unitPage.sourcesModels")}</h2>
      </div>
      <div>
        <p>{t(locale, "unitPage.sourceText")}</p>
        <p>{t(locale, "unitPage.modelText")}</p>
      </div>
    </section>

    <aside class="unit-practice-cta">
      <div>
        <p class="academic-label">{t(locale, "unitPage.exerciseBank")}</p>
        <h2>{t(locale, "unitPage.practiceTitle", { count: UNIT_1_EXERCISES.length })}</h2>
        <p>{t(locale, "unitPage.practiceDescription")}</p>
      </div>
      <div class="unit-practice-cta__links">
        <a class="text-link" href={withBase(UNIT_1.practiceRoute)}>
          {t(locale, "unitPage.openPractice")}
        </a>
        <a class="text-link" href={withBase(UNIT_1.bonusRoute)}>
          {t(locale, "unitPage.openBonus")}
        </a>
      </div>
    </aside>

    <aside class="unit-practice-cta unit-feedback-link">
      <div>
        <p class="academic-label">{t(locale, "unitPage.participation")}</p>
        <h2>{t(locale, "unitPage.unclear")}</h2>
        <p>{t(locale, "unitPage.participationDescription")}</p>
      </div>
      <a class="text-link" href={withBase(getLocalizedPath(ROUTE_IDS.COURSE_PARTICIPATE, locale))}>
        {t(locale, "unitPage.openParticipation")}
      </a>
    </aside>
  </article>
</BaseLayout>
