---
import BaseLayout from "../../layouts/BaseLayout.astro";
import CoursePageHeader from "../../components/course/CoursePageHeader.astro";

import {
  COURSE,
  UNITS,
} from "../../data/course.js";
import { UNIT_1 } from "../../data/physics/unit-1/unit.js";
import { withBase } from "../../utils/paths.js";
---

<BaseLayout
  title={`Unidades y apuntes · ${COURSE.name}`}
  description={`Unidades temáticas y contenidos de ${COURSE.name}.`}
>
  <article class="course-subpage">
    <CoursePageHeader
      title="Unidades y apuntes"
      description="Organización temática del curso y espacio destinado a los materiales preparados para cada unidad."
    />

    <section
      class="units-introduction"
      aria-labelledby="units-introduction-title"
    >
      <div>
        <p class="course-section__index">Estructura</p>

        <h2 id="units-introduction-title">
          Siete unidades de mecánica newtoniana
        </h2>
      </div>

      <p>
        Los temas se presentan en el orden general del
        curso. Los apuntes, guías y materiales propios se
        incorporarán progresivamente dentro de cada
        unidad.
      </p>
    </section>

    <nav
      class="unit-index"
      aria-label="Índice de unidades"
    >
      {
        UNITS.map((unit) => (
          <a href={`#unidad-${unit.number}`}>
            <span>
              {String(unit.number).padStart(2, "0")}
            </span>

            <strong>{unit.title}</strong>
          </a>
        ))
      }
    </nav>

    <div class="unit-catalog">
      {
        UNITS.map((unit) => (
          <section
            class="unit-detail"
            id={`unidad-${unit.number}`}
            aria-labelledby={`unit-title-${unit.number}`}
          >
            <header class="unit-detail__header">
              <div class="unit-detail__number">
                <span>Unidad</span>

                <strong>
                  {String(unit.number).padStart(2, "0")}
                </strong>
              </div>

              <div>
                <p class="unit-detail__chapters">
                  {unit.chapters}
                </p>

                <h2 id={`unit-title-${unit.number}`}>
                  {unit.title}
                </h2>

                <p class="unit-detail__description">
                  {unit.description}
                </p>
              </div>
            </header>

            <div class="unit-detail__content">
              <div>
                <h3>Temas</h3>

                <ul class="unit-topic-list">
                  {
                    unit.topics.map((topic, index) => (
                      <li>
                        <span>
                          {String(index + 1).padStart(
                            2,
                            "0"
                          )}
                        </span>

                        <p>{topic}</p>
                      </li>
                    ))
                  }
                </ul>
              </div>

              <aside class="unit-materials">
                <p class="course-section__index">
                  Materiales
                </p>

                {unit.number === UNIT_1.number
                  ? <>
                      <h3>Contenido disponible</h3>
                      <p>
                        Contenido por temas, fórmulas con condiciones,
                        visualizaciones SVG y práctica.
                      </p>
                      <a class="text-link" href={withBase(UNIT_1.route)}>
                        Abrir {UNIT_1.shortTitle}
                      </a>
                    </>
                  : <>
                      <h3>Contenido en preparación</h3>
                      <p>
                        Este espacio reunirá apuntes, guías,
                        problemas seleccionados y recursos
                        propios de la unidad.
                      </p>
                      <span class="unit-materials__status">
                        Próximamente
                      </span>
                    </>}
              </aside>
            </div>
          </section>
        ))
      }
    </div>
  </article>
</BaseLayout>
