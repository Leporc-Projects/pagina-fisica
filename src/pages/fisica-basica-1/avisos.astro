---
import BaseLayout from "../../layouts/BaseLayout.astro";
import CoursePageHeader from "../../components/course/CoursePageHeader.astro";
import NoticeCard from "../../components/NoticeCard.astro";
import { localizeCourseData } from "../../data/course-localize.js";
import { getCourseNotices } from "../../data/notices.js";
import { t } from "../../i18n/index.js";
import { getLocalizedPath, ROUTE_IDS } from "../../i18n/routes.js";
import { withBase } from "../../utils/paths.js";

const { locale = "es" } = Astro.props;
const { COURSE } = localizeCourseData(locale);
const notices = getCourseNotices(COURSE.id, undefined, locale);
---

<BaseLayout
  title={t(locale, "public.notices.courseTitle", { course: COURSE.name })}
  description={t(locale, "public.notices.courseMeta", { course: COURSE.name })}
  locale={locale}
  routeId={ROUTE_IDS.COURSE_NOTICES}
>
  <article class="course-subpage">
    <CoursePageHeader
      title={t(locale, "public.notices.courseHeader")}
      description={t(locale, "public.notices.courseDescription", { course: COURSE.name })}
      locale={locale}
    />

    <section class="course-section" aria-labelledby="course-notices-title">
      <header class="course-section__header">
        <div>
          <p class="course-section__index">{t(locale, "public.notices.updates")}</p>
          <h2 id="course-notices-title">{t(locale, "public.notices.courseArchive", { course: COURSE.name })}</h2>
        </div>
        <div class="course-section__body">
          <p>{t(locale, "public.notices.order")}</p>
          <a class="notice-context-link" href={withBase(getLocalizedPath(ROUTE_IDS.NOTICES, locale))}>
            {t(locale, "public.notices.viewGeneral")}
          </a>
        </div>
      </header>

      {
        notices.length === 0
          ? (
            <div class="empty-state">
              <p class="empty-state__label">{t(locale, "public.common.currentStatus")}</p>
              <h3>{t(locale, "public.notices.noneCourse")}</h3>
              <p>{t(locale, "public.notices.generalAvailable")}</p>
            </div>
          )
          : (
            <div class="notice-list notice-list--archive">
              {notices.map((notice) => (
                <NoticeCard notice={notice} idPrefix="course-notice-title" locale={locale} />
              ))}
            </div>
          )
      }
    </section>
  </article>
</BaseLayout>
