---
// Presentación del SCHEDULE académico sin duplicar fechas ni sesiones en la página.
import BaseLayout from "../../layouts/BaseLayout.astro";
import CoursePageHeader from "../../components/course/CoursePageHeader.astro";

import { localizeCourseData } from "../../data/course-localize.js";
import { getLocaleConfig } from "../../i18n/config.js";
import { t } from "../../i18n/index.js";
import { ROUTE_IDS } from "../../i18n/routes.js";

const { locale = "es" } = Astro.props;
const { COURSE, SCHEDULE, SCHEDULE_TYPES } = localizeCourseData(locale);
const intlLocale = getLocaleConfig(locale).intlLocale;

type ScheduleEntry = (typeof SCHEDULE)[number];

const monthFormatter = new Intl.DateTimeFormat(
  intlLocale,
  {
    month: "long",
    year: "numeric",
  }
);

const dateFormatter = new Intl.DateTimeFormat(
  intlLocale,
  {
    weekday: "long",
    day: "2-digit",
    month: "short",
  }
);

const capitalize = (text: string) =>
  text.charAt(0).toUpperCase() + text.slice(1);

// El mediodía local evita que una conversión de zona horaria cambie el día visible.
const parseDate = (date: string) =>
  new Date(`${date}T12:00:00`);

const getTypeLabel = (type: string) =>
  // El fallback mantiene legible un tipo nuevo mientras se actualiza su etiqueta.
  SCHEDULE_TYPES[
    type as keyof typeof SCHEDULE_TYPES
  ]?.label ?? type;

const groupedSchedule: Array<{
  id: string;
  month: string;
  sessions: ScheduleEntry[];
}> = [];

// El ID nace de la fecha ISO, no del nombre traducido del mes, para ser estable y accesible.
// Se conserva el orden de SCHEDULE; no se aplica un segundo ordenamiento en la vista.
for (const session of SCHEDULE) {
  const id = `month-${session.date.slice(0, 7)}`;
  const month = capitalize(
    monthFormatter.format(parseDate(session.date))
  );

  const existingGroup = groupedSchedule.find(
    (group) => group.id === id
  );

  if (existingGroup) {
    existingGroup.sessions.push(session);
  } else {
    groupedSchedule.push({
      id,
      month,
      sessions: [session],
    });
  }
}

const classesCount = SCHEDULE.filter(
  (session) => session.type === "class"
).length;

const reviewsCount = SCHEDULE.filter(
  (session) => session.type === "review"
).length;

const examsCount = SCHEDULE.filter(
  (session) => session.type === "exam"
).length;

const eventsCount = SCHEDULE.filter(
  (session) => session.type === "event"
).length;
---

<BaseLayout
  title={t(locale, "public.schedule.pageTitle", { course: COURSE.name })}
  description={t(locale, "public.schedule.meta", { course: COURSE.name, semester: COURSE.semester })}
  locale={locale}
  routeId={ROUTE_IDS.COURSE_SCHEDULE}
>
  <article class="course-subpage">
    <CoursePageHeader
      title={t(locale, "public.schedule.title")}
      description={t(locale, "public.schedule.description", { semester: COURSE.semester })}
      locale={locale}
    />

    <!-- Las métricas se derivan de SCHEDULE para que nunca se desfasen del calendario. -->
    <section
      class="schedule-overview"
      aria-labelledby="schedule-overview-title"
    >
      <div class="schedule-overview__intro">
        <p class="course-section__index">{t(locale, "public.schedule.summary")}</p>

        <h2 id="schedule-overview-title">
          {t(locale, "public.schedule.organization")}
        </h2>

        <p>{t(locale, "public.schedule.organizationDescription", { count: SCHEDULE.length })}</p>
      </div>

      <dl class="schedule-stats">
        <div>
          <dt>{t(locale, "public.schedule.sessions")}</dt>
          <dd>{SCHEDULE.length}</dd>
        </div>

        <div>
          <dt>{t(locale, "public.schedule.classes")}</dt>
          <dd>{classesCount}</dd>
        </div>

        <div>
          <dt>{t(locale, "public.schedule.reviews")}</dt>
          <dd>{reviewsCount}</dd>
        </div>

        <div>
          <dt>{t(locale, "public.schedule.exams")}</dt>
          <dd>{examsCount}</dd>
        </div>

        <div>
          <dt>{t(locale, "public.schedule.events")}</dt>
          <dd>{eventsCount}</dd>
        </div>
      </dl>
    </section>

    <section
      class="schedule-legend"
      aria-label={t(locale, "public.schedule.types")}
    >
      {
        Object.entries(SCHEDULE_TYPES).map(
          ([type, information]) => (
            <span
              class={`schedule-type schedule-type--${type}`}
            >
              {information.label}
            </span>
          )
        )
      }
    </section>

    <div class="schedule-calendar">
      {
        groupedSchedule.map((group) => (
          <section
            class="schedule-month"
            aria-labelledby={group.id}
          >
            <header class="schedule-month__header">
              <h2 id={group.id}>
                {group.month}
              </h2>

              <span>
                {group.sessions.length}
                {
                  group.sessions.length === 1
                    ? ` ${t(locale, "public.schedule.session")}`
                    : ` ${t(locale, "public.schedule.sessionsLower")}`
                }
              </span>
            </header>

            <div class="schedule-list">
              {
                group.sessions.map((session) => (
                  <article
                    class={`schedule-entry schedule-entry--${session.type}`}
                  >
                    <div class="schedule-entry__date">
                      <span>
                        {t(locale, "public.schedule.sessionNumber", { number: String(session.session).padStart(2, "0") })}
                      </span>

                      <time datetime={session.date}>
                        {capitalize(
                          dateFormatter.format(
                            parseDate(session.date)
                          )
                        )}
                      </time>
                    </div>

                    <div class="schedule-entry__content">
                      <div class="schedule-entry__heading">
                        <span
                          class={`schedule-type schedule-type--${session.type}`}
                        >
                          {getTypeLabel(session.type)}
                        </span>

                        {
                          session.chapter && (
                            <span class="schedule-entry__chapter">
                              {session.chapterLabel ?? session.chapter}
                            </span>
                          )
                        }
                      </div>

                      <h3>{session.title}</h3>

                      {
                        session.topics.length > 0 && (
                          <ul class="schedule-topic-list">
                            {
                              session.topics.map(
                                (topic) => (
                                  <li>{topic}</li>
                                )
                              )
                            }
                          </ul>
                        )
                      }

                      {
                        session.objectives.length > 0 && (
                          <details class="schedule-objectives">
                            <summary>
                              {t(locale, "public.schedule.objectives")}
                            </summary>

                            <ul>
                              {
                                session.objectives.map(
                                  (objective) => (
                                    <li>{objective}</li>
                                  )
                                )
                              }
                            </ul>
                          </details>
                        )
                      }
                    </div>
                  </article>
                ))
              }
            </div>
          </section>
        ))
      }
    </div>
  </article>
</BaseLayout>
