---
// Biblioteca de recursos de aprendizaje.
import BaseLayout from "../../layouts/BaseLayout.astro";
import CoursePageHeader from "../../components/course/CoursePageHeader.astro";
import SectionHeading from "../../components/SectionHeading.astro";
import { localizeCourseData } from "../../data/course-localize.js";
import { t } from "../../i18n/index.js";
import { getLocalizedPath, ROUTE_IDS } from "../../i18n/routes.js";
import { withBase } from "../../utils/paths.js";

const { locale = "es" } = Astro.props;
const { BIBLIOGRAPHY, COURSE } = localizeCourseData(locale);
---

<BaseLayout
  title={t(locale, "public.resources.pageTitle", { course: COURSE.name })}
  description={t(locale, "public.resources.meta", { course: COURSE.name })}
  locale={locale}
  routeId={ROUTE_IDS.COURSE_RESOURCES}
>
  <article class="course-subpage">
    <CoursePageHeader
      title={t(locale, "public.resources.title")}
      description={t(locale, "public.resources.description")}
      locale={locale}
    />

    <section class="page-section" aria-labelledby="guides-title">
      <SectionHeading
        id="guides-title"
        title={t(locale, "public.resources.guides")}
        desc={t(locale, "public.resources.guidesDescription")}
      />

      <div class="empty-state">
        <p class="empty-state__label">{t(locale, "public.common.currentStatus")}</p>
        <h3>{t(locale, "public.common.inPreparation")}</h3>
        <p>{t(locale, "public.resources.guidesPolicy")}</p>
      </div>
    </section>

    <section class="page-section" aria-labelledby="bibliography-title">
      <SectionHeading
        id="bibliography-title"
        title={t(locale, "public.resources.bibliography")}
        desc={t(locale, "public.resources.bibliographyDescription")}
      />

      <div class="bibliography-list">
        {
          BIBLIOGRAPHY.map((book) => (
            <article class="bibliography-row">
              <span class="bibliography-row__mark">{book.shortName}</span>

              <div>
                <h3>{book.title}</h3>
                <p>{book.authors}</p>
                {book.edition && <small>{book.edition}</small>}
              </div>

              <span class="bibliography-row__role">{book.role}</span>
            </article>
          ))
        }
      </div>
    </section>

    <section class="page-section" aria-labelledby="audiovisual-title">
      <SectionHeading
        id="audiovisual-title"
        title={t(locale, "public.resources.audiovisual")}
        desc={t(locale, "public.resources.audiovisualDescription")}
      />

      <div class="transition-panel transition-panel--compact">
        <h3>{t(locale, "public.resources.noVideos")}</h3>
        <p>{t(locale, "public.resources.noVideosDescription")}</p>
        <a class="text-link" href={withBase(getLocalizedPath(ROUTE_IDS.COURSE_VIDEOS, locale))}>
          {t(locale, "public.resources.openLibrary")}
          <span aria-hidden="true">→</span>
        </a>
      </div>
    </section>

    <section class="page-section" aria-labelledby="external-resources-title">
      <SectionHeading
        id="external-resources-title"
        title={t(locale, "public.resources.external")}
        desc={t(locale, "public.resources.externalDescription")}
      />

      <div class="resource-link-list">
        <article class="resource-link-row">
          <div>
            <h3>PhET Interactive Simulations</h3>
            <p>{t(locale, "public.resources.phetDescription")}</p>
          </div>
          <a
            class="text-link"
            href="https://phet.colorado.edu/es/"
            target="_blank"
            rel="noopener noreferrer"
          >
            {t(locale, "public.resources.visit")}
          </a>
        </article>

        <article class="resource-link-row">
          <div>
            <h3>HyperPhysics</h3>
            <p>{t(locale, "public.resources.hyperphysicsDescription")}</p>
          </div>
          <a
            class="text-link"
            href="http://hyperphysics.phy-astr.gsu.edu/hbase/hframe.html"
            target="_blank"
            rel="noopener noreferrer"
          >
            {t(locale, "public.resources.visit")}
          </a>
        </article>
      </div>
    </section>

    {locale === "es" && <section class="page-section" aria-labelledby="teacher-tools-title">
      <SectionHeading
        id="teacher-tools-title"
        title={t(locale, "public.assessment.teacherTools")}
        desc={t(locale, "public.resources.teacherToolsDescription")}
      />

      <div class="resource-link-list">
        <article class="resource-link-row">
          <div>
            <h3>{t(locale, "public.resources.toolsSpace")}</h3>
            <p>{t(locale, "public.resources.toolsSpaceDescription")}</p>
          </div>
          <a
            class="text-link"
            href={withBase("/fisica-basica-1/herramientas")}
          >
            {t(locale, "public.resources.viewTools")}
          </a>
        </article>
      </div>
    </section>}
  </article>
</BaseLayout>
