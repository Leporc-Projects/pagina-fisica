---
// Participa de Física Básica I: ámbito de curso fijo en el prerender. Un
// query ?unit=<slug>&topic=<slug> válido sigue precontextualizando unidad y
// tema, resuelto en el navegador por ParticipationContext.astro (ver
// src/pages/participa.astro sobre por qué no se resuelve aquí).
import ParticipationPage from "../../components/participation/ParticipationPage.astro";
import { COURSE_IDS } from "../../data/courses.js";

const { locale = "es" } = Astro.props;
---

<ParticipationPage locale={locale} scope="course" initialCourseId={COURSE_IDS.PHYSICS_BASIC_1} />
