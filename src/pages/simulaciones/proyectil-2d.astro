---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageHeader from "../../components/PageHeader.astro";
import SimulationExperienceRenderer from "../../components/simulations/SimulationExperienceRenderer.astro";
import { getSimulationExperienceById } from "../../data/simulation-experiences.js";

const experience = getSimulationExperienceById("projectile-2d");
---

<BaseLayout title={experience.title} description={experience.summary}>
  <PageHeader
    eyebrow="Simulación · Cinemática"
    title={experience.title}
    description={experience.summary}
  />

  <section class="projectile-page-intro page-section" aria-labelledby="projectile-model-title">
    <div>
      <p class="academic-label">Modelo físico</p>
      <h2 id="projectile-model-title">Dos componentes, una trayectoria</h2>
      <p>
        La partícula parte de <strong>x₀ = 0</strong> y altura <strong>y₀</strong>.
        Sin resistencia del aire, el movimiento horizontal es uniforme y el
        vertical tiene aceleración constante <strong>ay = −g</strong>. El vuelo
        termina en el primer contacto con el suelo, <strong>y = 0</strong>.
      </p>
    </div>
    <div class="projectile-equations" aria-label="Ecuaciones del movimiento del proyectil">
      <math display="block" aria-label="x de t igual a v sub x cero por t">
        <mrow><mi>x</mi><mo>(</mo><mi>t</mi><mo>)</mo><mo>=</mo><msub><mi>v</mi><mrow><mi>x</mi><mn>0</mn></mrow></msub><mi>t</mi></mrow>
      </math>
      <math display="block" aria-label="y de t igual a y cero más v sub y cero por t menos un medio de g por t al cuadrado">
        <mrow><mi>y</mi><mo>(</mo><mi>t</mi><mo>)</mo><mo>=</mo><msub><mi>y</mi><mn>0</mn></msub><mo>+</mo><msub><mi>v</mi><mrow><mi>y</mi><mn>0</mn></mrow></msub><mi>t</mi><mo>−</mo><mfrac><mn>1</mn><mn>2</mn></mfrac><mi>g</mi><msup><mi>t</mi><mn>2</mn></msup></mrow>
      </math>
      <math display="block" aria-label="v sub x de t igual a v sub x cero">
        <mrow><msub><mi>v</mi><mi>x</mi></msub><mo>(</mo><mi>t</mi><mo>)</mo><mo>=</mo><msub><mi>v</mi><mrow><mi>x</mi><mn>0</mn></mrow></msub></mrow>
      </math>
      <math display="block" aria-label="v sub y de t igual a v sub y cero menos g por t">
        <mrow><msub><mi>v</mi><mi>y</mi></msub><mo>(</mo><mi>t</mi><mo>)</mo><mo>=</mo><msub><mi>v</mi><mrow><mi>y</mi><mn>0</mn></mrow></msub><mo>−</mo><mi>g</mi><mi>t</mi></mrow>
      </math>
      <p><span>vx₀</span> = v₀ cos θ · <span>vy₀</span> = v₀ sin θ</p>
    </div>
  </section>

  <SimulationExperienceRenderer experience={experience} />

  {experience.observations.length > 0 && (
    <section class="projectile-observe page-section" aria-labelledby="projectile-observe-title">
      <div>
        <p class="academic-label">Guía de exploración</p>
        <h2 id="projectile-observe-title">Qué observar</h2>
      </div>
      <ol>
        {experience.observations.map((observation, index) => (
          <li><span>{String(index + 1).padStart(2, "0")}</span><p>{observation}</p></li>
        ))}
      </ol>
    </section>
  )}

  <section class="projectile-limits page-section" aria-labelledby="projectile-limits-title">
    <p class="academic-label">Alcance</p>
    <h2 id="projectile-limits-title">Límites del modelo</h2>
    <p>
      El proyectil es una partícula puntual sometida a gravedad uniforme. No hay
      aire, viento, rotación, rebotes ni curvatura terrestre. El resultado clásico
      de alcance máximo a 45° solo corresponde al mismo nivel de salida y llegada,
      con gravedad uniforme y sin resistencia del aire. Las longitudes de los
      vectores usan una escala visual distinta de la escala espacial del plano.
    </p>
  </section>
</BaseLayout>
