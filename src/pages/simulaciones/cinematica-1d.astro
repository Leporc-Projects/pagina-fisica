---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageHeader from "../../components/PageHeader.astro";
import SimulationExperienceRenderer from "../../components/simulations/SimulationExperienceRenderer.astro";
import { getSimulationExperienceById } from "../../data/simulation-experiences.js";

const experience = getSimulationExperienceById("kinematics-1d");
---

<BaseLayout
  title={experience.title}
  description={experience.summary}
>
  <PageHeader
    eyebrow="Simulación · Cinemática"
    title={experience.title}
    description={experience.summary}
  />

  <section class="kinematics-page-intro page-section" aria-labelledby="kinematics-model-title">
    <div>
      <p class="academic-label">Modelo físico</p>
      <h2 id="kinematics-model-title">Una partícula, un eje, aceleración constante</h2>
      <p>
        La simulación representa una partícula sobre el eje x durante el intervalo
        <strong>0 ≤ t ≤ T</strong>. La posición negativa describe un lado del origen;
        el signo de la velocidad describe el sentido del movimiento.
      </p>
    </div>
    <div class="kinematics-equations" aria-label="Ecuaciones del modelo">
      <p><span>x(t)</span> = x₀ + v₀t + ½at²</p>
      <p><span>v(t)</span> = v₀ + at</p>
      <p><span>a(t)</span> = a</p>
    </div>
  </section>

  <SimulationExperienceRenderer experience={experience} />

  {experience.observations.length > 0 && (
    <section class="kinematics-observe page-section" aria-labelledby="kinematics-observe-title">
      <div>
        <p class="academic-label">Guía de exploración</p>
        <h2 id="kinematics-observe-title">Qué observar</h2>
      </div>
      <ol>
        {experience.observations.map((observation, index) => (
          <li>
            <span>{String(index + 1).padStart(2, "0")}</span>
            <p>{observation}</p>
          </li>
        ))}
      </ol>
    </section>
  )}

  <section class="kinematics-limits page-section" aria-labelledby="kinematics-limits-title">
    <p class="academic-label">Alcance</p>
    <h2 id="kinematics-limits-title">Límites del modelo</h2>
    <p>
      La aceleración se mantiene constante y el objeto se trata como partícula.
      El modelo no incluye resistencia del medio, colisiones, fuerzas, tamaño,
      rotación ni cambios discontinuos de aceleración. La animación ilustra las
      ecuaciones: no reproduce una escala temporal o material experimental.
    </p>
  </section>
</BaseLayout>
