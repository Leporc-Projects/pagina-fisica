---
// Directorio de simulaciones por categoría.
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHeader from "../components/PageHeader.astro";
import SectionHeading from "../components/SectionHeading.astro";
import {
  SIMULATION_CATEGORIES,
  getSimulationsByCategory,
  getPublishedSimulations,
} from "../data/simulations.js";
import { withBase } from "../utils/paths.js";

const publishedSimulations = getPublishedSimulations();
---

<BaseLayout
  title="Simulaciones"
  description="Catálogo de simulaciones interactivas de física organizadas por tema."
>
  <PageHeader
    eyebrow="Exploración"
    title="Simulaciones"
    description="Directorio preparado para experiencias interactivas propias y revisadas académicamente."
  />

  <div class="policy-panel page-section" role="note">
    <h2>Dos modelos de cinemática disponibles</h2>
    <p>
      El catálogo reúne movimiento en una dimensión y proyectiles en dos
      dimensiones. Las demás categorías permanecen identificadas como futuras,
      sin presentar recursos ficticios.
    </p>
  </div>

  <section class="page-section" aria-labelledby="published-simulations-title">
    <SectionHeading
      id="published-simulations-title"
      title="Disponibles"
      desc="Recursos interactivos publicados y revisados para el estudio."
    />

    <ul class="publication-list" role="list">
      {publishedSimulations.map((simulation, index) => (
        <li class="publication-row">
          <span class="publication-row__number">
            {String(index + 1).padStart(2, "0")}
          </span>
          <div>
            <h3><a href={withBase(simulation.route)}>{simulation.title}</a></h3>
            <p class="publication-row__meta">{simulation.category}</p>
            <p>{simulation.description}</p>
          </div>
          <div class="publication-row__action">
            <span class="status-label status-label--available">Disponible</span>
            <a class="text-link" href={withBase(simulation.route)}>Abrir simulación</a>
          </div>
        </li>
      ))}
    </ul>
  </section>

  <section class="page-section" aria-labelledby="simulation-categories-title">
    <SectionHeading
      id="simulation-categories-title"
      title="Categorías"
      desc="Estado real de la organización temática del catálogo."
    />

    <ul class="publication-list" role="list">
      {
        SIMULATION_CATEGORIES.map((category, index) => {
          const simulations = getSimulationsByCategory(category);
          const available = simulations.length > 0;
          return (
          <li class="publication-row">
            <span class="publication-row__number">
              {String(index + 1).padStart(2, "0")}
            </span>
            <div>
              <h3>{category}</h3>
              {available && <p class="publication-row__meta">{simulations.length} {simulations.length === 1 ? "recurso publicado" : "recursos publicados"}</p>}
            </div>
            <span class:list={{
              "status-label": true,
              "status-label--available": available,
              "status-label--preparing": !available,
            }}>{available ? "Disponible" : "En preparación"}</span>
          </li>
          );
        })
      }
    </ul>
  </section>

  <section class="page-section" aria-labelledby="simulation-principles-title">
    <SectionHeading
      id="simulation-principles-title"
      title="Criterios de publicación"
      desc="Cada simulación deberá ser comprensible, accesible y útil para el análisis físico."
    />

    <ol class="content-type-list">
      <li><span>01</span><p>Controles claros y utilizables con teclado.</p></li>
      <li><span>02</span><p>Variables, unidades y estados identificados explícitamente.</p></li>
      <li><span>03</span><p>Comportamiento responsive y sin desbordamiento horizontal.</p></li>
      <li><span>04</span><p>Explicación del modelo y de sus límites físicos.</p></li>
    </ol>
  </section>
</BaseLayout>
