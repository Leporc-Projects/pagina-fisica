---
// Documento HTML compartido: metadatos, navegación, contenido principal y footer.
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import "../styles/global.css";
import { SITE } from "../data/site.js";
import { withBase } from "../utils/paths.js";
import {
  THEME_COLORS,
  THEME_PREFERENCES,
  THEME_STORAGE_KEY,
} from "../data/theme.js";

interface Props {
  title: string;
  description?: string;
  fullWidth?: boolean;
}

const {
  title,
  description = SITE.description,
  fullWidth = false,
} = Astro.props;

const fullTitle =
  title === "Inicio" ? SITE.name : `${title} · ${SITE.name}`;

const themeValues = THEME_PREFERENCES.map((option) => option.value);
const lightThemeColor = THEME_COLORS.light;
const darkThemeColor = THEME_COLORS.dark;
const themeStorageKey = THEME_STORAGE_KEY;
---

<!doctype html>
<html lang={SITE.lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />

    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content={lightThemeColor} />

    <!-- Se ejecuta antes de cargar estilos para evitar mostrar el tema equivocado. -->
    <script
      is:inline
      define:vars={{
        themeValues,
        themeStorageKey,
        lightThemeColor,
        darkThemeColor,
      }}
    >
      (() => {
        let preference = "system";

        try {
          const storedPreference = localStorage.getItem(themeStorageKey);
          if (themeValues.includes(storedPreference)) {
            preference = storedPreference;
          }
        } catch {
          // El modo sistema es el fallback cuando localStorage no está disponible.
        }

        const systemIsDark = window.matchMedia(
          "(prefers-color-scheme: dark)"
        ).matches;
        const effectiveTheme = preference === "system"
          ? systemIsDark ? "dark" : "light"
          : preference;

        document.documentElement.dataset.theme = effectiveTheme;
        document.documentElement.dataset.themePreference = preference;
        document.documentElement.style.colorScheme = effectiveTheme;

        const themeColor = document.querySelector('meta[name="theme-color"]');
        if (themeColor) {
          themeColor.content = effectiveTheme === "dark"
            ? darkThemeColor
            : lightThemeColor;
        }
      })();
    </script>

    <!-- Usamos el logo como favicon provisional. -->
    <link rel="icon" type="image/jpeg" href={withBase(SITE.logoPath)} />
  </head>

  <body>
    <a class="skip-link" href="#main-content">
      Saltar al contenido
    </a>

    <Header />

    <main id="main-content" tabindex="-1">
      {
        // La portada controla su ancho por secciones; el resto hereda el contenedor editorial.
        fullWidth
          ? <slot />
          : <div class="container page-main"><slot /></div>
      }
    </main>

    <Footer />
  </body>
</html>
