---
// Estructura común de todas las páginas.
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import "../styles/global.css";
import { SITE } from "../data/site.js";

interface Props {
  title: string;
  description?: string;
  fullWidth?: boolean;
}

const {
  title,
  description = SITE.description,
  fullWidth = false,
} = Astro.props;

const fullTitle =
  title === "Inicio" ? SITE.name : `${title} · ${SITE.name}`;
---

<!doctype html>
<html lang={SITE.lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />

    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0b0f12" />

    <!-- Usamos el logo como favicon provisional. -->
    <link rel="icon" type="image/jpeg" href={SITE.logoPath} />
  </head>

  <body>
    <a class="skip-link" href="#main-content">
      Saltar al contenido
    </a>

    <Header />

    <main id="main-content" tabindex="-1">
      {
        fullWidth
          ? <slot />
          : <div class="container page-main"><slot /></div>
      }
    </main>

    <Footer />
  </body>
</html>