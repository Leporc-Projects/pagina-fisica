---
// Documento HTML compartido: metadatos, navegación, contenido principal y footer.
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import "../styles/global.css";
import { SITE } from "../data/site.js";
import { getLocaleConfig, getLocaleFromPath } from "../i18n/config.js";
import { t } from "../i18n/index.js";
import { getLanguageMetadata } from "../i18n/metadata.js";
import { withBase } from "../utils/paths.js";
import {
  THEME_COLORS,
  THEME_PREFERENCES,
  THEME_STORAGE_KEY,
} from "../data/theme.js";

interface Props {
  title: string;
  description?: string;
  fullWidth?: boolean;
  locale?: "es" | "en";
  routeId?: string;
}

const {
  title,
  description,
  fullWidth = false,
  locale = getLocaleFromPath(Astro.url.pathname),
  routeId,
} = Astro.props;

const fullTitle =
  title === t(locale, "meta.homeTitle") ? SITE.name : `${title} · ${SITE.name}`;
const pageDescription = description ?? t(locale, "meta.defaultDescription");
const localeConfig = getLocaleConfig(locale);
const languageMetadata = routeId ? getLanguageMetadata(locale, routeId) : null;
const canonicalPath = languageMetadata?.canonicalPath ?? Astro.url.pathname;
const canonicalUrl = new URL(withBase(canonicalPath ?? Astro.url.pathname), Astro.site);
const alternates = languageMetadata?.alternates ?? [];
const xDefaultPath = languageMetadata?.xDefaultPath ?? null;

const themeValues = THEME_PREFERENCES.map((option) => option.value);
const lightThemeColor = THEME_COLORS.light;
const darkThemeColor = THEME_COLORS.dark;
const themeStorageKey = THEME_STORAGE_KEY;
---

<!doctype html>
<html lang={localeConfig.htmlLang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />

    <title>{fullTitle}</title>
    <meta name="description" content={pageDescription} />
    <link rel="canonical" href={canonicalUrl} />
    {alternates.map((entry) => (
      <link rel="alternate" hreflang={entry.hreflang} href={new URL(withBase(entry.path), Astro.site)} />
    ))}
    {xDefaultPath && <link rel="alternate" hreflang="x-default" href={new URL(withBase(xDefaultPath), Astro.site)} />}
    <meta name="theme-color" content={lightThemeColor} />

    <!-- Se ejecuta antes de cargar estilos para evitar mostrar el tema equivocado. -->
    <script
      is:inline
      define:vars={{
        themeValues,
        themeStorageKey,
        lightThemeColor,
        darkThemeColor,
      }}
    >
      (() => {
        let preference = "system";

        try {
          const storedPreference = localStorage.getItem(themeStorageKey);
          if (themeValues.includes(storedPreference)) {
            preference = storedPreference;
          }
        } catch {
          // El modo sistema es el fallback cuando localStorage no está disponible.
        }

        const systemIsDark = window.matchMedia(
          "(prefers-color-scheme: dark)"
        ).matches;
        const effectiveTheme = preference === "system"
          ? systemIsDark ? "dark" : "light"
          : preference;

        document.documentElement.dataset.theme = effectiveTheme;
        document.documentElement.dataset.themePreference = preference;
        document.documentElement.style.colorScheme = effectiveTheme;

        const themeColor = document.querySelector('meta[name="theme-color"]');
        if (themeColor) {
          themeColor.content = effectiveTheme === "dark"
            ? darkThemeColor
            : lightThemeColor;
        }
      })();
    </script>

    <!-- Usamos el logo como favicon provisional. -->
    <link rel="icon" type="image/jpeg" href={withBase(SITE.logoPath)} />
  </head>

  <body>
    <a class="skip-link" href="#main-content">
      {t(locale, "shell.skip")}
    </a>

    <Header locale={locale} />

    <main id="main-content" tabindex="-1">
      {
        // La portada controla su ancho por secciones; el resto hereda el contenedor editorial.
        fullWidth
          ? <slot />
          : <div class="container page-main"><slot /></div>
      }
    </main>

    <Footer locale={locale} />
  </body>
</html>
